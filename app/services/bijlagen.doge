so journaal
so nap
so fetch
so hunt
so strings

# Bijlagen (inkoopbewijs): upload-validatie, opslag onder een gegenereerde naam,
# en de import-inbox (bijlage zonder journaalpost). store komt als parameter binnen;
# deze service importeert de store nooit. Bijlagen worden nooit verwijderd (Hard Rule 3).
# De grenzen hieronder zijn domein-constanten (geen secret) → hier, niet in .env.

so TOEGESTANE_EXT = ["pdf", "png", "jpg", "jpeg"]
so MAX_BYTES = 10485760
# mime wordt afgeleid van de gevalideerde extensie, nooit van de client-header.
so MIME = {"pdf": "application/pdf", "png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg"}

# Genormaliseerde extensie zonder punt, lowercase. fetch.ext geeft ".PDF" → "pdf".
such ext_van much filename:
    such e = strings.smoll(fetch.ext(filename))
    if len(e) > 0 and e[0] == ".":
        return e[1:]
    return e
wow

# Klopt een opgeslagen pad met de eigen layout "uploads/{jaar}/{id}.{ext}"? Voor paden die
# van buiten komen (import van een export): nooit een willekeurig pad schrijven (Hard Rule 7).
such geldig_pad much id, pad:
    if not hunt.test("^b-[0-9]+$", str(id)):
        return false
    such m = hunt.groups("^uploads/[0-9][0-9][0-9][0-9]/(b-[0-9]+)\\.([a-z]+)$", str(pad))
    return m != none and m[1] == id and TOEGESTANE_EXT.contains(m[2])
wow

such zoek much lijst, id:
    for b in lijst:
        if b["id"] == id:
            return b
    return none
wow

such alle much store:
    return store.laad("bijlagen", [])
wow

# De import-inbox: bijlagen die nog aan geen journaalpost hangen.
such inbox much store:
    such uit = []
    for b in store.laad("bijlagen", []):
        if b["journaalpost_id"] == none:
            uit.append(b)
    return uit
wow

such valideer much part:
    such naam = part["filename"]
    if naam == none or strings.trim(naam) == "":
        bonk "kies een bestand"
    such ext = ext_van(naam)
    if not TOEGESTANE_EXT.contains(ext):
        bonk "bestandstype niet toegestaan: {ext}"
    such grootte = len(part["data"])
    if grootte == 0:
        bonk "leeg bestand"
    if grootte > MAX_BYTES:
        bonk "bestand te groot: {grootte} bytes (max {MAX_BYTES})"
    if not inhoud_past(ext, part["data"]):
        bonk "inhoud is geen geldig {ext}-bestand"
    return ext
wow

# Magic bytes per extensie; een pdf mag volgens de spec tot 1024 bytes rommel voor %PDF hebben.
such inhoud_past much ext, data:
    if ext == "pdf":
        such pos = data.find(bytes("%PDF-"))
        return pos >= 0 and pos < 1024
    if ext == "png":
        return data[0:8] == bytes([137, 80, 78, 71, 13, 10, 26, 10])
    return data[0:3] == bytes([255, 216, 255])
wow

# Valideer + persisteer een geüpload part {name, filename, content_type, data:Bytes}.
such bewaar much store, part, bron:
    such ext = valideer(part)
    such geupload_op = nap.stamp(nap.now())
    such jaar = geupload_op[0:4]
    such id = store.nieuw_id("b")
    such pad = "uploads/{jaar}/{id}.{ext}"
    such meta = {"id": id, "journaalpost_id": none, "bron": bron, "bestandsnaam_origineel": part["filename"], "pad": pad, "mime": MIME[ext], "grootte_bytes": len(part["data"]), "geupload_op": geupload_op}
    such lijst = store.laad("bijlagen", [])
    store.bewaar_bestand(pad, part["data"])
    lijst.append(meta)
    store.commit("bijlagen", lijst, "geupload", "bijlage", id, meta)
    return meta
wow

# Eerst alles valideren, dan pas opslaan: één fout bestand laat geen half opgeslagen batch achter.
such bewaar_alle much store, parts, bron:
    if len(parts) == 0:
        bonk "kies een bestand"
    for p in parts:
        valideer(p)
    such uit = []
    for p in parts:
        uit.append(bewaar(store, p, bron))
    return uit
wow

# Koppel een inbox-bijlage aan een journaalpost. journaal.doge schrijft de post
# (single writer + tijdvak-lock); pas daarna zetten we journaalpost_id op de bijlage,
# zodat een vergrendeld tijdvak niets aan beide kanten muteert.
such koppel much store, bijlage_id, post_id:
    such lijst = store.laad("bijlagen", [])
    such b = zoek(lijst, bijlage_id)
    if b == none:
        bonk "onbekende bijlage: {bijlage_id}"
    # Alleen vanuit de inbox: omhangen haalt bewijs weg bij een mogelijk vergrendelde post (Hard Rule 3).
    if b["journaalpost_id"] == post_id:
        return b
    if b["journaalpost_id"] != none:
        bonk "bijlage {bijlage_id} is al gekoppeld aan {b["journaalpost_id"]}"
    journaal.koppel_bijlage(store, post_id, bijlage_id)
    b["journaalpost_id"] = post_id
    store.commit("bijlagen", lijst, "gekoppeld", "bijlage", bijlage_id, {"journaalpost_id": post_id})
    return b
wow

# Scan de gemounte data/import/-map: elk bestand wordt via bewaar een inbox-bijlage
# (bron "import"), waarna de bronfile weg gaat zodat een tweede scan niets dubbel doet
# (Hard Rule 2 via bronfile-verwijdering — bijlagen zijn geen boekingen, geen stored key).
# Een geweigerd bestand gaat naar import/overgeslagen/ (nooit verwijderd) en wordt dus één keer
# gemeld; een onleesbaar bestand blijft staan. Dotfiles (.DS_Store e.d.) worden genegeerd.
such scan_import much store:
    such geimporteerd = 0
    such overgeslagen = []
    for naam in store.import_lijst():
        if naam[0:1] == ".":
            continue
        pls
            such data = store.laad_bestand("import/{naam}")
            such part = {"filename": naam, "data": data}
            bewaar(store, part, "import")
            store.import_verwijder(naam)
            very geimporteerd = geimporteerd + 1
        oh no err!
            if err.type == "Bonk":
                store.import_overslaan(naam, err.message)
                overgeslagen.append({"naam": naam, "reden": err.message})
            else:
                overgeslagen.append({"naam": naam, "reden": "bestand niet te verwerken"})
    return {"geimporteerd": geimporteerd, "overgeslagen": overgeslagen}
wow

such scan_samenvatting much res:
    such n = res["geimporteerd"]
    such tekst = "{n} geimporteerd"
    such over = res["overgeslagen"]
    if len(over) > 0:
        such delen = []
        for o in over:
            such nm = o["naam"]
            such rd = o["reden"]
            delen.append("{nm} ({rd})")
        such k = len(over)
        very tekst = tekst + ", {k} overgeslagen: " + strings.join(delen, ", ")
    return tekst
wow
wow
