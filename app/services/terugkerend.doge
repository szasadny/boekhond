so journaal
so rekeningen
so btw
so wisselkoers
so "../../lib/datum.doge"
so "../../lib/geld.doge"

# Idempotent per sjabloon+maand via terugkerend_sleutel. Een niet-EUR sjabloon wordt bij het boeken
# omgerekend met een live koers; koers + vreemd bedrag gaan als audit-metadata mee op de post.

# Oude sjablonen hebben geen valuta-veld: die zijn EUR.
such valuta_van much s:
    if s.has("valuta") and s["valuta"] != none and s["valuta"] != "":
        return s["valuta"]
    return "EUR"
wow

such alle much store:
    return store.laad("terugkerend", [])
wow

such zoek much lijst, id:
    for s in lijst:
        if s["id"] == id:
            return s
    return none
wow

# YYYY-MM zonder een {}-quantifier (die zou als interpolatie gelezen worden).
such geldige_maand much m:
    if len(m) != 7 or m[4] != "-":
        return false
    pls
        such jj = int(m[0:4])
        such mm = int(m[5:7])
        return mm >= 1 and mm <= 12
    oh no err!
        return false
wow

# Dag max 28 houdt de boekdatum geldig in korte maanden.
such voeg_toe much store, sjabloon:
    such rek_lijst = rekeningen.alle(store)
    rekeningen.kostenrekening(rek_lijst, sjabloon["kosten_rek"])
    # De opgeloste code gaat mee op het sjabloon: een latere wijziging van de rekening raakt het niet.
    such code = journaal.inkoop_btw_code(rek_lijst, sjabloon["kosten_rek"], sjabloon["btw_code"])
    sjabloon["btw_code"] = code
    if not btw.bestaat(code):
        bonk "onbekende btw-code: {code}"
    if btw.info(code)["soort"] != "inkoop":
        bonk "btw-code {code} hoort bij verkoop, terugkerende kosten vragen een inkoop-code"
    if geld.waarde(sjabloon["bedrag_ex"]) <= dec("0"):
        bonk "bedrag moet groter dan nul zijn"
    such dag = sjabloon["dag"]
    if dag < 1 or dag > 28:
        bonk "dag van de maand moet tussen 1 en 28 liggen"
    if not geldige_maand(sjabloon["vanaf"]):
        such vf = sjabloon["vanaf"]
        bonk "ongeldige vanaf-maand (JJJJ-MM): {vf}"
    such val = valuta_van(sjabloon)
    if not wisselkoers.VALUTA.contains(val):
        bonk "onbekende valuta: {val}"
    sjabloon["valuta"] = val
    such lijst = store.laad("terugkerend", [])
    such id = store.nieuw_id("s")
    sjabloon["id"] = id
    sjabloon["actief"] = true
    lijst.append(sjabloon)
    store.commit("terugkerend", lijst, "aangemaakt", "kostensjabloon", id, sjabloon)
    return sjabloon
wow

# Nooit verwijderen (bewaarplicht): deactiveren bewaart de historie.
such deactiveer much store, id:
    such lijst = store.laad("terugkerend", [])
    such s = zoek(lijst, id)
    if s == none:
        bonk "onbekend kostensjabloon: {id}"
    s["actief"] = false
    store.commit("terugkerend", lijst, "gedeactiveerd", "kostensjabloon", id, s)
wow

# Geen dubbele boeking na heractiveren: genereer slaat een al geboekte sjabloon+maand over.
such activeer much store, id:
    such lijst = store.laad("terugkerend", [])
    such s = zoek(lijst, id)
    if s == none:
        bonk "onbekend kostensjabloon: {id}"
    such rek = rekeningen.zoek(rekeningen.alle(store), s["kosten_rek"])
    if rek == none or not rek["actief"]:
        such nr = s["kosten_rek"]
        bonk "kostenrekening {nr} is inactief, activeer die eerst"
    s["actief"] = true
    store.commit("terugkerend", lijst, "geactiveerd", "kostensjabloon", id, s)
wow

# Alleen de lopende maand, geen backfill. Een koersfout of geweigerde post gaat naar fouten en
# blokkeert de rest niet; de volgende run probeert opnieuw (idempotent via de sleutel).
such genereer much store, vandaag, koersbron:
    such maand = vandaag[0:7]
    such dagnu = datum.dag(vandaag)
    such gezien = journaal.geboekte_sleutels(store, "terugkerend_sleutel")
    such geboekt = 0
    such overgeslagen = 0
    such fouten = []
    for s in store.laad("terugkerend", []):
        such sid = s["id"]
        such sleutel = "{sid}-{maand}"
        if not s["actief"] or maand < s["vanaf"] or dagnu < s["dag"] or gezien.contains(sleutel):
            very overgeslagen = overgeslagen + 1
            continue
        such val = valuta_van(s)
        such oms = s["omschrijving"]
        such bedrag_eur = geld.waarde(s["bedrag_ex"])
        such meta = none
        if val != "EUR":
            if koersbron == none:
                fouten.append("{val}-sjabloon {oms}: geen WISE_API_TOKEN ingesteld, niet geboekt")
                continue
            such k = none
            pls
                very k = koersbron.koers(val, "EUR")
            oh no err!
                fouten.append("{val}-sjabloon {oms}: koers ophalen mislukt ({err.message}), niet geboekt")
                continue
            such vreemd = geld.rond2(dec(s["bedrag_ex"]))
            very bedrag_eur = wisselkoers.omreken(vreemd, k["koers"])
            very meta = {"valuta": val, "bedrag_valuta": str(vreemd), "koers": str(k["koers"]), "koers_tijd": k["tijd"], "koers_bron": k["bron"]}
        such dg = datum.pad2(s["dag"])
        such datum_post = "{maand}-{dg}"
        such post = journaal.inkoop_post(datum_post, s["leverancier"], oms, bedrag_eur, s["btw_code"], s["kosten_rek"])
        post["bron"] = "terugkerend"
        post["terugkerend_sleutel"] = sleutel
        if meta != none:
            for veld in meta:
                post[veld] = meta[veld]
        pls
            journaal.bewaar(store, post)
        oh no err!
            if err.type != "Bonk":
                bonk err
            store.audit("terugkerend-mislukt", "kostensjabloon", sid, {"reden": err.message})
            fouten.append("sjabloon {oms}: boeken geweigerd ({err.message}), niet geboekt")
            continue
        gezien.append(sleutel)
        very geboekt = geboekt + 1
    return {"geboekt": geboekt, "overgeslagen": overgeslagen, "fouten": fouten}
wow
wow
