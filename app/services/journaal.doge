so btw
so rekeningen
so nap
so "../../lib/datum.doge"
so "../../lib/geld.doge"

# Een ingediende aangifte vergrendelt het tijdvak.
such tijdvak_open much aangiften, d:
    such tv = "Q{datum.kwartaal(d)}"
    such j = datum.jaar(d)
    for a in aangiften:
        if a["jaar"] == j and a["tijdvak"] == tv and a["status"] == "ingediend":
            return false
    return true
wow

such balans_klopt much regels:
    such debet = dec("0")
    such credit = dec("0")
    for r in regels:
        very debet = debet + geld.bedrag(r["debet"])
        very credit = credit + geld.bedrag(r["credit"])
    return geld.rond2(debet) == geld.rond2(credit)
wow

# Sjabloonflows mogen alleen codes van hun eigen soort dragen; memoriaal en storno zijn vrij.
so SOORT_PER_BRON = {"handmatig": "inkoop", "terugkerend": "inkoop", "mollie": "verkoop"}

such is_gevuld much bedrag:
    return bedrag != "" and bedrag != none
wow

# Een storno mag een inmiddels inactieve rekening raken: hij spiegelt een post die toen geldig was.
such controleer_regel much r, rek_lijst, soort, storno:
    such nr = r["rekening"]
    if nr == "" or nr == none:
        bonk "regel zonder rekening"
    such rek = rekeningen.zoek(rek_lijst, nr)
    if rek == none:
        bonk "onbekende rekening: {nr}"
    if not rek["actief"] and not storno:
        bonk "rekening is inactief: {nr}"
    such heeft_debet = is_gevuld(r["debet"])
    if heeft_debet == is_gevuld(r["credit"]):
        bonk "regel op rekening {nr} moet precies één bedrag hebben: debet of credit"
    such bedrag = geld.bedrag(r["debet"] if heeft_debet else r["credit"])
    if bedrag < dec("0"):
        bonk "negatief bedrag op rekening {nr}"
    if not geld.binnen_grens(bedrag):
        such max = geld.formatteer(geld.MAX_BEDRAG)
        bonk "bedrag op rekening {nr} is te groot (maximaal {max})"
    if r.has("btw_code") and r["btw_code"]:
        such code = r["btw_code"]
        if not btw.bestaat(code):
            bonk "onbekende btw-code: {code}"
        such code_soort = btw.info(code)["soort"]
        if soort != none and code_soort != soort:
            bonk "btw-code {code} hoort bij {code_soort}, deze boeking vraagt een {soort}-code"
    if r.has("btw_bedrag") and r["btw_bedrag"] != none:
        such code = r["btw_code"] if r.has("btw_code") else none
        if not code or not btw.factuur_btw_geldig(bedrag, code, geld.bedrag(r["btw_bedrag"])):
            bonk "ongeldig btw-bedrag op rekening {nr}"
    return bedrag
wow

# sleutel is JJJJMMDD als Int, dus + 10000 is dezelfde dag een jaar later.
such controleer_boekdatum much d, vandaag:
    if datum.sleutel(d) > datum.sleutel(vandaag) + 10000:
        bonk "boekdatum {d} ligt meer dan een jaar in de toekomst"
wow

such controleer_post much post, rek_lijst, aangiften:
    such d = post["datum"]
    datum.controleer(d)
    controleer_boekdatum(d, datum.vandaag())
    if len(post["regels"]) < 2:
        bonk "een journaalpost heeft minstens twee regels"
    if not balans_klopt(post["regels"]):
        bonk "post balanceert niet: som(debet) != som(credit)"
    such soort = none
    if SOORT_PER_BRON.has(post["bron"]):
        very soort = SOORT_PER_BRON[post["bron"]]
    such storno = post.has("storno_van") and post["storno_van"] != none
    such totaal = dec("0")
    for r in post["regels"]:
        very totaal = totaal + controleer_regel(r, rek_lijst, soort, storno)
    if totaal <= dec("0"):
        bonk "een journaalpost moet een bedrag groter dan nul hebben"
    if soort == "inkoop":
        for r in post["regels"]:
            if r.has("btw_code") and r["btw_code"]:
                rekeningen.kostenrekening(rek_lijst, r["rekening"])
    if not tijdvak_open(aangiften, d):
        such tv = datum.kwartaal(d)
        such j = datum.jaar(d)
        bonk "tijdvak Q{tv}-{j} is ingediend en vergrendeld"
wow

such nummer_post much store, post:
    post["id"] = store.nieuw_id("j")
    post["created_at"] = nap.stamp(nap.now())
    if not post.has("bijlage_ids"):
        post["bijlage_ids"] = []
    return post
wow

such bewaar much store, post:
    controleer_post(post, rekeningen.alle(store), store.laad("aangiften", []))
    such lijst = store.laad("journaal", [])
    nummer_post(store, post)
    lijst.append(post)
    store.commit("journaal", lijst, "aangemaakt", "journaalpost", post["id"], post)
    return post
wow

# Hele batch of niets: alles gecontroleerd vóór de eerste id, dan één journaal-write.
such bewaar_alle much store, posten:
    such rek_lijst = rekeningen.alle(store)
    such aangiften = store.laad("aangiften", [])
    for p in posten:
        controleer_post(p, rek_lijst, aangiften)
    if len(posten) == 0:
        return posten
    such lijst = store.laad("journaal", [])
    such events = []
    for p in posten:
        nummer_post(store, p)
        lijst.append(p)
        events.append({"actie": "aangemaakt", "entiteit": "journaalpost", "id": p["id"], "data": p})
    store.commit_alle("journaal", lijst, events)
    return posten
wow

# Een bijlage hangen aan een post in een ingediend tijdvak is muteren.
such koppel_bijlage much store, post_id, bijlage_id:
    such lijst = store.laad("journaal", [])
    such post = none
    for p in lijst:
        if p["id"] == post_id:
            very post = p
    if post == none:
        bonk "onbekende journaalpost: {post_id}"
    if not tijdvak_open(store.laad("aangiften", []), post["datum"]):
        such tv = datum.kwartaal(post["datum"])
        such j = datum.jaar(post["datum"])
        bonk "tijdvak Q{tv}-{j} is ingediend en vergrendeld"
    if not post.has("bijlage_ids"):
        post["bijlage_ids"] = []
    if not post["bijlage_ids"].contains(bijlage_id):
        post["bijlage_ids"].append(bijlage_id)
    store.commit("journaal", lijst, "bijlage_gekoppeld", "journaalpost", post_id, {"bijlage_id": bijlage_id})
    return post
wow

# Alleen de kostenregel draagt de btw_code; btw- en crediteurenregels bestaan voor de balans.
such inkoop_post much datum_s, leverancier, omschrijving, bedrag_ex, code, kosten_rek:
    such ex = geld.rond2(bedrag_ex)
    such c = btw.info(code)
    such bb = btw.btw_bedrag(ex, code)
    such regels = []
    regels.append({"rekening": kosten_rek, "debet": str(ex), "credit": "", "btw_code": code})
    if c["zelf"]:
        # verlegd: factuur is exclusief, zelf afdragen én voorbelasting
        regels.append({"rekening": rekeningen.REK_VOORBELASTING, "debet": str(bb), "credit": "", "btw_code": none})
        regels.append({"rekening": rekeningen.REK_CREDITEUREN, "debet": "", "credit": str(ex), "btw_code": none})
        regels.append({"rekening": rekeningen.REK_AF_TE_DRAGEN, "debet": "", "credit": str(bb), "btw_code": none})
    elif c["aftrek"]:
        regels.append({"rekening": rekeningen.REK_VOORBELASTING, "debet": str(bb), "credit": "", "btw_code": none})
        regels.append({"rekening": rekeningen.REK_CREDITEUREN, "debet": "", "credit": str(geld.rond2(ex + bb)), "btw_code": none})
    else:
        regels.append({"rekening": rekeningen.REK_CREDITEUREN, "debet": "", "credit": str(ex), "btw_code": none})
    return {"datum": datum_s, "omschrijving": omschrijving, "relatie": leverancier, "regels": regels, "bron": "handmatig", "bijlage_ids": []}
wow

such inkoop_btw_code much rek_lijst, kosten_rek, code:
    if code != "":
        return code
    such rek = rekeningen.zoek(rek_lijst, kosten_rek)
    if rek == none:
        bonk "kies een kostenrekening"
    if not rek.has("btw_code") or not rek["btw_code"]:
        bonk "kies een btw-code: rekening {kosten_rek} heeft geen standaard-btw-code"
    return rek["btw_code"]
wow

# kant: "storting" of "onttrekking".
such prive_post much datum_s, omschrijving, rekening, bedrag, kant:
    if rekening == rekeningen.REK_PRIVE:
        bonk "kies een tegenrekening, niet de privérekening {rekeningen.REK_PRIVE} zelf"
    such b = str(geld.rond2(bedrag))
    such regels = []
    if kant == "storting":
        regels.append({"rekening": rekening, "debet": b, "credit": "", "btw_code": none})
        regels.append({"rekening": rekeningen.REK_PRIVE, "debet": "", "credit": b, "btw_code": none})
    else:
        regels.append({"rekening": rekeningen.REK_PRIVE, "debet": b, "credit": "", "btw_code": none})
        regels.append({"rekening": rekening, "debet": "", "credit": b, "btw_code": none})
    return {"datum": datum_s, "omschrijving": omschrijving, "relatie": "", "regels": regels, "bron": "bank", "bijlage_ids": []}
wow

# Per saldo verhuist alleen de btw; de grondslag staat als self-nettend memo-paar op REK_PRIVE,
# zodat 1d meetelt zonder de omzet te vervuilen.
such privegebruik_post much datum_s, grondslag_ex:
    datum.controleer(datum_s)
    if datum.kwartaal(datum_s) != 4:
        bonk "privégebruik-correctie hoort in Q4 (laatste aangifte van het jaar)"
    such ex = geld.rond2(grondslag_ex)
    if ex <= 0:
        bonk "grondslag privégebruik moet groter zijn dan 0"
    such bb = btw.btw_bedrag(ex, "prive_gebruik")
    such totaal = geld.rond2(ex + bb)
    such regels = []
    regels.append({"rekening": rekeningen.REK_PRIVE, "debet": str(totaal), "credit": "", "btw_code": none})
    regels.append({"rekening": rekeningen.REK_PRIVE, "debet": "", "credit": str(ex), "btw_code": "prive_gebruik"})
    regels.append({"rekening": rekeningen.REK_AF_TE_DRAGEN, "debet": "", "credit": str(bb), "btw_code": none})
    such j = datum.jaar(datum_s)
    return {"datum": datum_s, "omschrijving": "Privégebruik {j}", "relatie": "", "regels": regels, "bron": "memoriaal", "bijlage_ids": []}
wow

such memoriaal_post much datum_s, omschrijving, relatie, regels:
    return {"datum": datum_s, "omschrijving": omschrijving, "relatie": relatie, "regels": regels, "bron": "memoriaal", "bijlage_ids": []}
wow

such geboekte_sleutels much store, veld:
    such uit = []
    for p in store.laad("journaal", []):
        if p.has(veld) and p[veld] != none:
            uit.append(p[veld])
    return uit
wow

such zoek_post much lijst, id:
    for p in lijst:
        if p["id"] == id:
            return p
    return none
wow

# Een herboeking na een storno nettoot in het suppletie-signaal tegen het oorspronkelijke tijdvak.
such markeer_correctie much store, post, van_id:
    such orig = zoek_post(store.laad("journaal", []), van_id)
    if orig == none:
        bonk "onbekende journaalpost: {van_id}"
    if tijdvak_open(store.laad("aangiften", []), orig["datum"]):
        bonk "post {van_id} valt niet in een ingediend tijdvak"
    post["correctie_van"] = van_id
    post["correctie_van_datum"] = orig["datum"]
    return post
wow

# btw_code en btw_bedrag blijven staan zodat de rubriek terugdraait; gedateerd in het open tijdvak.
such storno_post much oorspronkelijke_post, datum_s:
    such oid = oorspronkelijke_post["id"]
    such regels = []
    for r in oorspronkelijke_post["regels"]:
        such code = none
        if r.has("btw_code"):
            very code = r["btw_code"]
        such gespiegeld = {"rekening": r["rekening"], "debet": r["credit"], "credit": r["debet"], "btw_code": code}
        if r.has("btw_bedrag"):
            gespiegeld["btw_bedrag"] = r["btw_bedrag"]
        regels.append(gespiegeld)
    such rel = ""
    if oorspronkelijke_post.has("relatie"):
        very rel = oorspronkelijke_post["relatie"]
    return {"datum": datum_s, "omschrijving": "Storno van {oid}", "relatie": rel, "regels": regels, "bron": "memoriaal", "bijlage_ids": [], "storno_van": oid}
wow

such storno_index much lijst:
    such idx = {}
    for p in lijst:
        if p.has("storno_van") and p["storno_van"] != none:
            idx[p["storno_van"]] = p["id"]
    return idx
wow

# Een Mollie-refund draait de omzet al terug; een storno erbovenop zou die dubbel terugdraaien.
such refund_index much lijst:
    such idx = {}
    for p in lijst:
        if p.has("refund_van") and p["refund_van"] != none:
            idx[p["refund_van"]] = p["id"]
        if p.has("terugbetaald_via") and len(p["terugbetaald_via"]) > 0:
            idx[p["id"]] = p["terugbetaald_via"][0]
    return idx
wow

# Een storno corrigeer je met een nieuwe post, niet met een storno van de storno.
such storno_weigering much lijst, post:
    such pid = post["id"]
    if post.has("storno_van") and post["storno_van"] != none:
        such van = post["storno_van"]
        return "post {pid} is zelf een storno van {van} en kan niet gestorneerd worden"
    if post.has("mollie_refund_id") and post["mollie_refund_id"] != none:
        return "post {pid} is een Mollie-refund en kan niet gestorneerd worden"
    such idx = storno_index(lijst)
    if idx.has(pid):
        such sid = idx[pid]
        return "post {pid} is al gestorneerd door {sid}"
    such refunds = refund_index(lijst)
    if refunds.has(pid):
        such rid = refunds[pid]
        return "post {pid} is al deels of geheel terugbetaald via refund-post {rid} en kan niet gestorneerd worden"
    return ""
wow

such storneer much store, post_id, datum_s:
    such lijst = store.laad("journaal", [])
    such orig = zoek_post(lijst, post_id)
    if orig == none:
        bonk "onbekende journaalpost: {post_id}"
    such reden = storno_weigering(lijst, orig)
    if reden != "":
        bonk reden
    return bewaar(store, storno_post(orig, datum_s))
wow
wow
