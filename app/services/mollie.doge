so howl
so json
so hunt
so journaal
so btw
so rekeningen
so "../../lib/datum.doge"

so BASIS = "https://api.mollie.com/v2"
so VALUTA = "EUR"
so LIMIET = 250
so MAX_PAGINAS = 200
so VORMFOUTEN = ["KeyError", "TypeError", "ValueError", "IndexOutOfBounds", "AttrError"]

such haal_json much key, url:
    such opts = {"headers": {"Authorization": "Bearer {key}"}}
    such resp = none
    pls
        very resp = howl.request("GET", url, opts)
    oh no err!
        if err.type != "IOError":
            bonk err
        bonk "Mollie is niet bereikbaar"
    return lees_antwoord(resp)
wow

such lees_antwoord much resp:
    such st = resp["status"]
    if st != 200:
        bonk "Mollie API gaf status {st}"
    pls
        return json.parse(resp["body"])
    oh no err!
        if err.type != "ValueError":
            bonk err
        bonk "ongeldig antwoord van Mollie"
wow

# Geen early stop op mollie_laatste_sync: een oudere payment kan na de vorige sync nog betaald worden.
such haal_alle much haal, key, url, soort:
    such uit = []
    such volgende = url
    such paginas = 0
    while volgende != none:
        if paginas >= MAX_PAGINAS:
            bonk "Mollie {soort}: meer dan {MAX_PAGINAS} pagina's, sync afgebroken"
        such data = haal(key, volgende)
        such items = veld(data, ["_embedded", soort])
        if items == none:
            bonk "ongeldig antwoord van Mollie"
        for x in items:
            uit.append(x)
        very paginas = paginas + 1
        very volgende = volgende_url(data)
    return uit
wow

such volgende_url much data:
    return veld(data, ["_links", "next", "href"])
wow

such haal_betalingen much key:
    return haal_alle(haal_json, key, "{BASIS}/payments?limit={LIMIET}", "payments")
wow

such haal_refunds much key:
    return haal_alle(haal_json, key, "{BASIS}/refunds?limit={LIMIET}", "refunds")
wow

# Een Mollie-antwoord kan velden missen of een ander type hebben: none in plaats van een KeyError.
such veld much obj, pad:
    such v = obj
    pls
        for k in pad:
            very v = v[k]
    oh no err!
        if not VORMFOUTEN.contains(err.type):
            bonk err
        return none
    return v
wow

such gebrek much item, velden, datumveld:
    for v in velden:
        if veld(item, [v]) == none:
            return v
    pls
        dec(veld(item, ["amount", "value"]))
    oh no err!
        if not VORMFOUTEN.contains(err.type):
            bonk err
        return "amount"
    pls
        datum.lokale_datum(item[datumveld])
    oh no err!
        if not VORMFOUTEN.contains(err.type):
            bonk err
        return datumveld
    return none
wow

# Geen koersconversie: een niet-EUR bedrag als euro boeken vervalst rubriek 1a.
such vreemde_valuta much bedrag:
    such cur = bedrag["currency"] if bedrag.has("currency") else "?"
    if cur == VALUTA:
        return none
    such waarde = bedrag["value"] if bedrag.has("value") else ""
    return "{cur} {waarde}"
wow

such betaling_naar_post much betaling:
    such vv = vreemde_valuta(betaling["amount"])
    if vv != none:
        bonk "Mollie-payment in {vv} niet geboekt, alleen {VALUTA}"
    such incl = dec(betaling["amount"]["value"])
    such split = btw.splits_incl(incl, "hoog_21")
    such ex = split[0]
    such vat = split[1]
    such d = datum.lokale_datum(betaling["paidAt"])
    such pid = betaling["id"]
    such regels = [{"rekening": rekeningen.REK_BANK, "debet": str(incl), "credit": "", "btw_code": none}, {"rekening": rekeningen.REK_OMZET_HOOG, "debet": "", "credit": str(ex), "btw_code": "hoog_21", "btw_bedrag": str(vat)}, {"rekening": rekeningen.REK_AF_TE_DRAGEN, "debet": "", "credit": str(vat), "btw_code": none}]
    return {"datum": d, "omschrijving": betaling["description"], "relatie": "Mollie", "regels": regels, "bron": "mollie", "mollie_payment_id": pid, "bijlage_ids": []}
wow

# hoog_21 op de debet-kant geeft een negatieve grondslag: trekt af van rubriek 1a.
such refund_naar_post much refund:
    such vv = vreemde_valuta(refund["amount"])
    if vv != none:
        bonk "Mollie-refund in {vv} niet geboekt, alleen {VALUTA}"
    such incl = dec(refund["amount"]["value"])
    such split = btw.splits_incl(incl, "hoog_21")
    such ex = split[0]
    such vat = split[1]
    such d = datum.lokale_datum(refund["createdAt"])
    such rid = refund["id"]
    such regels = [{"rekening": rekeningen.REK_BANK, "debet": "", "credit": str(incl), "btw_code": none}, {"rekening": rekeningen.REK_OMZET_HOOG, "debet": str(ex), "credit": "", "btw_code": "hoog_21", "btw_bedrag": str(vat)}, {"rekening": rekeningen.REK_AF_TE_DRAGEN, "debet": str(vat), "credit": "", "btw_code": none}]
    return {"datum": d, "omschrijving": "Refund {rid}", "relatie": "Mollie", "regels": regels, "bron": "mollie", "mollie_refund_id": rid, "bijlage_ids": []}
wow

# Elke volgende sync meldt (en audit) 'm opnieuw, tot de gebruiker hem als afgehandeld markeert.
such weiger much store, soort, id, vv, geweigerd, items:
    store.audit("mollie-geweigerd", soort, id, {"reden": "valuta", "bedrag": vv})
    geweigerd.append("{id} ({vv})")
    items.append({"soort": soort, "id": id, "bedrag": vv})
wow

such meld_mislukt much store, soort, id, reden, mislukt:
    store.audit("mollie-mislukt", soort, id, {"reden": reden})
    mislukt.append("{id} ({reden})")
wow

# Een geweigerde post (bv. inactieve rekening) mag de rest van de batch niet blokkeren.
such probeer_post much store, post, rek_lijst, aangiften, soort, id, mislukt:
    pls
        journaal.controleer_post(post, rek_lijst, aangiften)
        return true
    oh no err!
        if err.type != "Bonk":
            bonk err
        meld_mislukt(store, soort, id, err.message, mislukt)
        return false
wow

such ongeldig_item much store, item, soort, mislukt:
    such id = veld(item, ["id"])
    if id == none or veld(item, ["status"]) == none:
        meld_mislukt(store, soort, "?" if id == none else id, "ongeldig antwoord van Mollie: id of status ontbreekt", mislukt)
        return true
    return false
wow

such ongeldige_velden much store, item, soort, velden, datumveld, mislukt:
    such g = gebrek(item, velden, datumveld)
    if g == none:
        return false
    such id = item["id"]
    meld_mislukt(store, soort, id, "ongeldig antwoord van Mollie: {g} ontbreekt of is ongeldig", mislukt)
    return true
wow

# Ingediend tijdvak is op slot: boek als correctie in het open tijdvak van vandaag.
such verschuif much post, soort:
    such orig = post["datum"]
    such tv = "Q{datum.kwartaal(orig)}-{datum.jaar(orig)}"
    such oms = post["omschrijving"]
    post["datum"] = datum.vandaag()
    post["omschrijving"] = "{oms} ({soort} {orig}, tijdvak {tv} ingediend)"
    post["correctie_van_datum"] = orig
    return post
wow

such boek_betalingen much store, betalingen:
    such gezien = journaal.geboekte_sleutels(store, "mollie_payment_id")
    such ongekoppeld = ongekoppelde_refunds(store.laad("journaal", []))
    such aangiften = store.laad("aangiften", [])
    such rek_lijst = rekeningen.alle(store)
    such afgehandeld = afgehandelde_ids(store)
    such nieuw = []
    such geboekt = 0
    such overgeslagen = 0
    such verschoven = []
    such vergrendeld = []
    such geweigerd = []
    such geweigerd_items = []
    such mislukt = []
    for b in betalingen:
        if ongeldig_item(store, b, "mollie-payment", mislukt):
            continue
        such pid = b["id"]
        if b["status"] != "paid" or gezien.contains(pid):
            very overgeslagen = overgeslagen + 1
            continue
        if ongeldige_velden(store, b, "mollie-payment", ["description"], "paidAt", mislukt):
            continue
        such vv = vreemde_valuta(b["amount"])
        if vv != none:
            if afgehandeld.contains(pid):
                very overgeslagen = overgeslagen + 1
            else:
                weiger(store, "mollie-payment", pid, vv, geweigerd, geweigerd_items)
            continue
        # Een betaling van 0,00 (bv. mandaat-eerste-betaling) heeft geen omzet en dus geen post.
        if dec(b["amount"]["value"]) == dec("0"):
            very overgeslagen = overgeslagen + 1
            continue
        such post = betaling_naar_post(b)
        such verschuift = false
        if not journaal.tijdvak_open(aangiften, post["datum"]):
            if not journaal.tijdvak_open(aangiften, datum.vandaag()):
                vergrendeld.append(pid)
                continue
            verschuif(post, "betaald")
            very verschuift = true
        if ongekoppeld.has(pid):
            post["terugbetaald_via"] = ongekoppeld[pid]
        if not probeer_post(store, post, rek_lijst, aangiften, "mollie-payment", pid, mislukt):
            continue
        nieuw.append(post)
        if verschuift:
            verschoven.append(pid)
        gezien.append(pid)
        very geboekt = geboekt + 1
    journaal.bewaar_alle(store, nieuw)
    return {"geboekt": geboekt, "overgeslagen": overgeslagen, "verschoven": verschoven, "vergrendeld": vergrendeld, "geweigerd": geweigerd, "geweigerd_items": geweigerd_items, "mislukt": mislukt}
wow

such betaal_index much posten:
    such idx = {}
    for p in posten:
        if p.has("mollie_payment_id") and p["mollie_payment_id"] != none:
            idx[p["mollie_payment_id"]] = p["id"]
    return idx
wow

# De link zit op de refund-post, zodat de betaal-post in een ingediend tijdvak onaangeroerd blijft.
such koppel_betaling much post, refund, betaal_posten:
    if veld(refund, ["paymentId"]) == none:
        return post
    post["refund_payment_id"] = refund["paymentId"]
    if betaal_posten.has(refund["paymentId"]):
        post["refund_van"] = betaal_posten[refund["paymentId"]]
    return post
wow

# Refund-posten die geboekt zijn voordat hun payment een post had. De betaal-post krijgt de link
# bij het aanmaken, zodat een refund-post in een ingediend tijdvak nooit muteert.
such ongekoppelde_refunds much posten:
    such idx = {}
    for p in posten:
        if p.has("refund_payment_id") and not p.has("refund_van"):
            such pid = p["refund_payment_id"]
            if not idx.has(pid):
                idx[pid] = []
            idx[pid].append(p["id"])
    return idx
wow

such boek_refund_lijst much store, refunds:
    such gezien = journaal.geboekte_sleutels(store, "mollie_refund_id")
    such betaal_posten = betaal_index(store.laad("journaal", []))
    such aangiften = store.laad("aangiften", [])
    such rek_lijst = rekeningen.alle(store)
    such afgehandeld = afgehandelde_ids(store)
    such nieuw = []
    such geboekt = 0
    such overgeslagen = 0
    such verschoven = []
    such vergrendeld = []
    such geweigerd = []
    such geweigerd_items = []
    such mislukt = []
    for r in refunds:
        if ongeldig_item(store, r, "mollie-refund", mislukt):
            continue
        such rid = r["id"]
        if r["status"] != "refunded" or gezien.contains(rid):
            very overgeslagen = overgeslagen + 1
            continue
        if ongeldige_velden(store, r, "mollie-refund", [], "createdAt", mislukt):
            continue
        such vv = vreemde_valuta(r["amount"])
        if vv != none:
            if afgehandeld.contains(rid):
                very overgeslagen = overgeslagen + 1
            else:
                weiger(store, "mollie-refund", rid, vv, geweigerd, geweigerd_items)
            continue
        if dec(r["amount"]["value"]) == dec("0"):
            very overgeslagen = overgeslagen + 1
            continue
        such post = refund_naar_post(r)
        koppel_betaling(post, r, betaal_posten)
        such verschuift = false
        if not journaal.tijdvak_open(aangiften, post["datum"]):
            if not journaal.tijdvak_open(aangiften, datum.vandaag()):
                vergrendeld.append(rid)
                continue
            verschuif(post, "terugbetaald")
            very verschuift = true
        if not probeer_post(store, post, rek_lijst, aangiften, "mollie-refund", rid, mislukt):
            continue
        nieuw.append(post)
        if verschuift:
            verschoven.append(rid)
        gezien.append(rid)
        very geboekt = geboekt + 1
    journaal.bewaar_alle(store, nieuw)
    return {"geboekt": geboekt, "overgeslagen": overgeslagen, "verschoven": verschoven, "vergrendeld": vergrendeld, "geweigerd": geweigerd, "geweigerd_items": geweigerd_items, "mislukt": mislukt}
wow

such onthoud_sync much store:
    such inst = store.laad("instellingen", {})
    inst["mollie_laatste_sync"] = datum.vandaag()
    store.commit("instellingen", inst, "mollie-sync", "instellingen", "instellingen", inst)
wow

such laatste_sync much store:
    such inst = store.laad("instellingen", {})
    if inst.has("mollie_laatste_sync"):
        return inst["mollie_laatste_sync"]
    return none
wow

# Geweigerde items die de gebruiker met de hand heeft geboekt.
so SOORTEN = ["mollie-payment", "mollie-refund"]

such afgehandeld much store:
    such inst = store.laad("instellingen", {})
    if inst.has("mollie_afgehandeld"):
        return inst["mollie_afgehandeld"]
    return []
wow

such afgehandelde_ids much store:
    such uit = []
    for a in afgehandeld(store):
        uit.append(a["id"])
    return uit
wow

such markeer_afgehandeld much store, soort, id:
    if not SOORTEN.contains(soort):
        bonk "onbekend soort Mollie-item"
    if len(id) > 64 or not hunt.test("^[A-Za-z0-9_]+$", id):
        bonk "ongeldig Mollie-id"
    such inst = store.laad("instellingen", {})
    such lijst = inst["mollie_afgehandeld"] if inst.has("mollie_afgehandeld") else []
    for a in lijst:
        if a["id"] == id:
            return false
    such item = {"soort": soort, "id": id, "datum": datum.vandaag()}
    lijst.append(item)
    inst["mollie_afgehandeld"] = lijst
    store.commit("instellingen", inst, "mollie-afgehandeld", soort, id, item)
    return true
wow

such sync much store, key:
    such betalingen = haal_betalingen(key)
    such pres = boek_betalingen(store, betalingen)
    such rres = boek_refund_lijst(store, haal_refunds(key))
    onthoud_sync(store)
    return {"betalingen": pres, "refunds": rres, "geboekt": pres["geboekt"] + rres["geboekt"], "verschoven": pres["verschoven"] + rres["verschoven"], "vergrendeld": pres["vergrendeld"] + rres["vergrendeld"], "geweigerd": pres["geweigerd"] + rres["geweigerd"], "geweigerd_items": pres["geweigerd_items"] + rres["geweigerd_items"], "mislukt": pres["mislukt"] + rres["mislukt"]}
wow
wow
