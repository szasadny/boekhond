so howl
so json
so journaal
so btw
so rekeningen
so "../../lib/geld.doge"
so "../../lib/datum.doge"

# Mollie-import: betaalde payments (+ refunds) ophalen en als gebalanceerde omzet-posten
# boeken (21% -> rubriek 1a), idempotent per mollie_payment_id / mollie_refund_id (§4.2/4.3).
# Netwerk zit in de haal_*-functies; de mapping + boeking zijn puur/store-only en getest.
# Getriggerd door de handmatige knop (mollie_h) en straks de scheduler-pup (Fase 5).

so BASIS = "https://api.mollie.com/v2"
so TEGENREKENING = "1100"
so VALUTA = "EUR"
so LIMIET = 250
so MAX_PAGINAS = 200

# --- Netwerk ---
such haal_json much key, url:
    such opts = {"headers": {"Authorization": "Bearer {key}"}}
    such resp = howl.request("GET", url, opts)
    such st = resp["status"]
    if st != 200:
        bonk "Mollie API gaf status {st}"
    return json.parse(resp["body"])
wow

# Geen early stop op mollie_laatste_sync: een oudere payment kan na de vorige sync nog betaald worden.
such haal_alle much haal, key, url, soort:
    such uit = []
    such volgende = url
    such paginas = 0
    while volgende != none:
        if paginas >= MAX_PAGINAS:
            bonk "Mollie {soort}: meer dan {MAX_PAGINAS} pagina's, sync afgebroken"
        such data = haal(key, volgende)
        for x in data["_embedded"][soort]:
            uit.append(x)
        very paginas = paginas + 1
        very volgende = volgende_url(data)
    return uit
wow

such volgende_url much data:
    if not data.has("_links"):
        return none
    such links = data["_links"]
    if not links.has("next") or links["next"] == none:
        return none
    return links["next"]["href"]
wow

such haal_betalingen much key:
    return haal_alle(haal_json, key, "{BASIS}/payments?limit={LIMIET}", "payments")
wow

such haal_refunds much key:
    return haal_alle(haal_json, key, "{BASIS}/refunds?limit={LIMIET}", "refunds")
wow

# --- Pure mapping ---
such datum_van much iso:
    return datum.lokale_datum(iso)
wow

# Geen koersconversie: een niet-EUR bedrag als euro boeken vervalst rubriek 1a.
such vreemde_valuta much bedrag:
    such cur = bedrag["currency"] if bedrag.has("currency") else "?"
    if cur == VALUTA:
        return none
    such waarde = bedrag["value"] if bedrag.has("value") else ""
    return "{cur} {waarde}"
wow

such voeg_afronding_toe much regels:
    such d = dec("0")
    such c = dec("0")
    for r in regels:
        very d = d + geld.bedrag(r["debet"])
        very c = c + geld.bedrag(r["credit"])
    such verschil = geld.rond2(d) - geld.rond2(c)
    if verschil > dec("0"):
        regels.append({"rekening": rekeningen.REK_AFRONDING, "debet": "", "credit": str(verschil), "btw_code": none})
    elif verschil < dec("0"):
        regels.append({"rekening": rekeningen.REK_AFRONDING, "debet": str(dec("0") - verschil), "credit": "", "btw_code": none})
    return regels
wow

# Betaalde payment -> omzet-post: incl op de bank-kant (debet), ex als omzet-grondslag
# (credit, hoog_21), btw op af te dragen (credit); een cent-afrondingsverschil sluit de post.
such betaling_naar_post much betaling:
    such vv = vreemde_valuta(betaling["amount"])
    if vv != none:
        bonk "Mollie-payment in {vv} niet geboekt, alleen {VALUTA}"
    such incl = dec(betaling["amount"]["value"])
    such split = btw.splits_incl(incl, "hoog_21")
    such ex = split[0]
    such vat = split[1]
    such d = datum_van(betaling["paidAt"])
    such pid = betaling["id"]
    such regels = [{"rekening": rekeningen.REK_BANK, "debet": str(incl), "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": str(ex), "btw_code": "hoog_21"}, {"rekening": rekeningen.REK_AF_TE_DRAGEN, "debet": "", "credit": str(vat), "btw_code": none}]
    voeg_afronding_toe(regels)
    return {"datum": d, "omschrijving": betaling["description"], "relatie": "Mollie", "regels": regels, "bron": "mollie", "mollie_payment_id": pid, "bijlage_ids": []}
wow

# Refund -> tegenboeking: gespiegeld t.o.v. de omzet-post (geld eraf, omzet + btw terug).
# hoog_21 op de debet-kant -> regel_grondslag negatief -> trekt af van rubriek 1a.
such refund_naar_post much refund:
    such vv = vreemde_valuta(refund["amount"])
    if vv != none:
        bonk "Mollie-refund in {vv} niet geboekt, alleen {VALUTA}"
    such incl = dec(refund["amount"]["value"])
    such split = btw.splits_incl(incl, "hoog_21")
    such ex = split[0]
    such vat = split[1]
    such d = datum_van(refund["createdAt"])
    such rid = refund["id"]
    such regels = [{"rekening": rekeningen.REK_BANK, "debet": "", "credit": str(incl), "btw_code": none}, {"rekening": "8000", "debet": str(ex), "credit": "", "btw_code": "hoog_21"}, {"rekening": rekeningen.REK_AF_TE_DRAGEN, "debet": str(vat), "credit": "", "btw_code": none}]
    voeg_afronding_toe(regels)
    return {"datum": d, "omschrijving": "Refund {rid}", "relatie": "Mollie", "regels": regels, "bron": "mollie", "mollie_refund_id": rid, "bijlage_ids": []}
wow

# --- Idempotente boeking (store-only, getest) ---
# Niet gemarkeerd als geboekt, dus elke volgende sync meldt (en audit) 'm opnieuw.
such weiger much store, soort, id, vv, geweigerd:
    store.audit("mollie-geweigerd", soort, id, {"reden": "valuta", "bedrag": vv})
    geweigerd.append("{id} ({vv})")
wow

# Ingediend tijdvak is op slot (Hard Rule 3): boek als correctie in het open tijdvak van vandaag.
such verschuif much post, soort:
    such orig = post["datum"]
    such tv = "Q{datum.kwartaal(orig)}-{datum.jaar(orig)}"
    such oms = post["omschrijving"]
    post["datum"] = datum.vandaag()
    post["omschrijving"] = "{oms} ({soort} {orig}, tijdvak {tv} ingediend)"
    post["correctie_van_datum"] = orig
    return post
wow

such boek_betalingen much store, betalingen:
    such gezien = journaal.geboekte_sleutels(store, "mollie_payment_id")
    such aangiften = store.laad("aangiften", [])
    such geboekt = 0
    such overgeslagen = 0
    such verschoven = []
    such vergrendeld = []
    such geweigerd = []
    for b in betalingen:
        such pid = b["id"]
        if b["status"] != "paid" or gezien.contains(pid):
            very overgeslagen = overgeslagen + 1
            continue
        such vv = vreemde_valuta(b["amount"])
        if vv != none:
            weiger(store, "mollie-payment", pid, vv, geweigerd)
            continue
        such post = betaling_naar_post(b)
        if not journaal.tijdvak_open(aangiften, post["datum"]):
            if not journaal.tijdvak_open(aangiften, datum.vandaag()):
                vergrendeld.append(pid)
                continue
            verschuif(post, "betaald")
            verschoven.append(pid)
        journaal.bewaar(store, post)
        gezien.append(pid)
        very geboekt = geboekt + 1
    return {"geboekt": geboekt, "overgeslagen": overgeslagen, "verschoven": verschoven, "vergrendeld": vergrendeld, "geweigerd": geweigerd}
wow

such boek_refund_lijst much store, refunds:
    such gezien = journaal.geboekte_sleutels(store, "mollie_refund_id")
    such aangiften = store.laad("aangiften", [])
    such geboekt = 0
    such overgeslagen = 0
    such verschoven = []
    such vergrendeld = []
    such geweigerd = []
    for r in refunds:
        such rid = r["id"]
        if r["status"] != "refunded" or gezien.contains(rid):
            very overgeslagen = overgeslagen + 1
            continue
        such vv = vreemde_valuta(r["amount"])
        if vv != none:
            weiger(store, "mollie-refund", rid, vv, geweigerd)
            continue
        such post = refund_naar_post(r)
        if not journaal.tijdvak_open(aangiften, post["datum"]):
            if not journaal.tijdvak_open(aangiften, datum.vandaag()):
                vergrendeld.append(rid)
                continue
            verschuif(post, "terugbetaald")
            verschoven.append(rid)
        journaal.bewaar(store, post)
        gezien.append(rid)
        very geboekt = geboekt + 1
    return {"geboekt": geboekt, "overgeslagen": overgeslagen, "verschoven": verschoven, "vergrendeld": vergrendeld, "geweigerd": geweigerd}
wow

# --- Laatste sync (instellingen.dson; alleen weergave, geen filter) ---
such onthoud_sync much store:
    such inst = store.laad("instellingen", {})
    inst["mollie_laatste_sync"] = datum.vandaag()
    store.commit("instellingen", inst, "mollie-sync", "instellingen", "instellingen", inst)
wow

such laatste_sync much store:
    such inst = store.laad("instellingen", {})
    if inst.has("mollie_laatste_sync"):
        return inst["mollie_laatste_sync"]
    return none
wow

# --- Orchestratie (netwerk; door knop + scheduler aangeroepen) ---
such sync much store, key:
    such betalingen = haal_betalingen(key)
    such pres = boek_betalingen(store, betalingen)
    such rres = boek_refund_lijst(store, haal_refunds(key))
    onthoud_sync(store)
    return {"betalingen": pres, "refunds": rres, "verschoven": pres["verschoven"] + rres["verschoven"], "vergrendeld": pres["vergrendeld"] + rres["vergrendeld"], "geweigerd": pres["geweigerd"] + rres["geweigerd"]}
wow
wow
