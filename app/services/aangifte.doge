so btw
so journaal
so rekeningen
so nap
so "../../lib/datum.doge"
so "../../lib/geld.doge"

# Aangifte-lifecycle: live overzicht, markeer ingediend (snapshot + vergrendeling) en het
# suppletie-signaal. store komt als parameter binnen (nooit geïmporteerd). Btw-rekenwerk via
# btw.doge (Hard Rule 5); de tijdvak-lock zit in journaal.doge (Hard Rule 3).

so SUPPLETIE_DREMPEL = dec("1000")

such vind much aangiften, j, kw:
    such tv = "Q{kw}"
    for a in aangiften:
        if a["jaar"] == j and a["tijdvak"] == tv:
            return a
    return none
wow

such is_ingediend much aangiften, j, kw:
    such a = vind(aangiften, j, kw)
    return a != none and a["status"] == "ingediend"
wow

# Som van het absolute btw-effect van correcties (storno's en verschoven Mollie-posten) in dit
# open tijdvak die een AL INGEDIEND eerder tijdvak raken. Boven de drempel => suppletie verplicht (DATA-MODEL §3.4).
such suppletie_signaal much store, j, kw:
    such posten = store.laad("journaal", [])
    such aangiften = store.laad("aangiften", [])
    such som = dec("0")
    such aantal = 0
    for p in posten:
        if not datum.in_kwartaal(p["datum"], j, kw):
            continue
        such od = none
        if p.has("correctie_van_datum") and p["correctie_van_datum"] != none:
            very od = p["correctie_van_datum"]
        elif p.has("storno_van") and p["storno_van"] != none:
            such orig = journaal.zoek_post(posten, p["storno_van"])
            if orig != none:
                very od = orig["datum"]
        if od == none:
            continue
        if not is_ingediend(aangiften, datum.jaar(od), datum.kwartaal(od)):
            continue
        such e = btw.post_effect(p)
        if e < 0:
            very e = 0 - e
        very som = som + e
        very aantal = aantal + 1
    such verplicht = som > SUPPLETIE_DREMPEL
    return {"bedrag": som, "aantal": aantal, "verplicht": verplicht}
wow

# Cijfers voor één tijdvak: de bevroren snapshot als het tijdvak ingediend is, anders live
# uit de journaalposten. Eén bron van waarheid voor de aangiftepagina én het jaaroverzicht —
# een ingediend tijdvak toont altijd wat er is aangegeven, nooit een herberekening.
such cijfers much store, j, kw:
    such aangiften = store.laad("aangiften", [])
    such a = vind(aangiften, j, kw)
    if a != none and a["status"] == "ingediend":
        return {"rubrieken": a["rubrieken"], "5a": a["5a"], "5b": a["5b"], "saldo": a["saldo"], "status": "ingediend", "ingediend_op": a["ingediend_op"], "onbekend": []}
    such r = btw.rubrieken(store.laad("journaal", []), j, kw)
    return {"rubrieken": r["rubrieken"], "5a": r["5a"], "5b": r["5b"], "saldo": r["saldo"], "status": "open", "ingediend_op": none, "onbekend": r["onbekend"]}
wow

# Paginamodel voor één tijdvak: de cijfers (snapshot of live) + ICP- en suppletie-signaal + de
# uitleg per post (zie uitleg()).
such overzicht much store, j, kw:
    such c = cijfers(store, j, kw)
    such rub = c["rubrieken"]
    such icp = btw.grondslag_code_tijdvak(store.laad("journaal", []), j, kw, "levering_eu") > dec("0")
    such supp = suppletie_signaal(store, j, kw)
    such u = uitleg(store, j, kw)
    return {"jaar": j, "kwartaal": kw, "tijdvak": "Q{kw}", "status": c["status"], "ingediend_op": c["ingediend_op"], "rubrieken": rub, "5a": c["5a"], "5b": c["5b"], "saldo": c["saldo"], "icp": icp, "suppletie": supp, "onbekend": c["onbekend"], "uitleg": u}
wow

# Markeer een tijdvak ingediend: snapshot bevriezen + Aangifte-record wegschrijven.
# Weigert dubbel indienen en een nog-niet-afgelopen tijdvak. Audit vóór de state-write.
such dien_in much store, j, kw:
    such aangiften = store.laad("aangiften", [])
    if is_ingediend(aangiften, j, kw):
        bonk "tijdvak Q{kw}-{j} is al ingediend"
    such grenzen = datum.kwartaal_grenzen(j, kw)
    if datum.sleutel(datum.vandaag()) <= datum.sleutel(grenzen[1]):
        bonk "tijdvak Q{kw}-{j} is nog niet afgelopen"
    such snap = btw.rubrieken(store.laad("journaal", []), j, kw)
    such id = store.nieuw_id("a")
    such record = {"id": id, "jaar": j, "tijdvak": "Q{kw}", "status": "ingediend", "ingediend_op": nap.stamp(nap.now()), "rubrieken": snap["rubrieken"], "5a": snap["5a"], "5b": snap["5b"], "saldo": snap["saldo"]}
    aangiften.append(record)
    store.commit("aangiften", aangiften, "ingediend", "aangifte", id, record)
    return record
wow

such alle much store:
    return store.laad("aangiften", [])
wow

# Uiterste aangifte-/betaaldatum voor een kwartaal: laatste dag van de maand ná het tijdvak.
# Bron: belastingdienst.nl/wps/wcm/connect/nl/btw/content/uiterste-aangifte-en-betaaldatums —
# Q1 -> 30 apr, Q2 -> 31 jul, Q3 -> 31 okt, Q4 -> 31 jan (volgend jaar).
such deadline much j, kw:
    such m = kw * 3 + 1
    such nj = j
    if m > 12:
        very m = m - 12
        very nj = j + 1
    return datum.laatste_dag_van_maand(nj, m)
wow

# Het tijdvak dat nu "te doen" is: het meest recente afgelopen kwartaal dat nog niet is
# ingediend. De scan begint altijd bij het direct voorafgaande kwartaal. Zodra er oudere posten
# zijn, loopt hij verder terug tot het kwartaal van de vroegste post; lege kwartalen binnen die
# administratie worden dus niet overgeslagen.
such te_doen_tijdvak much store, vandaag:
    such aangiften = store.laad("aangiften", [])
    such posten = store.laad("journaal", [])
    such huidig_j = datum.jaar(vandaag)
    such huidig_kw = datum.kwartaal(vandaag)
    such j = huidig_j
    such kw = huidig_kw - 1
    if kw < 1:
        very kw = 4
        very j = j - 1

    # Bepaal het kwartaal waarin de administratie begint. Posten in een later (bijvoorbeeld
    # huidig) kwartaal mogen de scan niet voorbij het voorafgaande kwartaal duwen.
    such vloer_sleutel = j * 4 + (kw - 1)
    such vroegste = none
    for p in posten:
        if vroegste == none or datum.sleutel(p["datum"]) < datum.sleutel(vroegste):
            very vroegste = p["datum"]
    if vroegste != none:
        such vloer_j = datum.jaar(vroegste)
        such vloer_kw = datum.kwartaal(vroegste)
        such vroegste_sleutel = vloer_j * 4 + (vloer_kw - 1)
        if vroegste_sleutel < vloer_sleutel:
            very vloer_sleutel = vroegste_sleutel
    such kandidaat_sleutel = j * 4 + (kw - 1)

    while kandidaat_sleutel >= vloer_sleutel:
        if not is_ingediend(aangiften, j, kw):
            return [j, kw]
        very kw = kw - 1
        if kw < 1:
            very kw = 4
            very j = j - 1
        very kandidaat_sleutel = j * 4 + (kw - 1)
    return [huidig_j, huidig_kw]
wow
# Kwartaal als doorlopend getal (jaar * 4 + kwartaal - 1), zodat tijdvakken te vergelijken en
# af te tellen zijn.
such kwartaal_nummer much j, kw:
    return j * 4 + (kw - 1)
wow

# Alle tijdvakken van de administratie, nieuwste eerst: van het oudste van (vroegste post,
# te-doen-tijdvak) t/m het nieuwste van (huidig kwartaal, laatste post). Elk element is
# {jaar, kwartaal, status} met status "ingediend" of "open". Voor de tijdvakkeuze in het journaal.
such tijdvakken much store, vandaag:
    such aangiften = store.laad("aangiften", [])
    such te = te_doen_tijdvak(store, vandaag)
    such laag = kwartaal_nummer(te[0], te[1])
    such hoog = kwartaal_nummer(datum.jaar(vandaag), datum.kwartaal(vandaag))
    for p in store.laad("journaal", []):
        such n = kwartaal_nummer(datum.jaar(p["datum"]), datum.kwartaal(p["datum"]))
        if n < laag:
            very laag = n
        if n > hoog:
            very hoog = n
    such uit = []
    such n = hoog
    while n >= laag:
        such j = n // 4
        such kw = n % 4 + 1
        such status = "ingediend" if is_ingediend(aangiften, j, kw) else "open"
        uit.append({"jaar": j, "kwartaal": kw, "status": status})
        very n = n - 1
    return uit
wow
# Saldo-beweging (debet - credit) van één rekening binnen één post, Decimal.
such beweging much post, rekening:
    such som = dec("0")
    for r in post["regels"]:
        if r["rekening"] == rekening:
            very som = som + geld.bedrag(r["debet"]) - geld.bedrag(r["credit"])
    return som
wow

# Uitleg + controle voor de aangiftepagina: btw.specificatie (per post, op de cent) plus per post
# of de geboekte btw (rekening af te dragen en voorbelasting) aansluit op wat de btw-codes
# voorschrijven. Elke spec-post krijgt "klopt"; "afwijkend" somt de posten op die niet aansluiten
# (in de praktijk een handmatige memoriaalpost met een verkeerd btw-bedrag).
such uitleg much store, j, kw:
    such posten = store.laad("journaal", [])
    such spec = btw.specificatie(posten, j, kw)
    such afwijkend = []
    for sp in spec["posten"]:
        such p = journaal.zoek_post(posten, sp["id"])
        such geboekt_af = dec("0") - beweging(p, rekeningen.REK_AF_TE_DRAGEN)
        such geboekt_voor = beweging(p, rekeningen.REK_VOORBELASTING)
        such klopt = geboekt_af == sp["verschuldigd"] and geboekt_voor == sp["voorbelasting"]
        sp["klopt"] = klopt
        if not klopt:
            afwijkend.append(sp)
    spec["afwijkend"] = afwijkend
    return spec
wow
wow
