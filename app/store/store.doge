so dson
so fetch
so nap
so strings

so IMPORT_MAP = "import"
so OVERGESLAGEN_MAP = "overgeslagen"

# Bedragen komen hier altijd als Str binnen: dson.emit van een Decimal is een TypeError.
many Store:
    such init much data_dir:
        self.dir = data_dir
        fetch.make_dir(data_dir)
    wow

    such pad much naam:
        return fetch.join(self.dir, naam + ".dson")
    wow

    such laad much naam, standaard:
        such p = self.pad(naam)
        if not fetch.exists(p):
            return standaard
        return dson.parse(fetch.read(p))
    wow

    # Eerst .tmp, dan rename: een crash laat nooit een half bestand achter.
    such bewaar much naam, waarde:
        such p = self.pad(naam)
        such tmp = p + ".tmp"
        fetch.write(tmp, dson.emit(waarde))
        fetch.rename(tmp, p)
    wow

    # Geen audit hier: het metadata-record in bijlagen.doge draagt het audit-event.
    such bewaar_bestand much relpad, data:
        such vol = fetch.join(self.dir, relpad)
        such delen = strings.split(relpad, "/")
        such mapdeel = strings.join(delen[0:len(delen) - 1], "/")
        if mapdeel != "":
            fetch.make_dir(fetch.join(self.dir, mapdeel))
        such tmp = vol + ".tmp"
        fetch.write_bytes(tmp, data)
        fetch.rename(tmp, vol)
    wow

    such laad_bestand much relpad:
        return fetch.read_bytes(fetch.join(self.dir, relpad))
    wow

    # Een ontbrekende mount geeft [] i.p.v. een IOError.
    such import_lijst:
        such p = fetch.join(self.dir, IMPORT_MAP)
        if not fetch.exists(p):
            return []
        such namen = []
        for naam in fetch.list(p):
            such st = fetch.stat(fetch.join(p, naam))
            if not st["is_dir"]:
                namen.append(naam)
        return namen
    wow

    # Raakt alleen de transiënte drop-file, nooit een opgeslagen bijlage onder uploads/.
    such import_verwijder much naam:
        such map = fetch.join(self.dir, IMPORT_MAP)
        fetch.delete(fetch.join(map, naam))
    wow

    # Nooit verwijderen (bewaarplicht); geparkeerd zodat een volgende scan hem niet opnieuw meldt.
    such import_overslaan much naam, reden:
        such map = fetch.join(fetch.join(self.dir, IMPORT_MAP), OVERGESLAGEN_MAP)
        fetch.make_dir(map)
        such doelnaam = naam
        such n = 1
        while fetch.exists(fetch.join(map, doelnaam)):
            very doelnaam = "{n}-{naam}"
            very n = n + 1
        such relpad = "{IMPORT_MAP}/{OVERGESLAGEN_MAP}/{doelnaam}"
        self.audit("import-overgeslagen", "importbestand", naam, {"reden": reden, "pad": relpad})
        fetch.rename(fetch.join(fetch.join(self.dir, IMPORT_MAP), naam), fetch.join(map, doelnaam))
        return relpad
    wow

    # Append-only; de caller audit vóór elke bewaar-aanroep (bewaarplicht).
    such audit much actie, entiteit, id, data:
        such regel = dson.emit({"ts": nap.stamp(nap.now()), "actie": actie, "entiteit": entiteit, "id": id, "data": data})
        fetch.append(fetch.join(self.dir, "audit.dsonl"), regel + "\n")
    wow

    such laad_audit:
        such p = fetch.join(self.dir, "audit.dsonl")
        if not fetch.exists(p):
            return ""
        return fetch.read(p)
    wow

    # Append-only. tekst = complete dsonl-regels, elk met een afsluitende newline.
    such audit_aanvullen much tekst:
        fetch.append(fetch.join(self.dir, "audit.dsonl"), tekst)
    wow

    such commit much naam, waarde, actie, entiteit, id, data:
        self.audit(actie, entiteit, id, data)
        self.bewaar(naam, waarde)
    wow

    # Eén write voor de hele batch, met één audit-event per entiteit.
    such commit_alle much naam, waarde, events:
        for e in events:
            self.audit(e["actie"], e["entiteit"], e["id"], e["data"])
        self.bewaar(naam, waarde)
    wow

    # Ids worden nooit hergebruikt.
    such nieuw_id much prefix:
        such tellers = self.laad("tellers", {})
        such n = 1
        if tellers.has(prefix):
            very n = tellers[prefix] + 1
        tellers[prefix] = n
        self.bewaar("tellers", tellers)
        return "{prefix}-{n}"
    wow
wow
wow
