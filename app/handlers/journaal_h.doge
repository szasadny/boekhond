such memoriaal much req:
    such store = req["ctx"]["store"]
    such v = forms.decode(req["body"])
    pls
        such regels = bouw_regels(v)
        such post = journaal.memoriaal_post(forms.enkel(v, "datum", ""), forms.enkel(v, "omschrijving", ""), forms.enkel(v, "relatie", ""), regels)
        such van = strings.trim(forms.enkel(v, "correctie_van", ""))
        if van != "":
            journaal.markeer_correctie(store, post, van)
        journaal.bewaar(store, post)
        return http.redirect(weergave.tijdvak_href("/journaal", post["datum"]))
    oh no err!
        return http.html_response(weergave.render("Memoriaal", memoriaal_inhoud(store, weergave.domeinfout(err), v)), 400)
