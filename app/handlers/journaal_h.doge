# Journaal: lijst per tijdvak + de sjabloonflows (inkoop, bank/privé) en de
# vrije memoriaalpost. Handlers parsen invoer (geld.parse), roepen journaal.doge;
# alle boekingslogica en de balans-invariant zitten daar. Zonder keuze toont de lijst het
# tijdvak dat nu aan de beurt is (aangifte.te_doen_tijdvak), niet blind het huidige kwartaal.

so MEMO_RIJEN = 6

such lijst_van much velden, sleutel:
    if velden.has(sleutel):
        return velden[sleutel]
    return []
wow

such element much lst, i:
    if i < len(lst):
        return lst[i]
    return ""
wow

such rekening_opties much store:
    such o = [["", "(kies rekening)"]]
    for r in rekeningen.alle(store):
        if r["actief"]:
            such nr = r["nummer"]
            such naam = r["naam"]
            o.append([nr, "{nr} {naam}"])
    return o
wow

# Gekozen tijdvak als [j, kw]: ?tv=JJJJ-K uit de keuzelijst, anders ?j=&kw=, anders het
# tijdvak dat aan de beurt is (oudste afgelopen kwartaal dat nog niet is ingediend, of het
# huidige kwartaal als alles is ingediend).
such gekozen_tijdvak much store, query:
    such te = aangifte.te_doen_tijdvak(store, datum.vandaag())
    such j = forms.geheel(query, "j", te[0])
    such kw = forms.geheel(query, "kw", te[1])
    such tv = forms.enkel(query, "tv", "")
    if len(tv) == 6 and tv[4] == "-":
        pls
            very j = int(tv[0:4])
            very kw = int(tv[5:6])
        oh no err!
            very j = te[0]
            very kw = te[1]
    if kw < 1 or kw > 4:
        return te
    return [j, kw]
wow

such tijdvak_keuze much store, j, kw:
    such opties = []
    for t in aangifte.tijdvakken(store, datum.vandaag()):
        such tj = t["jaar"]
        such tkw = t["kwartaal"]
        such label = "Q{tkw}-{tj}"
        if t["status"] == "ingediend":
            very label = label + " (ingediend)"
        opties.append(["{tj}-{tkw}", label])
    such sel = html.select("tv", opties, "{j}-{kw}")
    such kn = html.knop("Toon")
    return "<form action=\"/journaal\" method=\"get\" class=\"inline\"><label>Tijdvak {sel}</label>{kn}</form>"
wow

such lijst much req:
    such store = req["ctx"]["store"]
    such jk = gekozen_tijdvak(store, req["query"])
    such j = jk[0]
    such kw = jk[1]
    such fout = weergave.tijdvak_fout(store, j, kw)
    if fout != none:
        return fout
    such body = ""
    such posten = store.laad("journaal", [])
    such gestorneerd = journaal.storno_index(posten)
    such terugbetaald = journaal.refund_index(posten)
    for p in posten:
        if not datum.in_kwartaal(p["datum"], j, kw):
            continue
        such totaal = dec("0")
        for r in p["regels"]:
            very totaal = totaal + geld.bedrag(r["debet"])
        such d = html.escape(p["datum"])
        such pid = p["id"]
        such oms = html.link("/journaal/{pid}", p["omschrijving"])
        such bron = html.escape(p["bron"])
        such bedrag = html.escape(geld.formatteer(totaal))
        such slink = ""
        if p.has("storno_van") and p["storno_van"] != none:
            such van = p["storno_van"]
            very slink = html.escape("storno van {van}")
        elif gestorneerd.has(pid):
            such door = gestorneerd[pid]
            very slink = html.escape("gestorneerd door {door}")
        elif terugbetaald.has(pid):
            such rid = terugbetaald[pid]
            very slink = html.escape("terugbetaald via {rid}")
        else:
            very slink = html.link("/journaal/storno?id={pid}", "Storneer")
        very body = body + "<tr><td>{d}</td><td>{oms}</td><td>{bron}</td><td class=\"num\">{bedrag}</td><td>{slink}</td></tr>"
    such tabel = "<table><thead><tr><th>Datum</th><th>Omschrijving</th><th>Bron</th><th class=\"num\">Bedrag</th><th>Actie</th></tr></thead><tbody>{body}</tbody></table>"
    such l_ink = html.link("/journaal/inkoop", "Inkoop boeken")
    such l_bank = html.link("/journaal/bank", "Bank/privé boeken")
    such l_memo = html.link("/journaal/memoriaal", "Memoriaalpost")
    such csvhref = "/journaal/export.csv?j={j}&kw={kw}"
    such l_csv = html.link(csvhref, "CSV")
    such acties = "<p>{l_ink} · {l_bank} · {l_memo} · {l_csv}</p>"
    such keuze = tijdvak_keuze(store, j, kw) + weergave.kwartaal_nav(store, "/journaal", j, kw)
    such status = "open"
    if aangifte.is_ingediend(store.laad("aangiften", []), j, kw):
        very status = "ingediend en vergrendeld; correcties boek je als storno in een open tijdvak"
    such inhoud = "<h1>Journaal Q{kw}-{j}</h1>{keuze}<p>Status: {status}.</p>{acties}{tabel}"
    return http.html_response(weergave.render("Journaal", inhoud))
wow

such bedrag_cel much rauw:
    if rauw == "":
        return ""
    return geld.formatteer(geld.bedrag(rauw))
wow

such storno_status much posten, p:
    such pid = p["id"]
    if p.has("storno_van") and p["storno_van"] != none:
        such van = p["storno_van"]
        such l = html.link("/journaal/{van}", van)
        return "Storno van {l}"
    such gestorneerd = journaal.storno_index(posten)
    if gestorneerd.has(pid):
        such door = gestorneerd[pid]
        such l = html.link("/journaal/{door}", door)
        return "Gestorneerd door {l}"
    such terugbetaald = journaal.refund_index(posten)
    if terugbetaald.has(pid):
        such rid = terugbetaald[pid]
        such l = html.link("/journaal/{rid}", rid)
        return "Terugbetaald via {l}"
    return html.link("/journaal/storno?id={pid}", "Storneer")
wow

such detail_inhoud much store, posten, p:
    such pid = html.escape(p["id"])
    such d = html.escape(p["datum"])
    such oms = html.escape(p["omschrijving"])
    such bron = html.escape(p["bron"])
    such meta = "<dt>Datum</dt><dd>{d}</dd><dt>Omschrijving</dt><dd>{oms}</dd><dt>Bron</dt><dd>{bron}</dd>"
    if p.has("relatie") and p["relatie"] != "":
        such rel = html.escape(p["relatie"])
        very meta = meta + "<dt>Relatie</dt><dd>{rel}</dd>"
    if p.has("correctie_van_datum") and p["correctie_van_datum"] != none:
        such cd = html.escape(p["correctie_van_datum"])
        very meta = meta + "<dt>Correctie van</dt><dd>{cd}</dd>"
    such status = storno_status(posten, p)
    very meta = meta + "<dt>Storno</dt><dd>{status}</dd>"
    such rek_lijst = rekeningen.alle(store)
    such rijen = []
    for r in p["regels"]:
        such nr = r["rekening"]
        such rek = rekeningen.zoek(rek_lijst, nr)
        such naam = "" if rek == none else rek["naam"]
        such code = ""
        if r.has("btw_code") and r["btw_code"] != none:
            very code = r["btw_code"]
        rijen.append(["{nr} {naam}", bedrag_cel(r["debet"]), bedrag_cel(r["credit"]), code])
    such tabel = html.tabel(["Rekening", "Debet", "Credit", "Btw-code"], rijen, [1, 2])
    such ids = p["bijlage_ids"] if p.has("bijlage_ids") else []
    such bijl = "<p>Geen bijlagen gekoppeld.</p>"
    if len(ids) > 0:
        such alle = bijlagen.alle(store)
        such items = ""
        for bid in ids:
            such b = bijlagen.zoek(alle, bid)
            such tekst = bid if b == none else b["bestandsnaam_origineel"]
            such l = html.link("/bijlagen/{bid}", tekst)
            very items = items + "<li>{l}</li>"
        very bijl = "<ul>{items}</ul>"
    return "<h1>Journaalpost {pid}</h1><dl>{meta}</dl><h2>Regels</h2>{tabel}<h2>Bijlagen</h2>{bijl}"
wow

such detail much req:
    such store = req["ctx"]["store"]
    such posten = store.laad("journaal", [])
    such p = journaal.zoek_post(posten, req["params"]["id"])
    if p == none:
        return http.tekst_response(404, "journaalpost niet gevonden")
    return http.html_response(weergave.render("Journaalpost", detail_inhoud(store, posten, p)))
