such memoriaal_rij much store, rek = "", deb = "", cred = "", code = "":
    such rk = html.select("regel_rekening", rekening_opties(store), rek)
    such db = "<input name=\"regel_debet\" type=\"text\" inputmode=\"decimal\" value=\"{html.escape(deb)}\">"
    such cr = "<input name=\"regel_credit\" type=\"text\" inputmode=\"decimal\" value=\"{html.escape(cred)}\">"
