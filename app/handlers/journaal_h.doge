    such vbedrag = html.veld("bedrag_ex", "Bedrag excl. btw", "text", forms.enkel(invoer, "bedrag_ex", ""))
    such sbtw = html.select("btw_code", weergave.inkoop_btw_opties(), forms.enkel(invoer, "btw_code", "voorbelasting_hoog"))
    such vbtw = "<label>Btw-code {sbtw}</label>"
