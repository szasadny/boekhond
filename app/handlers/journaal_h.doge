such memoriaal_inhoud much store, melding, invoer = {}:
    such vd = html.veld("datum", "Datum", "date", forms.enkel(invoer, "datum", datum.vandaag()))
    such voms = html.veld("omschrijving", "Omschrijving", "text", forms.enkel(invoer, "omschrijving", ""))
    such vrel = html.veld("relatie", "Relatie", "text", forms.enkel(invoer, "relatie", ""))
    such vcor = html.veld("correctie_van", "Correctie van post (id, optioneel)", "text", forms.enkel(invoer, "correctie_van", ""))
    such reks = lijst_van(invoer, "regel_rekening")
    such debs = lijst_van(invoer, "regel_debet")
    such creds = lijst_van(invoer, "regel_credit")
    such btws = lijst_van(invoer, "regel_btw")
    such rijen = ""
    for i in range(len(reks) if len(reks) > MEMO_RIJEN else MEMO_RIJEN):
        very rijen = rijen + memoriaal_rij(store, element(reks, i), element(debs, i), element(creds, i), element(btws, i))
    such tabel = "<table><thead><tr><th>Rekening</th><th>Debet</th><th>Credit</th><th>Btw-code</th></tr></thead><tbody>{rijen}</tbody></table>"
    such knop = html.knop("Boeken")
    such form = "<form action=\"/journaal/memoriaal\" method=\"post\">{vd}{voms}{vrel}{vcor}{tabel}{knop}</form>"
    such leg = weergave.btw_legenda("alle")
    return "{melding}<h1>Memoriaalpost</h1>{form}{leg}"
