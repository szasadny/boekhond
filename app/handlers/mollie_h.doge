# Mollie-overzicht: laatste sync, reeds geboekte Mollie-posten, en een handmatige
# "sync nu"-knop. De echte sync-logica zit in app/services/mollie.doge.

such mollie_posten much store:
    such uit = []
    for p in store.laad("journaal", []):
        if p["bron"] == "mollie":
            uit.append(p)
    return uit
wow

such overzicht_inhoud much store, cfg, melding:
    such heeft_key = cfg.has("mollie_key") and cfg["mollie_key"] != none
    such ls = mollie.laatste_sync(store)
    such lstxt = "Nog niet gesynct."
    if ls != none:
        such lse = html.escape(ls)
        very lstxt = "Laatste Mollie-sync: {lse}."
    such posten = mollie_posten(store)
    such payment_van = {}
    for p in posten:
        if p.has("mollie_payment_id"):
            payment_van[p["id"]] = p["mollie_payment_id"]
    such rijen = []
    for p in posten:
        such pid = ""
        if p.has("mollie_payment_id"):
            very pid = p["mollie_payment_id"]
        elif p.has("refund_payment_id"):
            very pid = p["refund_payment_id"]
        elif p.has("refund_van") and payment_van.has(p["refund_van"]):
            very pid = payment_van[p["refund_van"]]
        # Een refund staat credit op de bank en verschijnt dus negatief.
        such bank = p["regels"][0]
        such incl = geld.formatteer(geld.bedrag(bank["debet"]) - geld.bedrag(bank["credit"]))
        rijen.append([p["datum"], p["omschrijving"], incl, pid])
    such tabel = html.tabel(["Datum", "Omschrijving", "Bedrag", "Payment"], rijen, [2])
    such afg = mollie.afgehandeld(store)
    if len(afg) > 0:
        such arijen = []
        for a in afg:
            arijen.append([a["datum"], a["soort"], a["id"]])
        such atabel = html.tabel(["Gemarkeerd op", "Soort", "Mollie-id"], arijen)
        very tabel = tabel + "<h2>Met de hand afgehandeld</h2><p>Deze geweigerde items slaat de sync over.</p>{atabel}"
    such actie = ""
    if heeft_key:
        such kn = html.knop("Sync nu")
        very actie = "<form action=\"/mollie/sync\" method=\"post\">{kn}</form>"
    else:
        very actie = "<p class=\"fout\">Geen MOLLIE_API_KEY geconfigureerd (.env).</p>"
    return "{melding}<h1>Inkomsten</h1><p>{lstxt}</p>{actie}{tabel}"
wow

such overzicht much req:
    such store = req["ctx"]["store"]
    such cfg = req["ctx"]["config"]
    return http.html_response(weergave.render("Inkomsten", overzicht_inhoud(store, cfg, "")))
