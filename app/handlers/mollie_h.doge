such afhandel_formulieren much items:
    such uit = "<p>Boek een geweigerd item met de hand en markeer het daarna als afgehandeld.</p><ul>"
    for it in items:
        such soort = html.escape(it["soort"])
        such id = html.escape(it["id"])
        such bedrag = html.escape(it["bedrag"])
        such kn = html.knop("Markeer als afgehandeld")
        very uit = uit + "<li><form action=\"/mollie/afgehandeld\" method=\"post\"><input type=\"hidden\" name=\"soort\" value=\"{soort}\"><input type=\"hidden\" name=\"id\" value=\"{id}\">{id} ({bedrag}) {kn}</form></li>"
    return uit + "</ul>"
