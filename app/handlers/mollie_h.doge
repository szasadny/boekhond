such sync much req:
    such store = req["ctx"]["store"]
    such cfg = req["ctx"]["config"]
    such key = cfg["mollie_key"]
    pls
        if key == none:
            bonk "geen MOLLIE_API_KEY geconfigureerd"
        such res = mollie.sync(store, key)
        such n_geweigerd = len(res["vergrendeld"]) + len(res["geweigerd"]) + len(res["mislukt"])
        such samenvatting = html.escape(weergave.boek_samenvatting(res["geboekt"], n_geweigerd))
        such m = "<p>{samenvatting}</p>"
        if len(res["verschoven"]) > 0:
            such vs = strings.join(res["verschoven"], ", ")
            very m = m + weergave.fout("Eigen tijdvak al ingediend, geboekt in het open tijdvak: {vs}.")
        if len(res["vergrendeld"]) > 0:
            such vg = strings.join(res["vergrendeld"], ", ")
            very m = m + weergave.fout("Niet geboekt, ook het huidige tijdvak is ingediend: {vg}.")
        if len(res["geweigerd"]) > 0:
            such gw = strings.join(res["geweigerd"], ", ")
            very m = m + weergave.fout("Niet geboekt, bedrag niet in EUR: {gw}.") + afhandel_formulieren(res["geweigerd_items"])
        if len(res["mislukt"]) > 0:
            such ml = strings.join(res["mislukt"], ", ")
            very m = m + weergave.fout("Niet geboekt, post geweigerd: {ml}.")
        return http.html_response(weergave.render("Inkomsten", overzicht_inhoud(store, cfg, m)))
    oh no err!
        such m = weergave.domeinfout(err)
        return http.html_response(weergave.render("Inkomsten", overzicht_inhoud(store, cfg, m)), 400)
