such markeer_afgehandeld much req:
    such store = req["ctx"]["store"]
    such cfg = req["ctx"]["config"]
    such v = forms.decode(req["body"])
    pls
        such id = forms.enkel(v, "id", "")
        mollie.markeer_afgehandeld(store, forms.enkel(v, "soort", ""), id)
        such m = "<p>{html.escape(id)} is als afgehandeld gemarkeerd.</p>"
        return http.html_response(weergave.render("Inkomsten", overzicht_inhoud(store, cfg, m)))
    oh no err!
        such m = weergave.domeinfout(err)
        return http.html_response(weergave.render("Inkomsten", overzicht_inhoud(store, cfg, m)), 400)
