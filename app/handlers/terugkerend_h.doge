so "../../web/http.doge"
so "../../web/html.doge"
so "../../web/forms.doge"
so "../services/terugkerend.doge"
so "../services/btw.doge"
so "../services/wisselkoers.doge"
so "../../lib/datum.doge"
so "../../lib/geld.doge"
so weergave

# Kostensjablonen tonen + beheren + de "genereer nu"-knop. Alle dynamische waarden
# ge-escaped (Hard Rule 6); de generator- en boekingslogica zit in de service.

such valuta_opties:
    such o = []
    for v in wisselkoers.VALUTA:
        o.append([v, v])
    return o
wow

# Koersbron voor niet-EUR sjablonen; zonder WISE_API_TOKEN none (de service meldt dat).
such koersbron_van much cfg:
    if cfg.has("wise_token") and cfg["wise_token"] != none:
        return wisselkoers.Wise(cfg["wise_token"])
    return none
wow

such toevoeg_formulier much store, invoer = {}:
    such vlev = html.veld("leverancier", "Leverancier", "text", forms.enkel(invoer, "leverancier", ""))
    such voms = html.veld("omschrijving", "Omschrijving", "text", forms.enkel(invoer, "omschrijving", ""))
    such vbedrag = html.veld("bedrag_ex", "Bedrag excl. btw (in gekozen valuta)", "text", forms.enkel(invoer, "bedrag_ex", ""))
    such sval = html.select("valuta", valuta_opties(), forms.enkel(invoer, "valuta", "EUR"))
    such vval = "<label>Valuta {sval}</label>"
    such srek = html.select("kosten_rek", weergave.kostenrekening_opties(store, true), forms.enkel(invoer, "kosten_rek", ""))
    such vrek = "<label>Kostenrekening {srek}</label>"
    such sbtw = html.select("btw_code", weergave.inkoop_btw_opties(true), forms.enkel(invoer, "btw_code", ""))
    such vbtw = "<label>Btw-code {sbtw}</label>"
    such vdag = html.veld("dag", "Dag van de maand (1-28)", "number", forms.enkel(invoer, "dag", "1"))
    such vvanaf = html.veld("vanaf", "Vanaf (maand)", "month", forms.enkel(invoer, "vanaf", datum.vandaag()[0:7]))
    return html.formulier("/terugkerend", "post", [vlev, voms, vbedrag, vval, vrek, vbtw, vdag, vvanaf, html.knop("Toevoegen")])
wow

such rij much s:
    such lev = html.escape(s["leverancier"])
    such oms = html.escape(s["omschrijving"])
    such val = terugkerend.valuta_van(s)
    such fmt = geld.formatteer(geld.bedrag(s["bedrag_ex"]))
    such bedrag = html.escape("{val} {fmt}")
    such rek = html.escape(s["kosten_rek"])
    such code = html.escape(btw.label(s["btw_code"]))
    such dag = html.escape(s["dag"])
    such vanaf = html.escape(s["vanaf"])
    such id = html.escape(s["id"])
    such actie = ""
    if s["actief"]:
        such knop = html.knop("Deactiveren")
        very actie = "<form action=\"/terugkerend/{id}/deactiveer\" method=\"get\" class=\"inline\">{knop}</form>"
    else:
        such knop2 = html.knop("Activeren")
        very actie = "inactief <form action=\"/terugkerend/{id}/activeer\" method=\"post\" class=\"inline\">{knop2}</form>"
    return "<tr><td>{lev}</td><td>{oms}</td><td class=\"num\">{bedrag}</td><td>{rek}</td><td>{code}</td><td class=\"num\">{dag}</td><td>{vanaf}</td><td>{actie}</td></tr>"
wow

such inhoud_van much store, melding, invoer = {}:
    such body = ""
    for s in terugkerend.alle(store):
        very body = body + rij(s)
    such tabel = "<table><thead><tr><th>Leverancier</th><th>Omschrijving</th><th class=\"num\">Bedrag ex</th><th>Rekening</th><th>Btw-code</th><th class=\"num\">Dag</th><th>Vanaf</th><th>Actie</th></tr></thead><tbody>{body}</tbody></table>"
    such gk = html.knop("Genereer nu")
    such genform = "<form action=\"/terugkerend/genereer\" method=\"post\">{gk}</form>"
    such form = toevoeg_formulier(store, invoer)
    such leg = weergave.btw_legenda("inkoop")
    such hint = "<p>Dollarbedragen worden bij het boeken omgerekend met de actuele Wise-koers. Koers en dollarbedrag worden bij de journaalpost bewaard.</p>"
    return "{melding}<h1>Terugkerende kosten</h1>{tabel}{genform}<h2>Nieuw sjabloon</h2>{hint}{form}{leg}"
wow

such lijst much req:
    such store = req["ctx"]["store"]
    return http.html_response(weergave.render("Kosten", inhoud_van(store, "")))
wow

such toevoegen much req:
    such store = req["ctx"]["store"]
    such v = forms.decode(req["body"])
    pls
        such dag = forms.geheel(v, "dag", none)
        if dag == none:
            bonk "dag van de maand moet een geheel getal tussen 1 en 28 zijn"
        such sjabloon = {"leverancier": forms.enkel(v, "leverancier", ""), "omschrijving": forms.enkel(v, "omschrijving", ""), "kosten_rek": forms.enkel(v, "kosten_rek", ""), "btw_code": forms.enkel(v, "btw_code", ""), "bedrag_ex": weergave.bedrag_str(forms.enkel(v, "bedrag_ex", "")), "valuta": forms.enkel(v, "valuta", "EUR"), "dag": dag, "vanaf": forms.enkel(v, "vanaf", "")}
        terugkerend.voeg_toe(store, sjabloon)
        return http.redirect("/terugkerend")
    oh no err!
        return http.html_response(weergave.render("Kosten", inhoud_van(store, weergave.domeinfout(err), v)), 400)
wow

such bevestig_inhoud much s:
    such id = html.escape(s["id"])
    such lev = html.escape(s["leverancier"])
    such oms = html.escape(s["omschrijving"])
    such vb = "<input type=\"hidden\" name=\"bevestig\" value=\"ja\">"
    such knop = html.knop("Sjabloon deactiveren")
    such terug = html.link("/terugkerend", "Annuleren")
    such form = "<form action=\"/terugkerend/{id}/deactiveer\" method=\"post\">{vb}{knop}</form>"
    return "<h1>Kostensjabloon deactiveren</h1><p>Sjabloon {lev}: {oms} deactiveren? Er worden dan geen nieuwe maandposten meer geboekt. Bestaande posten blijven staan, en je kunt het sjabloon later weer activeren.</p>{form}<p>{terug}</p>"
wow

such deactiveer_bevestig much req:
    such store = req["ctx"]["store"]
    such s = terugkerend.zoek(terugkerend.alle(store), req["params"]["id"])
    if s == none:
        return http.tekst_response(404, "onbekend kostensjabloon")
    return http.html_response(weergave.render("Kosten", bevestig_inhoud(s)))
wow

such deactiveer much req:
    such store = req["ctx"]["store"]
    such id = req["params"]["id"]
    if forms.enkel(forms.decode(req["body"]), "bevestig", "") != "ja":
        return deactiveer_bevestig(req)
    pls
        terugkerend.deactiveer(store, id)
    oh no err!
        return http.html_response(weergave.render("Kosten", inhoud_van(store, weergave.domeinfout(err))), 400)
    return http.redirect("/terugkerend")
wow

such activeer much req:
    such store = req["ctx"]["store"]
    pls
        terugkerend.activeer(store, req["params"]["id"])
    oh no err!
        return http.html_response(weergave.render("Kosten", inhoud_van(store, weergave.domeinfout(err))), 400)
    return http.redirect("/terugkerend")
wow

such genereer much req:
    such store = req["ctx"]["store"]
    such kb = koersbron_van(req["ctx"]["config"])
    pls
        such res = terugkerend.genereer(store, datum.vandaag(), kb)
        such samenvatting = html.escape(weergave.boek_samenvatting(res["geboekt"], len(res["fouten"])))
        such meldingen = "<p>{samenvatting}</p>"
        for f in res["fouten"]:
            very meldingen = meldingen + weergave.fout(f)
        such status = 400 if len(res["fouten"]) > 0 else 200
        return http.html_response(weergave.render("Kosten", inhoud_van(store, meldingen)), status)
    oh no err!
        return http.html_response(weergave.render("Kosten", inhoud_van(store, weergave.domeinfout(err))), 400)
wow
wow
