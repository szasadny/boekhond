so "../../web/http.doge"
so "../../web/html.doge"
so "../../web/forms.doge"
so "../../web/multipart.doge"
so "../services/bijlagen.doge"
so "../services/journaal.doge"
so "../../lib/datum.doge"
so weergave
so strings

# Upload + import-inbox. Bestand komt binnen als multipart/form-data (rauwe Bytes),
# wordt gevalideerd + opgeslagen door de bijlagen-service, en vandaaruit aan een
# journaalpost gekoppeld. Download loopt via een router-route (nooit als /static/,
# want bijlagen liggen buiten de static-root). Alle dynamische waarden ge-escaped (Hard Rule 6).

# Doge's sort neemt alleen all-Int of all-Str, dus datum en index samen in één Int.
so POST_FACTOR = 10000000

such upload_formulier:
    such veld = html.bestand("bestand", "Inkoopbewijs (pdf/png/jpg)", ".pdf,.png,.jpg,.jpeg")
    such form = html.formulier("/upload", "post", [veld, html.knop("Uploaden")], "multipart/form-data")
    return "<h1>Bewijs uploaden</h1>{form}"
wow

such upload_form much req:
    return http.html_response(weergave.render("Uploaden", upload_formulier()))
wow

such upload much req:
    such store = req["ctx"]["store"]
    pls
        if not req["headers"].has("content-type"):
            bonk "geen multipart-upload"
        if len(req["body"]) == 0:
            bonk "geen bestand geüpload"
        such grens = multipart.grens_uit_content_type(req["headers"]["content-type"][0])
        such p = multipart.parse(req["body"], grens)
        if len(p["bestanden"]) == 0:
            bonk "geen bestand geüpload"
        for best in p["bestanden"]:
            bijlagen.bewaar(store, best, "upload")
    oh no err!
        such fh = weergave.fout(err.message) + upload_formulier()
        return http.html_response(weergave.render("Uploaden", fh))
    return http.redirect("/inbox")
wow

# Koppelbare posten als [id, label], nieuwste datum eerst; posten in een ingediend tijdvak
# kunnen geen bijlage meer krijgen en vallen weg.
such post_opties much store:
    such posten = store.laad("journaal", [])
    such aangiften = store.laad("aangiften", [])
    such sleutels = []
    such i = 0
    while i < len(posten):
        if journaal.tijdvak_open(aangiften, posten[i]["datum"]):
            sleutels.append(datum.sleutel(posten[i]["datum"]) * POST_FACTOR + i)
        very i = i + 1
    sleutels.sort()
    such o = []
    for k in sleutels[::-1]:
        such p = posten[k % POST_FACTOR]
        such pd = p["datum"]
        such po = p["omschrijving"]
        o.append([p["id"], "{pd} {po}"])
    return o
wow

# Eén gedeelde datalist voor alle inbox-rijen: typen filtert op id, datum en omschrijving.
such posten_datalist much opties:
    such items = ""
    for o in opties:
        very items = items + "<option value=\"{html.escape(o[0])}\">{html.escape(o[1])}</option>"
    return "<datalist id=\"koppelbare-posten\">{items}</datalist>"
wow

such inbox_rij much b:
    such bid = b["id"]
    such naam = html.escape(b["bestandsnaam_origineel"])
    such link = html.link("/bijlagen/{bid}", naam)
    such keuze = "<input name=\"post_id\" list=\"koppelbare-posten\" required placeholder=\"Zoek op datum of omschrijving\" aria-label=\"Journaalpost\">"
    such hidbid = html.escape(bid)
    such hid = "<input type=\"hidden\" name=\"bijlage_id\" value=\"{hidbid}\">"
    such knop = html.knop("Koppelen")
    such form = "<form action=\"/koppel\" method=\"post\" class=\"inline\">{hid}{keuze}{knop}</form>"
    return "<tr><td>{link}</td><td>{form}</td></tr>"
wow

such inbox_inhoud much store, melding:
    such items = bijlagen.inbox(store)
    such body = ""
    for b in items:
        very body = body + inbox_rij(b)
    such leeg = ""
    if len(items) == 0:
        very leeg = "<p>De inbox is leeg.</p>"
    such tabel = "<table><thead><tr><th>Bestand</th><th>Koppelen aan post</th></tr></thead><tbody>{body}</tbody></table>"
    such up = html.link("/upload", "Bewijs uploaden")
    such scanknop = html.knop("Scan importmap")
    such scan_form = "<form action=\"/inbox/scan\" method=\"post\" class=\"inline\">{scanknop}</form>"
    such lijst = posten_datalist(post_opties(store)) if len(items) > 0 else ""
    return "{melding}<h1>Import-inbox</h1><p>{up} {scan_form}</p>{leeg}{tabel}{lijst}"
wow

# Bouwt een resultaat-melding voor de import-scan; overgeslagen namen/redenen ge-escaped.
such scan_melding much res:
    such n = res["geimporteerd"]
    such over = res["overgeslagen"]
    such k = len(over)
    such m = "{n} geïmporteerd"
    if k > 0:
        such regels = ""
        for o in over:
            such nm = html.escape(o["naam"])
            such rd = html.escape(o["reden"])
            very regels = regels + "<li>{nm}: {rd}</li>"
        very m = m + ", {k} overgeslagen<ul>{regels}</ul>"
    return "<p>{m}</p>"
wow

such scan much req:
    such store = req["ctx"]["store"]
    such melding = ""
    pls
        such res = bijlagen.scan_import(store)
        very melding = scan_melding(res)
    oh no err!
        very melding = weergave.fout(err.message)
    return http.html_response(weergave.render("Inbox", inbox_inhoud(store, melding)))
wow

such inbox much req:
    such store = req["ctx"]["store"]
    return http.html_response(weergave.render("Inbox", inbox_inhoud(store, "")))
wow

such koppel much req:
    such store = req["ctx"]["store"]
    such velden = forms.decode(req["body"])
    such bijlage_id = forms.enkel(velden, "bijlage_id", "")
    such post_id = forms.enkel(velden, "post_id", "")
    pls
        bijlagen.koppel(store, bijlage_id, post_id)
    oh no err!
        return http.html_response(weergave.render("Inbox", inbox_inhoud(store, weergave.fout(err.message))))
    return http.redirect("/inbox")
wow

# Strip tekens die een HTTP-header zouden breken (quote/CR/LF) uit een filename.
such veilige_naam much naam:
    such r = strings.replace(naam, "\"", "")
    very r = strings.replace(r, "\r", "")
    very r = strings.replace(r, "\n", "")
    return r
wow

# Serveer een bijlage terug via de router (nooit als static file).
such download much req:
    such store = req["ctx"]["store"]
    such id = req["params"]["id"]
    such b = bijlagen.zoek(bijlagen.alle(store), id)
    if b == none:
        return http.tekst_response(404, "bijlage niet gevonden")
    such data = store.laad_bestand(b["pad"])
    such naam = veilige_naam(b["bestandsnaam_origineel"])
    such disp = "attachment; filename=\"{naam}\""
    return {"status": 200, "headers": {"Content-Type": b["mime"], "Content-Disposition": disp}, "body": data}
wow
wow
