so "../../web/http.doge"
so "../services/mollie.doge"
so "../services/terugkerend.doge"
so "../services/bijlagen.doge"
so "../services/wisselkoers.doge"
so "../../lib/datum.doge"
so crypto
so strings

# Interne scheduler-endpoint (§5.2): de pack.zoom-pup POSTt hier dagelijks ~06:00. Draait op
# de main-loop, dus deelt wél de store. Guard = INTERN_TOKEN via crypto.same (constant-time)
# plus een loopback-peer-check (howl.peer): de call moet van dezelfde host komen. De drie stappen
# zijn elk idempotent (Hard Rule 2) en lopen elk in pls/oh no zodat één fout de rest niet stopt.
such run_recurring much req:
    such cfg = req["ctx"]["config"]
    such store = req["ctx"]["store"]
    such vanaf = req["peer_host"]
    if vanaf == none or not http.is_loopback(vanaf):
        return http.tekst_response(403, "verboden")
    such verwacht = cfg["intern_token"]
    such kop = req["headers"]
    such gekregen = ""
    if kop.has("x-intern-token"):
        very gekregen = kop["x-intern-token"][0]
    if verwacht == none or not crypto.same(verwacht, gekregen):
        return http.tekst_response(403, "verboden")
    such regels = []
    if cfg["mollie_key"] != none:
        pls
            such mr = mollie.sync(store, cfg["mollie_key"])
            such mt = "mollie ok"
            if len(mr["verschoven"]) > 0:
                very mt = mt + ", verschoven: " + strings.join(mr["verschoven"], ", ")
            if len(mr["vergrendeld"]) > 0:
                very mt = mt + ", vergrendeld: " + strings.join(mr["vergrendeld"], ", ")
            if len(mr["geweigerd"]) > 0:
                very mt = mt + ", geweigerd (geen EUR): " + strings.join(mr["geweigerd"], ", ")
            if len(mr["mislukt"]) > 0:
                very mt = mt + ", mislukt: " + strings.join(mr["mislukt"], ", ")
            regels.append(mt)
        oh no err!
            regels.append("mollie fout: {err.message}")
    pls
        such kb = none
        if cfg.has("wise_token") and cfg["wise_token"] != none:
            very kb = wisselkoers.Wise(cfg["wise_token"])
        such tr = terugkerend.genereer(store, datum.vandaag(), kb)
        such tg = tr["geboekt"]
        regels.append("terugkerend {tg} geboekt")
        for f in tr["fouten"]:
            regels.append("terugkerend fout: {f}")
    oh no err!
        regels.append("terugkerend fout: {err.message}")
    pls
        such sr = bijlagen.scan_import(store)
        such sg = sr["geimporteerd"]
        regels.append("scan {sg} geimporteerd")
    oh no err!
        regels.append("scan fout: {err.message}")
    return http.tekst_response(200, strings.join(regels, "; "))
wow
wow
