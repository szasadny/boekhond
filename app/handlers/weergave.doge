so "../../web/html.doge"
so "../services/btw.doge"
so "../../lib/geld.doge"

# Gedeelde view-helpers voor de handlers: paginaschil met nav + foutmelding.
# Alle dynamische waarden lopen via html.escape/builders (Hard Rule 6).

so LINKS = [["/", "Overzicht"], ["/journaal", "Journaal"], ["/terugkerend", "Kosten"], ["/mollie", "Inkomsten"], ["/aangifte", "Aangifte"], ["/rapporten/balans", "Rapporten"], ["/rekeningen", "Rekeningen"], ["/inbox", "Inbox"], ["/overdracht", "Export/import"]]

# Paginatitel → nav-sectie (href in LINKS), voor de actief-markering. Titels zonder entry
# krijgen geen actieve link (veilige default: printversies, onbekende pagina's).
so SECTIE = {"Overzicht": "/", "Journaal": "/journaal", "Inkoop": "/journaal", "Bank": "/journaal", "Memoriaal": "/journaal", "Storno": "/journaal", "Kosten": "/terugkerend", "Inkomsten": "/mollie", "Aangifte": "/aangifte", "Aangifte doen": "/aangifte", "Aangiften": "/aangifte", "Rekeningen": "/rekeningen", "Uploaden": "/inbox", "Inbox": "/inbox", "Balans": "/rapporten/balans", "Winst en verlies": "/rapporten/balans", "Jaaroverzicht": "/rapporten/balans", "Export en import": "/overdracht"}

such nav much actief:
    such items = ""
    for l in LINKS:
        such kl = "actief" if l[0] == actief else ""
        very items = items + html.link(l[0], l[1], kl) + " "
    return "<nav>{items}</nav>"
wow

# Ingelogde paginaschil (nav + main). titel = tekst; inhoud = builder-output; klasse = code
# (optioneel, bv. "breed"). De actieve nav-link volgt uit SECTIE[titel].
such render much titel, inhoud, klasse = "":
    such actief = ""
    if SECTIE.has(titel):
        very actief = SECTIE[titel]
    return html.layout(titel, nav(actief), inhoud, klasse)
wow

# Rode foutmelding; bericht = tekst (ge-escaped).
such fout much bericht:
    return "<p class=\"fout\">{html.escape(bericht)}</p>"
wow

# Nav-loze schil voor printversies.
such kaal much titel, inhoud:
    such body = "<main>\n{inhoud}\n</main>"
    return html.pagina(titel, body)
wow

# Uitklapbare legenda van de btw-codes voor de invoerformulieren. soort = "inkoop",
# "verkoop" of "alle". Label + uitleg komen uit btw.doge (één bron van waarheid).
such btw_legenda much soort:
    such rijen = []
    for e in btw.legenda(soort):
        rijen.append([e["label"], e["uitleg"]])
    such t = html.tabel(["Btw-code", "Betekenis"], rijen)
    return "<details class=\"legenda\"><summary>Wat betekenen de btw-codes?</summary>{t}</details>"
wow

# Select-opties [code, label] voor de inkoop-btw-codes.
such inkoop_btw_opties:
    such o = []
    for c in btw.CODES:
        if btw.CODES[c]["soort"] == "inkoop":
            o.append([c, btw.label(c)])
    return o
wow

# Select-opties voor alle btw-codes, met een lege "(geen)"-keuze vooraan.
such btw_opties_leeg:
    such o = [["", "(geen)"]]
    for c in btw.CODES:
        o.append([c, btw.label(c)])
    return o
wow

# Bedrag uit een formulierveld ("1.234,56") genormaliseerd naar een Decimal-string; leeg blijft leeg.
such bedrag_str much rauw:
    if rauw == "":
        return ""
    return str(geld.rond2(geld.parse(rauw)))
wow
wow
