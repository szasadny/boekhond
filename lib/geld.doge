so strings
so hunt

# Sanity-grens tegen tikfouten en overflow-achtige invoer; geen fiscale grens.
so MAX_BEDRAG = dec("999999999.99")

# Rekenkundig afronden (half-up, weg van nul) op 2 decimalen. Het resultaat heeft altijd precies
# twee decimalen in de tekstvorm: een product als 20.00 x 0.86215 houdt anders zijn schaal
# ("17.2400000") en dat zou zo als string in de journaalregel belanden.
such rond2 much bedrag:
    such neg = bedrag < 0
    such a = bedrag
    if neg:
        very a = 0 - bedrag
    such centen = a * 100
    such rest = centen % 1
    such hele = int(centen - rest)
    if rest >= dec("0.5"):
        very hele = hele + 1
    such euro = hele // 100
    such cent = hele % 100
    such cc = str(cent)
    if cent < 10:
        very cc = "0" + cc
    such teken = "-" if neg and hele > 0 else ""
    return dec("{teken}{euro}.{cc}")
wow

# Regel-bedrag uit de store naar Decimal: "" of none is de ongebruikte
# debet/credit-kant en telt als nul. Houdt Decimal↔Str op één plek (Hard Rule 1).
such bedrag much s:
    if s == "" or s == none:
        return dec("0")
    return dec(s)
wow

# Accepteert NL-invoer zoals "1.234,56", "19,99", "1234.56" en "€ 12,50".
such parse much tekst:
    such t = strings.trim(tekst)
    if t == "":
        bonk "bedrag ontbreekt"
    very t = strings.replace(t, "€", "")
    very t = strings.replace(t, " ", "")
    if strings.contains(t, ","):
        very t = strings.replace(t, ".", "")
        very t = strings.replace(t, ",", ".")
    elif hunt.test("^-?[0-9]\{1,3\}(\\.[0-9]\{3\})+$", t):
        bonk "ambigu bedrag (gebruik een komma voor centen): {tekst}"
    if not hunt.test("^-?[0-9]+(\\.[0-9]+)?$", t):
        bonk "ongeldig bedrag: {tekst}"
    if hunt.test("\\.[0-9]\{3,\}$", t):
        bonk "bedrag heeft meer dan twee decimalen: {tekst}"
    such b = dec(t)
    if not binnen_grens(b):
        bonk "bedrag te groot (maximaal {formatteer(MAX_BEDRAG)}): {tekst}"
    return b
wow

such binnen_grens much bedrag:
    return bedrag <= MAX_BEDRAG and bedrag >= 0 - MAX_BEDRAG
wow

# Canonieke Decimal-string uit de services of de store ("1234.50"), geen NL-invoer.
such waarde much s:
    if s == none or strings.trim(s) == "":
        bonk "bedrag ontbreekt"
    if not hunt.test("^-?[0-9]+(\\.[0-9]+)?$", s):
        bonk "ongeldig bedrag: {s}"
    return dec(s)
wow

# Geeft altijd twee decimalen met duizendtallen terug, bv. "1.234,50".
such formatteer much bedrag:
    such b = rond2(bedrag)
    such neg = b < 0
    if neg:
        very b = 0 - b
    such centen_totaal = int(b * 100)
    such euros = str(centen_totaal // 100)
    such centen = str(centen_totaal % 100)
    if len(centen) < 2:
        very centen = "0" + centen
    such met_punten = ""
    such n = len(euros)
    such i = 0
    while i < n:
        if i > 0 and (n - i) % 3 == 0:
            very met_punten = met_punten + "."
        very met_punten = met_punten + euros[i]
        i += 1
    such teken = "-" if neg else ""
    return "{teken}{met_punten},{centen}"
wow
wow
