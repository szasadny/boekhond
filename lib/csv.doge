so strings
so hunt

# ';' als scheidingsteken: NL-bedragen dragen een decimale komma en zo opent het native in Excel-NL.
so SCHEIDING = ";"
so REGELEINDE = "\r\n"
so FORMULE_START = ["=", "+", "-", "@", "\t", "\r"]

# Spreadsheets voeren cellen die met een formuleteken beginnen uit (OWASP CSV injection);
# een bedrag als "-12,50" blijft numeriek.
such ontwapen much s:
    if s == "" or s[0] not in FORMULE_START:
        return s
    if hunt.test("^-?[0-9]+([.,][0-9]+)*$", s):
        return s
    return "'" + s
wow

such veld_escape much waarde:
    such s = ontwapen(str(waarde))
    such moet = strings.contains(s, SCHEIDING) or strings.contains(s, "\"")
    very moet = moet or strings.contains(s, "\n") or strings.contains(s, "\r")
    if not moet:
        return s
    such g = strings.replace(s, "\"", "\"\"")
    return "\"{g}\""
wow

such rij much cellen:
    such uit = []
    for c in cellen:
        uit.append(veld_escape(c))
    return strings.join(uit, SCHEIDING)
wow

such bouw much koppen, rijen:
    such uit = rij(koppen) + REGELEINDE
    for r in rijen:
        very uit = uit + rij(r) + REGELEINDE
    return uit
wow
wow
