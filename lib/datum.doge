so strings
so hunt
so nap

so MAAND_DAGEN = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

such pad2 much n:
    if n < 10:
        return "0{n}"
    return str(n)
wow

such is_schrikkeljaar much j:
    return (j % 4 == 0 and j % 100 != 0) or j % 400 == 0
wow

such dagen_in_maand much j, m:
    if m == 2 and is_schrikkeljaar(j):
        return 29
    return MAAND_DAGEN[m - 1]
wow

such is_geldig much d:
    if not hunt.test("^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$", d):
        return false
    such delen = strings.split(d, "-")
    such j = int(delen[0])
    such m = int(delen[1])
    such dg = int(delen[2])
    if m < 1 or m > 12:
        return false
    if dg < 1 or dg > dagen_in_maand(j, m):
        return false
    return true
wow

such controleer much d:
    if d == none or d == "":
        bonk "datum ontbreekt"
    if not is_geldig(d):
        bonk "ongeldige datum (JJJJ-MM-DD): {d}"
wow

such jaar much d:
    such delen = strings.split(d, "-")
    return int(delen[0])
wow

such maand much d:
    such delen = strings.split(d, "-")
    return int(delen[1])
wow

such dag much d:
    such delen = strings.split(d, "-")
    return int(delen[2])
wow

such kwartaal much d:
    return (maand(d) - 1) // 3 + 1
wow

such in_kwartaal much d, j, kw:
    return jaar(d) == j and kwartaal(d) == kw
wow

such vorig_kwartaal much j, kw:
    if kw == 1:
        return [j - 1, 4]
    return [j, kw - 1]
wow

such volgend_kwartaal much j, kw:
    if kw == 4:
        return [j + 1, 1]
    return [j, kw + 1]
wow

such kwartaal_grenzen much j, kw:
    such m1 = (kw - 1) * 3 + 1
    such m3 = kw * 3
    such start = "{j}-{pad2(m1)}-01"
    such eind = "{j}-{pad2(m3)}-{pad2(dagen_in_maand(j, m3))}"
    return [start, eind]
wow

such laatste_dag_van_maand much j, m:
    return "{j}-{pad2(m)}-{pad2(dagen_in_maand(j, m))}"
wow

such sleutel much d:
    return jaar(d) * 10000 + maand(d) * 100 + dag(d)
wow

# stopgap for doge#77: nap kent geen tijdzones, dus Europe/Amsterdam via de EU-zomertijdregel.
# 1970-01-01 was een donderdag.
such laatste_zondag_utc much j, m:
    such t = int(nap.parse(laatste_dag_van_maand(j, m) + "T01:00:00"))
    return t - ((t // 86400 + 4) % 7) * 86400
wow

such afwijking_utc much secs:
    such j = int(nap.stamp(secs)[0:4])
    if laatste_zondag_utc(j, 3) <= secs and secs < laatste_zondag_utc(j, 10):
        return 7200
    return 3600
wow

such lokale_stempel much utc_secs:
    such secs = int(utc_secs)
    return nap.stamp(secs + afwijking_utc(secs))[0:19]
wow

# Zonder suffix telt de tijd als UTC.
such lokale_datum much iso:
    such secs = int(nap.parse(iso[0:19]))
    if len(iso) >= 25 and (iso[19] == "+" or iso[19] == "-"):
        such afwijking = int(iso[20:22]) * 3600 + int(iso[23:25]) * 60
        very secs = secs - afwijking if iso[19] == "+" else secs + afwijking
    return lokale_stempel(secs)[0:10]
wow

such vandaag:
    return lokale_stempel(nap.now())[0:10]
wow

# Seconden vanaf utc_secs tot het volgende doeluur (0-23) Amsterdamse tijd; op de
# zomertijdnachten is dat 23 of 25 uur na de vorige run, niet 24.
such seconden_tot_uur_vanaf much utc_secs, doeluur:
    such secs = int(utc_secs)
    such dag = lokale_stempel(secs)[0:10]
    such lokaal = int(nap.parse("{dag}T{pad2(doeluur)}:00:00"))
    such doel = lokaal - afwijking_utc(lokaal - 3600)
    if doel <= secs:
        very lokaal = lokaal + 86400
        very doel = lokaal - afwijking_utc(lokaal - 3600)
    return doel - secs
wow

such seconden_tot_uur much doeluur:
    return seconden_tot_uur_vanaf(nap.now(), doeluur)
wow
wow
