so strings
so hunt
so nap

so MAAND_DAGEN = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

such pad2 much n:
    if n < 10:
        return "0{n}"
    return str(n)
wow

such is_schrikkeljaar much j:
    return (j % 4 == 0 and j % 100 != 0) or j % 400 == 0
wow

such dagen_in_maand much j, m:
    if m == 2 and is_schrikkeljaar(j):
        return 29
    return MAAND_DAGEN[m - 1]
wow

such is_geldig much d:
    if not hunt.test("^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$", d):
        return false
    such delen = strings.split(d, "-")
    such j = int(delen[0])
    such m = int(delen[1])
    such dg = int(delen[2])
    if m < 1 or m > 12:
        return false
    if dg < 1 or dg > dagen_in_maand(j, m):
        return false
    return true
wow

such jaar much d:
    such delen = strings.split(d, "-")
    return int(delen[0])
wow

such maand much d:
    such delen = strings.split(d, "-")
    return int(delen[1])
wow

such dag much d:
    such delen = strings.split(d, "-")
    return int(delen[2])
wow

such kwartaal much d:
    return (maand(d) - 1) // 3 + 1
wow

such in_kwartaal much d, j, kw:
    return jaar(d) == j and kwartaal(d) == kw
wow

such kwartaal_grenzen much j, kw:
    such m1 = (kw - 1) * 3 + 1
    such m3 = kw * 3
    such start = "{j}-{pad2(m1)}-01"
    such eind = "{j}-{pad2(m3)}-{pad2(dagen_in_maand(j, m3))}"
    return [start, eind]
wow

# Laatste dag van maand m in jaar j als "YYYY-MM-DD" (schrikkel-aware).
such laatste_dag_van_maand much j, m:
    return "{j}-{pad2(m)}-{pad2(dagen_in_maand(j, m))}"
wow

# Int-sleutel voor chronologisch vergelijken/sorteren van datums.
such sleutel much d:
    return jaar(d) * 10000 + maand(d) * 100 + dag(d)
wow

# stopgap for doge#TBD: nap kent geen tijdzones, dus Europe/Amsterdam via de EU-zomertijdregel.
# 1970-01-01 was een donderdag.
such laatste_zondag_utc much j, m:
    such t = int(nap.parse(laatste_dag_van_maand(j, m) + "T01:00:00"))
    return t - ((t // 86400 + 4) % 7) * 86400
wow

such lokale_stempel much utc_secs:
    such secs = int(utc_secs)
    such j = int(nap.stamp(secs)[0:4])
    such afwijking = 3600
    if laatste_zondag_utc(j, 3) <= secs and secs < laatste_zondag_utc(j, 10):
        very afwijking = 7200
    return nap.stamp(secs + afwijking)[0:19]
wow

# Zonder suffix telt de tijd als UTC.
such lokale_datum much iso:
    such secs = int(nap.parse(iso[0:19]))
    if len(iso) >= 25 and (iso[19] == "+" or iso[19] == "-"):
        such afwijking = int(iso[20:22]) * 3600 + int(iso[23:25]) * 60
        very secs = secs - afwijking if iso[19] == "+" else secs + afwijking
    return lokale_stempel(secs)[0:10]
wow

such vandaag:
    return lokale_stempel(nap.now())[0:10]
wow

# Seconden tot het volgende voorkomen van doeluur (0-23) vanaf een ISO-stempel
# ("YYYY-MM-DDTHH:MM:SS", lokale tijd). Pure variant zodat de scheduler-timing testbaar is
# zonder de klok. Is het doeluur vandaag al geweest, dan telt hij door naar morgen.
such seconden_tot_uur_vanaf much stempel, doeluur:
    such uur = int(stempel[11:13])
    such minuut = int(stempel[14:16])
    such sec = int(stempel[17:19])
    such delta = doeluur * 3600 - (uur * 3600 + minuut * 60 + sec)
    if delta <= 0:
        very delta = delta + 86400
    return delta
wow

such seconden_tot_uur much doeluur:
    return seconden_tot_uur_vanaf(lokale_stempel(nap.now()), doeluur)
wow
wow
