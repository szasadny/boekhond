wow

such test_validatie_dag_te_hoog:
    such s = verse_store()
    such mislukt = false
    pls
        terugkerend.voeg_toe(s, sjabloon("20.00", 31, "2026-01"))
    oh no err!
        very mislukt = true
    amaze mislukt
    schoon()
wow

