    such res = terugkerend.genereer(s, "2026-07-01", none)
    amaze res["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_inactief_overgeslagen:
    such s = verse_store()
    such sj = terugkerend.voeg_toe(s, sjabloon("20.00", 1, "2026-01"))
    terugkerend.deactiveer(s, sj["id"])
    such res = terugkerend.genereer(s, "2026-07-15", none)
    amaze res["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

