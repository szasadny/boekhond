    such res = terugkerend.genereer(s, "2026-07-15", none)
    amaze res["geboekt"] == 0
    amaze len(res["fouten"]) == 1
    amaze len(s.laad("journaal", [])) == 0
    such opnieuw = terugkerend.genereer(s, "2026-07-16", VasteKoers())
    amaze opnieuw["geboekt"] == 1
    amaze len(s.laad("journaal", [])) == 1
    schoon()
wow

such test_koersfout_slaat_alleen_dat_sjabloon_over:
    such s = verse_store()
    terugkerend.voeg_toe(s, usd_sjabloon("20.00", "API"))
    terugkerend.voeg_toe(s, sjabloon("10.00", 1, "2026-01"))
    such res = terugkerend.genereer(s, "2026-07-15", KapotteKoers())
    amaze res["geboekt"] == 1
    amaze len(res["fouten"]) == 1
    such posten = s.laad("journaal", [])
    amaze len(posten) == 1
    amaze posten[0]["regels"][0]["debet"] == "10.00"
    schoon()
wow

