such test_usd_omgerekend_met_koers:
    such s = verse_store()
    terugkerend.voeg_toe(s, usd_sjabloon("20.00", "API"))
    such res = terugkerend.genereer(s, "2026-07-15", VasteKoers())
    amaze res["geboekt"] == 1
    amaze len(res["fouten"]) == 0
    such posten = s.laad("journaal", [])
    amaze len(posten) == 1
    such p = posten[0]
    amaze p["regels"][0]["debet"] == "17.24"
    amaze journaal.balans_klopt(p["regels"])
    amaze p["valuta"] == "USD"
    amaze p["bedrag_valuta"] == "20.00"
    amaze p["koers"] == "0.86215"
    amaze p["koers_tijd"] == "2026-07-15T06:00:00+0000"
    amaze p["koers_bron"] == "test"
    such r = btw.rubrieken(posten, 2026, 3)
    amaze r["rubrieken"]["4a"]["bedrag"] == 17
    amaze r["rubrieken"]["4a"]["btw"] == 3
    such twee = terugkerend.genereer(s, "2026-07-20", VasteKoers())
    amaze twee["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 1
    schoon()
wow

such test_eur_post_zonder_koersvelden:
    such s = verse_store()
    terugkerend.voeg_toe(s, sjabloon("20.00", 1, "2026-01"))
    terugkerend.genereer(s, "2026-07-15", VasteKoers())
    such p = s.laad("journaal", [])[0]
    amaze not p.has("valuta")
    amaze not p.has("koers")
    amaze p["regels"][0]["debet"] == "20.00"
    schoon()
wow

