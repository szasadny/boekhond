so strings
so fetch
so "../app/handlers/weergave.doge"
so "../app/handlers/dashboard_h.doge"
so "../app/store/store.doge"
so "../lib/datum.doge"

so TMPMAP = "tmp_test_weergave"

such test_btw_legenda_inkoop:
    such h = weergave.btw_legenda("inkoop")
    amaze strings.contains(h, "<details class=\"legenda\">")
    amaze strings.contains(h, "Inkoop buiten EU (btw verlegd)")
    amaze strings.contains(h, "Btw verlegd naar jou")
    amaze not strings.contains(h, "Omzet 21%")
wow

such test_btw_legenda_alle:
    such h = weergave.btw_legenda("alle")
    amaze strings.contains(h, "Omzet 21%")
    amaze strings.contains(h, "Geen btw")
wow

such test_nav_actief:
    such n = weergave.nav("/journaal")
    amaze strings.contains(n, "<a href=\"/journaal\" class=\"actief\">Journaal</a>")
    amaze strings.contains(n, "<a href=\"/mollie\">Inkomsten</a>")
wow

such test_tijdvak_fout:
    such s = store.Store(TMPMAP)
    such j = datum.jaar(datum.vandaag())
    amaze weergave.tijdvak_fout(s, j, 1) == none
    amaze weergave.tijdvak_fout(s, j, 7)["status"] == 400
    amaze weergave.tijdvak_fout(s, j + 2, 1)["status"] == 400
    amaze weergave.tijdvak_fout(s, j - 2, 1)["status"] == 400
    if fetch.exists(TMPMAP):
        fetch.remove_dir(TMPMAP)
wow
such test_domeinfout_alleen_bonk:
    such html = ""
    pls
        bonk "rekening is inactief: 4000"
    oh no err!
        very html = weergave.domeinfout(err)
    amaze html == "<p class=\"fout\">rekening is inactief: 4000</p>"
    such doorgegeven = ""
    pls
        pls
            int("")
        oh no err!
            weergave.domeinfout(err)
    oh no err2!
        very doorgegeven = err2.type
    amaze doorgegeven == "ValueError"
wow

such test_tijdvak_href:
    amaze weergave.tijdvak_href("/journaal", "2025-12-31") == "/journaal?j=2025&kw=4"
    amaze weergave.tijdvak_href("/aangifte/doen", "2026-04-01") == "/aangifte/doen?j=2026&kw=2"
wow

such test_kwartaal_nav_over_jaargrens_en_bereik:
    if fetch.exists(TMPMAP):
        fetch.remove_dir(TMPMAP)
    such s = store.Store(TMPMAP)
    such j = datum.jaar(datum.vandaag())
    such midden = weergave.kwartaal_nav(s, "/journaal", j, 1)
    amaze strings.contains(midden, "<a href=\"/journaal?j={j - 1}&amp;kw=4\">← Q4-{j - 1}</a>")
    amaze strings.contains(midden, "<a href=\"/journaal?j={j}&amp;kw=2\">Q2-{j} →</a>")
    such onder = weergave.kwartaal_nav(s, "/aangifte", j - 1, 1)
    amaze not strings.contains(onder, "←")
    amaze strings.contains(onder, "/aangifte?j={j - 1}&amp;kw=2")
    such boven = weergave.kwartaal_nav(s, "/aangifte", j + 1, 4)
    amaze not strings.contains(boven, "→")
    amaze strings.contains(boven, "/aangifte?j={j + 1}&amp;kw=3")
    if fetch.exists(TMPMAP):
        fetch.remove_dir(TMPMAP)
wow

# Deadline Q1-2026 is 2026-04-30: die dag zelf nog op tijd, een ingediend tijdvak nooit verstreken.
such test_termijn_status:
    such gevallen = [["open", "2026-04-30", false], ["open", "2026-05-01", true], ["ingediend", "2026-05-01", false]]
    for g in gevallen:
        such uit = weergave.termijn_status(g[0], 2026, 1, g[1])
        amaze strings.contains(uit, "Termijn verstreken.") == g[2]
wow

such test_openstaand_banner_termijn:
    such laat = dashboard_h.openstaand_banner([{"jaar": 2026, "kwartaal": 1, "deadline": "2026-04-30", "te_laat": true}])
    amaze strings.contains(laat, "<p class=\"banner te-laat\">")
    amaze strings.contains(laat, weergave.termijn_markering(true))
    such optijd = dashboard_h.openstaand_banner([{"jaar": 2026, "kwartaal": 2, "deadline": "2026-07-31", "te_laat": false}])
    amaze strings.contains(optijd, "<p class=\"banner\">")
    amaze not strings.contains(optijd, "Termijn verstreken.")
wow

# Op datum, nieuwste eerst; gelijke datum: laatst ingevoegd eerst.
such test_nieuwste_eerst:
    such posten = [{"id": "a", "datum": "2026-03-01"}, {"id": "b", "datum": "2026-05-02"}, {"id": "c", "datum": "2025-12-31"}, {"id": "e", "datum": "2026-05-02"}]
    such ids = []
    for p in weergave.nieuwste_eerst(posten):
        ids.append(p["id"])
    amaze ids == ["e", "b", "a", "c"]
    amaze len(weergave.nieuwste_eerst([])) == 0
wow

# Na vandaag valt weg; daarna de eerste n van nieuwste_eerst.
such test_recente_posten:
    such posten = [{"id": "a", "datum": "2026-03-01"}, {"id": "b", "datum": "2026-05-02"}, {"id": "c", "datum": "2026-12-31"}, {"id": "d", "datum": "2026-01-15"}, {"id": "e", "datum": "2026-05-02"}, {"id": "f", "datum": "2026-04-30"}]
    such ids = []
    for p in dashboard_h.recente_posten(posten, "2026-05-02", 4):
        ids.append(p["id"])
    amaze ids == ["e", "b", "f", "a"]
    amaze len(dashboard_h.recente_posten(posten, "2026-01-01", 5)) == 0
    amaze len(dashboard_h.recente_posten([], "2026-01-01", 5)) == 0
wow
wow
