so howl
so pack
so strings
so "../web/http.doge"

so CRLF = "\r\n"

# Stuurt een rauwe request over loopback en geeft de geparste request terug.
such rond much req_txt:
    such server = howl.listen("127.0.0.1", 0)
    such poort = howl.port(server)
    such client = howl.connect("127.0.0.1", poort)
    howl.send(client, req_txt)
    such conn = howl.accept(server)
    such req = http.parse_request(conn)
    howl.close(conn)
    howl.close(client)
    howl.close(server)
    return req
wow

such rond_bytes much raw:
    such server = howl.listen("127.0.0.1", 0)
    such client = howl.connect("127.0.0.1", howl.port(server))
    howl.send_bytes(client, raw)
    such conn = howl.accept(server)
    such req = http.parse_request(conn)
    howl.close(conn)
    howl.close(client)
    howl.close(server)
    return req
wow

such afgewezen_status much req:
    return req["afgewezen"]["status"]
wow

such test_parse_post_body:
    such req = rond("POST /p?x=1&y=2 HTTP/1.1{CRLF}Host: local{CRLF}Content-Type: application/x-www-form-urlencoded{CRLF}Content-Length: 3{CRLF}{CRLF}abc")
    amaze req["method"] == "POST"
    amaze req["path"] == "/p"
    amaze req["query"]["x"][0] == "1"
    amaze req["query"]["y"][0] == "2"
    amaze req["body"] == "abc"
wow

such test_parse_body_byte_accuraat:
    # "€" is 1 char maar 3 bytes; Content-Length telt bytes.
    such req = rond("POST /p HTTP/1.1{CRLF}Content-Type: application/x-www-form-urlencoded{CRLF}Content-Length: 3{CRLF}{CRLF}€")
    amaze req["body"] == "€"
wow

such test_parse_cookies:
    such req = rond("GET / HTTP/1.1{CRLF}Cookie: sid=abc123; theme=dark{CRLF}{CRLF}")
    amaze req["cookies"]["sid"] == "abc123"
    amaze req["cookies"]["theme"] == "dark"
wow

such test_parse_headers_lowercased:
    such req = rond("GET / HTTP/1.1{CRLF}Host: Localhost:8085{CRLF}{CRLF}")
    amaze req["headers"]["host"][0] == "Localhost:8085"
wow

such test_bouw_response_content_length_is_bytes:
    such raw = http.bouw_response(http.html_response("€"))
    such txt = raw.decode()
    amaze strings.contains(txt, "HTTP/1.1 200 OK")
    amaze strings.contains(txt, "Content-Length: 3")
    amaze strings.contains(txt, "Content-Type: text/html")
wow

such test_veiligheidskoppen_op_elke_response:
    for resp in [http.html_response("x"), http.redirect("/"), http.csv_response("a.csv", "x"), {"status": 200, "headers": {"Content-Type": "image/png"}, "body": bytes("")}]:
        such txt = http.bouw_response(resp).decode()
        amaze strings.contains(txt, "Content-Security-Policy: default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'{CRLF}")
        amaze strings.contains(txt, "X-Frame-Options: DENY{CRLF}")
        amaze strings.contains(txt, "X-Content-Type-Options: nosniff{CRLF}")
        amaze strings.contains(txt, "Referrer-Policy: same-origin{CRLF}")
wow

such test_csp_staat_geen_inline_toe:
    amaze not strings.contains(http.CSP, "unsafe")
    amaze not strings.contains(http.CSP, "*")
wow

such test_redirect:
    such txt = http.bouw_response(http.redirect("/inbox")).decode()
    amaze strings.contains(txt, "303 See Other")
    amaze strings.contains(txt, "Location: /inbox")
    amaze strings.contains(txt, "Content-Length: 0")
wow

such test_tekst_response:
    such txt = http.bouw_response(http.tekst_response(404, "weg")).decode()
    amaze strings.contains(txt, "404 Not Found")
    amaze strings.contains(txt, "Content-Type: text/plain")
    amaze strings.contains(txt, "{CRLF}{CRLF}weg")
wow

such test_is_loopback:
    amaze http.is_loopback("127.0.0.1")
    amaze http.is_loopback("::1")
    amaze http.is_loopback("localhost")
    amaze not http.is_loopback("10.0.0.5")
    amaze not http.is_loopback("192.168.1.9")
    amaze not http.is_loopback("example.com")
wow

such test_peer_host_loopback:
    such server = howl.listen("127.0.0.1", 0)
    such poort = howl.port(server)
    such client = howl.connect("127.0.0.1", poort)
    such conn = howl.accept(server)
    such host = http.peer_host(conn)
    howl.close(conn)
    howl.close(client)
    howl.close(server)
    amaze http.is_loopback(host)
wow

such test_header_crlf_gestript:
    such resp = {"status": 303, "headers": {"Location": "/ok\r\nSet-Cookie: evil=1"}, "body": ""}
    such txt = http.bouw_response(resp).decode()
    amaze strings.contains(txt, "Location: /okSet-Cookie: evil=1")
    amaze not strings.contains(txt, "/ok\r\nSet-Cookie")
wow

such test_oversize_body_geweigerd:
    such req = rond("POST /p HTTP/1.1{CRLF}Content-Length: 99999999{CRLF}{CRLF}")
    amaze afgewezen_status(req) == 413
wow

such test_niet_utf8_tekstbody_geeft_400:
    such kop = "POST /p HTTP/1.1{CRLF}Content-Type: application/x-www-form-urlencoded{CRLF}Content-Length: 3{CRLF}{CRLF}"
    such req = rond_bytes(bytes(kop) + bytes("a=") + "ff".from_hex())
    amaze afgewezen_status(req) == 400
wow

such test_niet_utf8_header_geeft_400:
    such req = rond_bytes(bytes("GET / HTTP/1.1{CRLF}X-Kapot: ") + "ff".from_hex() + bytes("{CRLF}{CRLF}"))
    amaze afgewezen_status(req) == 400
wow

such test_niet_utf8_request_line_geeft_400:
    such req = rond_bytes(bytes("GET /") + "ff".from_hex() + bytes(" HTTP/1.1{CRLF}{CRLF}"))
    amaze afgewezen_status(req) == 400
wow

such test_chunked_body_geweigerd:
    such req = rond("POST /p HTTP/1.1{CRLF}Transfer-Encoding: chunked{CRLF}{CRLF}3{CRLF}abc{CRLF}0{CRLF}{CRLF}")
    amaze afgewezen_status(req) == 411
wow

such test_headers_boven_cap_geven_431:
    such lang = "a" * http.MAX_KOPPEN
    such req = rond("GET / HTTP/1.1{CRLF}X-Lang: {lang}{CRLF}{CRLF}")
    amaze afgewezen_status(req) == 431
wow

such test_headers_onder_cap_toegestaan:
    such lang = "a" * (http.MAX_KOPPEN - 20)
    such req = rond("GET / HTTP/1.1{CRLF}X-Lang: {lang}{CRLF}{CRLF}")
    amaze not req.has("afgewezen")
    amaze len(req["headers"]["x-lang"][0]) == http.MAX_KOPPEN - 20
wow

# "X-Lang: " + n bytes + CRLF telt n + 10 bytes.
such test_headers_precies_op_cap:
    such req = rond("GET / HTTP/1.1{CRLF}X-Lang: {"a" * (http.MAX_KOPPEN - 10)}{CRLF}{CRLF}")
    amaze not req.has("afgewezen")
    such te_lang = rond("GET / HTTP/1.1{CRLF}X-Lang: {"a" * (http.MAX_KOPPEN - 9)}{CRLF}{CRLF}")
    amaze afgewezen_status(te_lang) == 431
wow

# "€" is 3 bytes: 5458 keer is 16374 + 10 bytes, precies op de cap.
such test_headers_cap_telt_bytes:
    such req = rond("GET / HTTP/1.1{CRLF}X-Lang: {"€" * 5458}{CRLF}{CRLF}")
    amaze not req.has("afgewezen")
    such te_lang = rond("GET / HTTP/1.1{CRLF}X-Lang: {"€" * 5459}{CRLF}{CRLF}")
    amaze afgewezen_status(te_lang) == 431
wow

# Zonder regeleinde en met de client nog open zou een onbegrensde regel-read blijven wachten.
such test_header_zonder_regeleinde_stopt_bij_cap:
    such req = rond("GET / HTTP/1.1{CRLF}X-Lang: {"a" * (2 * http.MAX_KOPPEN)}")
    amaze afgewezen_status(req) == 431
wow

such test_request_line_boven_cap_geeft_431:
    such req = rond("GET /{"a" * (2 * http.MAX_KOPPEN)}")
    amaze afgewezen_status(req) == 431
wow

such test_regel_met_alleen_lf:
    such req = rond("GET /x HTTP/1.1\nHost: local\n\n")
    amaze req["path"] == "/x"
    amaze req["headers"]["host"][0] == "local"
wow

such test_head_response_zonder_body:
    such txt = http.bouw_response(http.html_response("€"), true).decode()
    amaze strings.contains(txt, "Content-Length: 3{CRLF}")
    amaze txt[-4:] == "{CRLF}{CRLF}"
    amaze not strings.contains(txt, "€")
wow

such test_serveer_trage_client_blokkeert_niet:
    such server = howl.listen("127.0.0.1", 0)
    such poort = howl.port(server)
    such verzoeken = pack.bowl()
    pack.zoom(http.serveer, [server, verzoeken])
    such idle = howl.connect("127.0.0.1", poort)
    such traag = howl.connect("127.0.0.1", poort)
    howl.send(traag, "POST /p HTTP/1.1{CRLF}Content-Length: 10{CRLF}{CRLF}abc")
    such client = howl.connect("127.0.0.1", poort)
    howl.send(client, "GET /health HTTP/1.1{CRLF}{CRLF}")
    such item = pack.sniff(verzoeken)
    amaze item[0]["path"] == "/health"
    amaze item[0]["peer_host"] == "127.0.0.1"
    pack.drop(item[1], http.bouw_response(http.tekst_response(200, "ok")))
    such antwoord = howl.recv_line(client)
    amaze strings.contains(antwoord, "200 OK")
    howl.close(client)
    howl.close(traag)
    howl.close(idle)
wow

# Client-timeout ruim boven die van de server: een regressie faalt in plaats van te blijven hangen.
such gesloten_zonder_antwoord much client:
    howl.set_timeout(client, 3)
    such data = howl.recv_bytes(client, 1)
    howl.close(client)
    return data == none
wow

such stille_verbinding much verzend:
    such server = howl.listen("127.0.0.1", 0)
    such client = howl.connect("127.0.0.1", howl.port(server))
    such conn = howl.accept(server)
    pack.zoom(http.verbinding, [conn, pack.bowl(), {}, 0.3])
    howl.send(client, verzend)
    such gesloten = gesloten_zonder_antwoord(client)
    howl.close(server)
    return gesloten
wow

such test_serveer_sluit_stille_client_na_timeout:
    such server = howl.listen("127.0.0.1", 0)
    such poort = howl.port(server)
    pack.zoom(http.serveer, [server, pack.bowl(), {}, 0.3])
    amaze gesloten_zonder_antwoord(howl.connect("127.0.0.1", poort))
wow

such test_halve_header_gesloten_na_timeout:
    amaze stille_verbinding("GET / HTTP/1.1{CRLF}Host: loc")
wow

such test_halve_body_gesloten_na_timeout:
    amaze stille_verbinding("POST /p HTTP/1.1{CRLF}Content-Length: 10{CRLF}{CRLF}abc")
wow
wow
