so nap
so "../lib/datum.doge"

such test_geldigheid:
    amaze datum.is_geldig("2026-07-15")
    amaze datum.is_geldig("2024-02-29")
    amaze not datum.is_geldig("2023-02-29")
    amaze not datum.is_geldig("2026-13-01")
    amaze not datum.is_geldig("2026-00-10")
    amaze not datum.is_geldig("2026-04-31")
    amaze not datum.is_geldig("15-07-2026")
    amaze not datum.is_geldig("2026-7-15")
    amaze not datum.is_geldig("")
wow

such test_onderdelen:
    amaze datum.jaar("2026-07-15") == 2026
    amaze datum.maand("2026-07-15") == 7
    amaze datum.dag("2026-07-15") == 15
    amaze datum.kwartaal("2026-01-31") == 1
    amaze datum.kwartaal("2026-03-31") == 1
    amaze datum.kwartaal("2026-04-01") == 2
    amaze datum.kwartaal("2026-07-15") == 3
    amaze datum.kwartaal("2026-12-31") == 4
wow

such test_kwartaal_grenzen:
    such g1 = datum.kwartaal_grenzen(2026, 1)
    amaze g1[0] == "2026-01-01"
    amaze g1[1] == "2026-03-31"
    such g2 = datum.kwartaal_grenzen(2026, 2)
    amaze g2[1] == "2026-06-30"
    such g4 = datum.kwartaal_grenzen(2026, 4)
    amaze g4[0] == "2026-10-01"
    amaze g4[1] == "2026-12-31"
wow

such test_in_kwartaal:
    amaze datum.in_kwartaal("2026-07-15", 2026, 3)
    amaze not datum.in_kwartaal("2026-07-15", 2026, 2)
    amaze not datum.in_kwartaal("2025-07-15", 2026, 3)
wow

such test_vorig_en_volgend_kwartaal:
    amaze datum.vorig_kwartaal(2026, 3) == [2026, 2]
    amaze datum.vorig_kwartaal(2026, 1) == [2025, 4]
    amaze datum.volgend_kwartaal(2026, 3) == [2026, 4]
    amaze datum.volgend_kwartaal(2026, 4) == [2027, 1]
wow

such test_sleutel_chronologisch:
    amaze datum.sleutel("2026-07-15") > datum.sleutel("2026-07-14")
    amaze datum.sleutel("2026-01-01") > datum.sleutel("2025-12-31")
wow

such test_vandaag_vorm:
    amaze datum.is_geldig(datum.vandaag())
wow

# Zomertijd 2026: 29 maart en 25 oktober, 01:00 UTC. 06:00 lokaal is 05:00 UTC in de winter, 04:00 UTC in de zomer.
such test_seconden_tot_uur:
    such gevallen = [["2026-07-18T03:00:00", 3600], ["2026-07-18T04:00:00", 86400], ["2026-07-18T05:30:00", 81000], ["2026-07-17T22:00:00", 21600], ["2026-01-10T04:30:00", 1800], ["2026-01-10T05:00:00", 86400], ["2026-03-28T06:00:00", 79200], ["2026-03-29T00:30:00", 12600], ["2026-03-29T04:00:00", 86400], ["2026-10-24T05:00:00", 86400], ["2026-10-25T00:30:00", 16200], ["2026-10-25T05:00:00", 86400]]
    for g in gevallen:
        amaze datum.seconden_tot_uur_vanaf(nap.parse(g[0]), 6) == g[1], g[0]
wow

such test_laatste_dag_van_maand:
    amaze datum.laatste_dag_van_maand(2026, 4) == "2026-04-30"
    amaze datum.laatste_dag_van_maand(2026, 7) == "2026-07-31"
    amaze datum.laatste_dag_van_maand(2026, 2) == "2026-02-28"
    amaze datum.laatste_dag_van_maand(2024, 2) == "2024-02-29"
    amaze datum.laatste_dag_van_maand(2026, 12) == "2026-12-31"
    amaze datum.laatste_dag_van_maand(2027, 1) == "2027-01-31"
wow

# Zomertijd 2026: 29 maart 01:00 UTC t/m 25 oktober 01:00 UTC; in 2027 valt 31 oktober zelf op zondag.
such test_lokale_stempel_zomertijdgrenzen:
    such gevallen = [["2026-03-29T00:59:59", "2026-03-29T01:59:59"], ["2026-03-29T01:00:00", "2026-03-29T03:00:00"], ["2026-10-25T00:59:59", "2026-10-25T02:59:59"], ["2026-10-25T01:00:00", "2026-10-25T02:00:00"], ["2027-10-31T00:59:59", "2027-10-31T02:59:59"], ["2027-10-31T01:00:00", "2027-10-31T02:00:00"]]
    for g in gevallen:
        amaze datum.lokale_stempel(nap.parse(g[0])) == g[1], g[0]
wow

such test_lokale_datum:
    such gevallen = [["2026-12-31T23:30:00Z", "2027-01-01"], ["2026-12-31T22:59:59Z", "2026-12-31"], ["2026-07-15T22:30:00Z", "2026-07-16"], ["2026-07-15T21:59:59Z", "2026-07-15"], ["2026-03-28T22:30:00Z", "2026-03-28"], ["2026-03-29T22:30:00Z", "2026-03-30"], ["2026-10-24T22:30:00Z", "2026-10-25"], ["2026-10-25T22:30:00Z", "2026-10-25"], ["2026-12-31T23:30:00+00:00", "2027-01-01"], ["2027-01-01T00:30:00+01:00", "2027-01-01"], ["2026-12-31T20:30:00-03:00", "2027-01-01"], ["2026-06-30T22:00:00", "2026-07-01"]]
    for g in gevallen:
        amaze datum.lokale_datum(g[0]) == g[1], g[0]
wow
such datum_melding much d:
    pls
        datum.controleer(d)
    oh no err!
        return err.message
    return ""
wow

such test_controleer:
    amaze datum_melding("2026-07-15") == ""
    amaze datum_melding("2024-02-29") == ""
    amaze datum_melding("") == "datum ontbreekt"
    amaze datum_melding("abc") == "ongeldige datum (JJJJ-MM-DD): abc"
    amaze datum_melding("2026-02-30") == "ongeldige datum (JJJJ-MM-DD): 2026-02-30"
    amaze datum_melding("2026-13-01") == "ongeldige datum (JJJJ-MM-DD): 2026-13-01"
wow

wow
