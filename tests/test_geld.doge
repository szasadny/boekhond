so "../lib/geld.doge"

such test_parse:
    amaze geld.parse("1.234,56") == dec("1234.56")
    amaze geld.parse("19,99") == dec("19.99")
    amaze geld.parse("1234.56") == dec("1234.56")
    amaze geld.parse(" € 12,50 ") == dec("12.50")
    amaze geld.parse("-250") == dec("-250")
    amaze geld.parse("0") == dec("0")
wow

such test_parse_fout:
    such gevangen = false
    pls
        geld.parse("abc")
    oh no err!
        very gevangen = true
    amaze gevangen
wow

such test_rond2:
    amaze geld.rond2(dec("0.125")) == dec("0.13")
    amaze geld.rond2(dec("0.124")) == dec("0.12")
    amaze geld.rond2(dec("-0.125")) == dec("-0.13")
    amaze geld.rond2(dec("209.9979")) == dec("210")
    amaze geld.rond2(dec("10")) == dec("10")
    amaze geld.rond2(dec("2.205")) == dec("2.21")
wow

such test_formatteer:
    amaze geld.formatteer(dec("1234.5")) == "1.234,50"
    amaze geld.formatteer(dec("0.05")) == "0,05"
    amaze geld.formatteer(dec("-1234567.891")) == "-1.234.567,89"
    amaze geld.formatteer(dec("12")) == "12,00"
    amaze geld.formatteer(dec("1000000")) == "1.000.000,00"
wow

such test_rondgang:
    amaze geld.parse(geld.formatteer(dec("8135.79"))) == dec("8135.79")
wow

such test_bedrag:
    amaze geld.bedrag("") == dec("0")
    amaze geld.bedrag(none) == dec("0")
    amaze geld.bedrag("1250.00") == dec("1250.00")
    amaze geld.bedrag("-1000") == dec("-1000")
wow

such test_parse_ambigu_geweigerd:
    such gevangen = false
    pls
        geld.parse("1.500")
    oh no err!
        very gevangen = true
    amaze gevangen
    amaze geld.parse("1500") == dec("1500")
wow
# Nul toont Doge altijd als "0", ongeacht de schaal.
such test_rond2_tekstvorm:
    such gevallen = [["17.2400000", "17.24"], ["8.6255", "8.63"], ["-8.6255", "-8.63"], ["0.005", "0.01"], ["3", "3.00"], ["0.1", "0.10"], ["-0.001", "0"], ["20.00", "20.00"]]
    for g in gevallen:
        amaze str(geld.rond2(dec(g[0]))) == g[1], g[0]
wow
such melding_van much f, invoer:
    pls
        f(invoer)
    oh no err!
        return err.message
    return ""
wow

such test_parse_meldingen:
    amaze melding_van(geld.parse, "") == "bedrag ontbreekt"
    amaze melding_van(geld.parse, "  ") == "bedrag ontbreekt"
    amaze melding_van(geld.parse, "abc") == "ongeldig bedrag: abc"
wow

such test_waarde:
    amaze geld.waarde("1234.50") == dec("1234.50")
    amaze geld.waarde("-20") == dec("-20")
    amaze melding_van(geld.waarde, "") == "bedrag ontbreekt"
    amaze melding_van(geld.waarde, "12,50") == "ongeldig bedrag: 12,50"
    amaze melding_van(geld.waarde, "abc") == "ongeldig bedrag: abc"
wow

such test_rond2_opslagvorm:
    such gevallen = [["8.264462809917355371900826446280991735537190082644628099173553719008264462809917355371900826446280992", "8.26"], ["259.2600", "259.26"], ["2.1", "2.10"], ["10", "10.00"], ["1234.567", "1234.57"], ["999999999.99", "999999999.99"]]
    for g in gevallen:
        amaze str(geld.rond2(dec(g[0]))) == g[1], g[0]
    amaze str(geld.rond2(dec("10.00") * 100 / 121)) == "8.26"
    amaze str(geld.rond2(dec("313.70") * 100 / 121)) == "259.26"
wow

such test_parse_weigert_meer_dan_twee_decimalen:
    amaze melding_van(geld.parse, "12,345") == "bedrag heeft meer dan twee decimalen: 12,345"
    amaze melding_van(geld.parse, "1234.567") == "bedrag heeft meer dan twee decimalen: 1234.567"
    amaze melding_van(geld.parse, "0,001") == "bedrag heeft meer dan twee decimalen: 0,001"
    amaze geld.parse("12,3") == dec("12.30")
    amaze geld.parse("12,35") == dec("12.35")
wow

such test_parse_bovengrens:
    amaze geld.parse("999.999.999,99") == dec("999999999.99")
    amaze geld.parse("-999.999.999,99") == dec("-999999999.99")
    amaze melding_van(geld.parse, "1.000.000.000,00") == "bedrag te groot (maximaal 999.999.999,99): 1.000.000.000,00"
    amaze melding_van(geld.parse, "-1000000000") == "bedrag te groot (maximaal 999.999.999,99): -1000000000"
    amaze melding_van(geld.parse, "99999999999999999999999,99") == "bedrag te groot (maximaal 999.999.999,99): 99999999999999999999999,99"
wow

wow
