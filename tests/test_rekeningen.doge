wow

such test_deactiveer:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    rekeningen.deactiveer(s, "8100")
    amaze rekeningen.zoek(rekeningen.alle(s), "8100")["actief"] == false
    such gevangen = false
    pls
        rekeningen.deactiveer(s, "0000")
    oh no err!
        very gevangen = true
    amaze gevangen
    schoon()
wow

such test_deactiveer_systeemrekening_geweigerd:
    for nummer in ["0900", "1100", "1510", "1520", "1600", "8000", "8900"]:
        schoon()
        such s = store.Store(TMPMAP)
        rekeningen.seed(s)
        such melding = ""
        pls
            rekeningen.deactiveer(s, nummer)
        oh no err!
            very melding = err.message
        amaze melding == "rekening {nummer} kan niet gedeactiveerd worden: de app boekt hier zelf op", nummer
        amaze rekeningen.zoek(rekeningen.alle(s), nummer)["actief"], nummer
    schoon()
wow

such test_voeg_toe_weigert_type_en_leeg_nummer:
    such gevallen = [
        [{"nummer": "4700", "naam": "Raar", "type": "hacker", "btw_code": none}, "onbekend rekeningtype: hacker"],
        [{"nummer": "4700", "naam": "Raar", "type": "", "btw_code": none}, "onbekend rekeningtype: "],
        [{"nummer": "", "naam": "Leeg", "type": "kosten", "btw_code": none}, "rekeningnummer is verplicht"],
        [{"nummer": "   ", "naam": "Leeg", "type": "kosten", "btw_code": none}, "rekeningnummer is verplicht"],
        [{"nummer": "49/00", "naam": "Pad", "type": "kosten", "btw_code": none}, "rekeningnummer mag alleen cijfers bevatten"],
        [{"nummer": "4a00", "naam": "Letter", "type": "kosten", "btw_code": none}, "rekeningnummer mag alleen cijfers bevatten"],
        [{"nummer": "4700", "naam": "", "type": "kosten", "btw_code": none}, "rekeningnaam is verplicht"],
        [{"nummer": "4700", "naam": "  ", "type": "kosten", "btw_code": none}, "rekeningnaam is verplicht"],
    ]
    for g in gevallen:
        schoon()
        such s = store.Store(TMPMAP)
        rekeningen.seed(s)
        such melding = ""
        pls
            rekeningen.voeg_toe(s, g[0])
        oh no err!
            very melding = err.message
        amaze melding == g[1], g[1]
        amaze len(rekeningen.alle(s)) == len(rekeningen.STANDAARD)
    schoon()
wow

such test_voeg_toe_trimt_nummer_en_naam:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    rekeningen.voeg_toe(s, {"nummer": " 4900 ", "naam": " Reiskosten ", "type": "kosten", "btw_code": none})
    such r = rekeningen.zoek(rekeningen.alle(s), "4900")
    amaze r != none
    amaze r["naam"] == "Reiskosten"
    schoon()
wow

such test_toevoegen_handler_fout_geeft_400_en_houdt_invoer:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    such req = {"ctx": {"store": s}, "params": {}, "body": "nummer=49%2F00&naam=Reiskosten&type=kosten&btw_code="}
    such resp = rekeningen_h.toevoegen(req)
    amaze resp["status"] == 400
    such body = str(resp["body"])
    amaze strings.contains(body, "rekeningnummer mag alleen cijfers bevatten")
    amaze strings.contains(body, "value=\"49/00\"")
    amaze strings.contains(body, "value=\"Reiskosten\"")
    amaze len(rekeningen.alle(s)) == len(rekeningen.STANDAARD)
    schoon()
wow

such test_deactiveer_activeer_roundtrip_met_audit:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    rekeningen.deactiveer(s, "4200")
    amaze rekeningen.zoek(rekeningen.alle(s), "4200")["actief"] == false
    rekeningen.activeer(s, "4200")
    amaze rekeningen.zoek(rekeningen.alle(s), "4200")["actief"] == true
    such audit = s.laad_audit()
    amaze strings.contains(audit, "gedeactiveerd")
    amaze strings.contains(audit, "geactiveerd")
    schoon()
wow

such test_activeer_onbekende_rekening_weigert:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    such gevangen = false
    pls
        rekeningen.activeer(s, "9999")
    oh no err!
        very gevangen = true
    amaze gevangen
    schoon()
wow

such test_deactiveer_handler_vraagt_bevestiging:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    such req = {"ctx": {"store": s}, "params": {"nummer": "4200"}, "body": ""}
    such resp = rekeningen_h.deactiveer(req)
    amaze resp["status"] == 200
    amaze rekeningen.zoek(rekeningen.alle(s), "4200")["actief"] == true
    req["body"] = "bevestig=ja"
    amaze rekeningen_h.deactiveer(req)["status"] == 303
    amaze rekeningen.zoek(rekeningen.alle(s), "4200")["actief"] == false
    amaze rekeningen_h.activeer(req)["status"] == 303
    amaze rekeningen.zoek(rekeningen.alle(s), "4200")["actief"] == true
    schoon()
wow

such test_rij_systeemrekening_zonder_deactiveerknop:
    such bank = rekeningen.zoek(rekeningen.STANDAARD, "1100")
    amaze not strings.contains(rekeningen_h.rij(bank), "deactiveer")
    such kantoor = rekeningen.zoek(rekeningen.STANDAARD, "4200")
    amaze strings.contains(rekeningen_h.rij(kantoor), "deactiveer")
wow

such test_voeg_toe_laat_invoer_ongemoeid:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    such invoer = {"nummer": " 4600 ", "naam": " Reiskosten ", "type": "kosten", "btw_code": none}
    such r = rekeningen.voeg_toe(s, invoer)
    amaze r["nummer"] == "4600" and r["naam"] == "Reiskosten"
    amaze invoer["nummer"] == " 4600 " and invoer["naam"] == " Reiskosten "
    amaze not invoer.has("actief")
    schoon()
wow

such test_type_opties_volgen_types:
    such opties = rekeningen_h.type_opties()
    amaze len(opties) == len(rekeningen.TYPES)
    for i in range(len(opties)):
        amaze opties[i] == [rekeningen.TYPES[i], rekeningen.TYPES[i]]
wow
wow
