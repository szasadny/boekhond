    such rp = post_met(s, "mollie_refund_id", "re_1")
    amaze storno_fout(s, rp["id"]) == "post {rp["id"]} is een Mollie-refund en kan niet gestorneerd worden"
    amaze len(s.laad("journaal", [])) == 2
    schoon()
wow

such test_refund_van_nul_overgeslagen:
