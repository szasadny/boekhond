so KAPOTTE_PAGINAS = {"leeg": {"count": 0}, "ander_soort": {"_embedded": {"refunds": []}}, "tekst": {"_embedded": "x"}, "lijst": []}

such nep_kapot much key, url:
    return KAPOTTE_PAGINAS[url]
wow

such test_haal_alle_zonder_embedded_bonkt:
    for url in KAPOTTE_PAGINAS:
        such fout = ""
        pls
            mollie.haal_alle(nep_kapot, "k", url, "payments")
        oh no err!
            very fout = err.message
        amaze fout == "ongeldig antwoord van Mollie"
wow

such test_volgende_url_onverwachte_vorm:
    amaze mollie.volgende_url({"_links": {"next": "p2"}}) == none
    amaze mollie.volgende_url({"_links": []}) == none
wow

such test_kapotte_payment_blokkeert_batch_niet:
    such s = verse_store()
    such zonder_amount = betaling("tr_a", "12.10")
    zonder_amount.remove("amount")
    such kapot_bedrag = betaling("tr_b", "abc")
    such zonder_paid_at = betaling("tr_c", "12.10")
    zonder_paid_at["paidAt"] = none
    such zonder_oms = betaling("tr_d", "12.10")
    zonder_oms.remove("description")
    such zonder_id = betaling("tr_e", "12.10")
    zonder_id.remove("id")
    such lijst = [zonder_amount, kapot_bedrag, zonder_paid_at, zonder_oms, zonder_id, "geen object", betaling("tr_1", "12.10")]
    such res = mollie.boek_betalingen(s, lijst)
    amaze res["geboekt"] == 1
    amaze res["mislukt"] == ["tr_a (ongeldig antwoord van Mollie: amount ontbreekt of is ongeldig)", "tr_b (ongeldig antwoord van Mollie: amount ontbreekt of is ongeldig)", "tr_c (ongeldig antwoord van Mollie: paidAt ontbreekt of is ongeldig)", "tr_d (ongeldig antwoord van Mollie: description ontbreekt of is ongeldig)", "? (ongeldig antwoord van Mollie: id of status ontbreekt)", "? (ongeldig antwoord van Mollie: id of status ontbreekt)"]
    amaze len(audit_regels("mollie-mislukt")) == 6
    amaze len(s.laad("journaal", [])) == 1
    schoon()
wow

such test_kapotte_refund_blokkeert_batch_niet:
