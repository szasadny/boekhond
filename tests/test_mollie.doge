so fetch
so strings
so "../app/store/store.doge"
so "../app/services/mollie.doge"
so "../app/services/journaal.doge"
so "../app/services/rekeningen.doge"
so "../app/services/btw.doge"
so "../app/services/aangifte.doge"
so "../lib/datum.doge"

so TMPMAP = "tmp_test_mollie"

such schoon:
    if fetch.exists(TMPMAP):
        fetch.remove_dir(TMPMAP)
wow

such verse_store:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    return s
wow

# Sample betaalde payment (incl 12,10 -> ex 10,00 + btw 2,10).
such betaling much id, waarde:
    return {"id": id, "status": "paid", "amount": {"value": waarde, "currency": "EUR"}, "paidAt": "2026-07-15T10:00:00+00:00", "description": "SaaS abonnement", "amountRefunded": {"value": "0.00", "currency": "EUR"}}
wow

such test_betaling_naar_post_balanceert:
    such p = mollie.betaling_naar_post(betaling("tr_1", "12.10"))
    amaze p["bron"] == "mollie"
    amaze p["mollie_payment_id"] == "tr_1"
    amaze p["datum"] == "2026-07-15"
    amaze journaal.balans_klopt(p["regels"])
    amaze dec(p["regels"][0]["debet"]) == dec("12.10")
    amaze dec(p["regels"][1]["credit"]) == dec("10.00")
    amaze dec(p["regels"][2]["credit"]) == dec("2.10")
    amaze p["regels"][1]["btw_code"] == "hoog_21"
wow

such test_boeking_rubriek_1a:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze r["rubrieken"]["1a"]["bedrag"] == 10
    amaze r["rubrieken"]["1a"]["btw"] == 2
    amaze r["saldo"] == 2
    schoon()
wow

such test_idempotent:
    such s = verse_store()
    such lijst = [betaling("tr_1", "12.10"), betaling("tr_2", "24.20")]
    such een = mollie.boek_betalingen(s, lijst)
    amaze een["geboekt"] == 2
    such twee = mollie.boek_betalingen(s, lijst)
    amaze twee["geboekt"] == 0
    amaze twee["overgeslagen"] == 2
    amaze len(s.laad("journaal", [])) == 2
    schoon()
wow

such test_niet_betaald_overgeslagen:
    such s = verse_store()
    such open = {"id": "tr_9", "status": "open", "amount": {"value": "5.00", "currency": "EUR"}, "paidAt": none, "description": "x", "amountRefunded": {"value": "0.00", "currency": "EUR"}}
    such res = mollie.boek_betalingen(s, [open])
    amaze res["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_refund_draait_1a_terug:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    such refund = {"id": "re_1", "status": "refunded", "amount": {"value": "12.10", "currency": "EUR"}, "createdAt": "2026-07-20T10:00:00+00:00"}
    journaal.bewaar(s, mollie.refund_naar_post(refund))
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze r["rubrieken"]["1a"]["bedrag"] == 0
    amaze r["rubrieken"]["1a"]["btw"] == 0
    schoon()
wow

such refund_sample much id:
    return {"id": id, "status": "refunded", "amount": {"value": "12.10", "currency": "EUR"}, "createdAt": "2026-07-20T10:00:00+00:00"}
wow

such test_afdracht_matcht_aangifte:
    such p = mollie.betaling_naar_post(betaling("tr_x", "100.00"))
    amaze journaal.balans_klopt(p["regels"])
    such ex = dec(p["regels"][1]["credit"])
    such vat = dec(p["regels"][2]["credit"])
    amaze vat == btw.btw_bedrag(ex, "hoog_21")
    amaze len(p["regels"]) == 4
wow

such test_refund_idempotent:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    such lijst = [refund_sample("re_1")]
    such een = mollie.boek_refund_lijst(s, lijst)
    amaze een["geboekt"] == 1
    such twee = mollie.boek_refund_lijst(s, lijst)
    amaze twee["geboekt"] == 0
    amaze twee["overgeslagen"] == 1
    schoon()
wow
# Mollie laat amountRefunded weg bij betalingen zonder (mogelijke) refund; geen KeyError en geen API-call.
such test_zonder_amount_refunded:
    such s = verse_store()
    such b = betaling("tr_1", "12.10")
    b.remove("amountRefunded")
    amaze mollie.terugbetaald(b) == dec("0")
    mollie.boek_betalingen(s, [b])
    such res = mollie.boek_refunds(s, "geen-key", [b])
    amaze res["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 1
    schoon()
wow

such test_terugbetaald_bedrag:
    such b = betaling("tr_1", "12.10")
    b["amountRefunded"] = {"value": "2.50", "currency": "EUR"}
    amaze mollie.terugbetaald(b) == dec("2.50")
wow

such betaling_op much id, paid_at:
    such b = betaling(id, "12.10")
    b["paidAt"] = paid_at
    return b
wow

such boekingen_per_id much s:
    such uit = {}
    for p in s.laad("journaal", []):
        such k = p["mollie_payment_id"] if p.has("mollie_payment_id") else p["mollie_refund_id"]
        uit[k] = p
    return uit
wow

such test_ingediend_tijdvak_boekt_in_open_tijdvak:
    such s = verse_store()
    s.bewaar("aangiften", [{"jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}])
    such lijst = [betaling_op("tr_11", "2026-10-22T10:00:00+00:00"), betaling_op("tr_10", "2026-09-30T21:30:00+00:00"), betaling_op("tr_12", "2026-10-01T10:00:00+00:00")]
    such res = mollie.boek_betalingen(s, lijst)
    amaze res["geboekt"] == 3
    amaze res["verschoven"] == ["tr_10"]
    amaze res["vergrendeld"] == []
    such refund = {"id": "re_9", "status": "refunded", "amount": {"value": "12.10", "currency": "EUR"}, "createdAt": "2026-10-23T10:00:00+00:00"}
    such oud = {"id": "re_8", "status": "refunded", "amount": {"value": "12.10", "currency": "EUR"}, "createdAt": "2026-09-20T10:00:00+00:00"}
    such rres = mollie.boek_refund_lijst(s, [refund, oud])
    amaze rres["geboekt"] == 2
    amaze rres["verschoven"] == ["re_8"]
    such per = boekingen_per_id(s)
    amaze len(per) == 5
    amaze per["tr_10"]["datum"] == datum.vandaag()
    amaze per["tr_10"]["correctie_van_datum"] == "2026-09-30"
    amaze per["tr_10"]["omschrijving"] == "SaaS abonnement (betaald 2026-09-30, tijdvak Q3-2026 ingediend)"
    amaze per["re_8"]["datum"] == datum.vandaag()
    amaze per["tr_12"]["datum"] == "2026-10-01"
    such vd = datum.vandaag()
    amaze aangifte.suppletie_signaal(s, datum.jaar(vd), datum.kwartaal(vd))["aantal"] == 2
    such opnieuw = mollie.boek_betalingen(s, lijst)
    amaze opnieuw["geboekt"] == 0
    amaze opnieuw["verschoven"] == []
    amaze mollie.boek_refund_lijst(s, [refund, oud])["verschoven"] == []
    schoon()
wow

such test_vandaag_ook_ingediend_slaat_over:
    such s = verse_store()
    such vd = datum.vandaag()
    such tv = "Q{datum.kwartaal(vd)}"
    s.bewaar("aangiften", [{"jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}, {"jaar": datum.jaar(vd), "tijdvak": tv, "status": "ingediend"}])
    such res = mollie.boek_betalingen(s, [betaling_op("tr_10", "2026-09-30T21:30:00+00:00")])
    amaze res["geboekt"] == 0
    amaze res["vergrendeld"] == ["tr_10"]
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such in_usd much b:
    b["amount"] = {"value": b["amount"]["value"], "currency": "USD"}
    return b
wow

such audit_regels much actie:
    such uit = []
    for r in strings.split(fetch.read(fetch.join(TMPMAP, "audit.dsonl")), "\n"):
        if actie in r:
            uit.append(r)
    return uit
wow

such test_usd_betaling_geweigerd:
    such s = verse_store()
    such res = mollie.boek_betalingen(s, [in_usd(betaling("tr_u", "25.00"))])
    amaze res["geboekt"] == 0
    amaze res["geweigerd"] == ["tr_u (USD 25.00)"]
    amaze len(s.laad("journaal", [])) == 0
    amaze len(audit_regels("mollie-geweigerd")) == 1
    such opnieuw = mollie.boek_betalingen(s, [in_usd(betaling("tr_u", "25.00"))])
    amaze opnieuw["geweigerd"] == ["tr_u (USD 25.00)"]
    amaze len(audit_regels("mollie-geweigerd")) == 2
    schoon()
wow

such test_usd_refund_geweigerd:
    such s = verse_store()
    such res = mollie.boek_refund_lijst(s, [in_usd(refund_sample("re_u"))])
    amaze res["geboekt"] == 0
    amaze res["geweigerd"] == ["re_u (USD 12.10)"]
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_ontbrekende_valuta_geweigerd:
    such b = betaling("tr_x", "12.10")
    b["amount"] = {"value": "12.10"}
    such s = verse_store()
    amaze mollie.boek_betalingen(s, [b])["geweigerd"] == ["tr_x (? 12.10)"]
    schoon()
wow

such test_naar_post_weigert_vreemde_valuta:
    such gebonkt = false
    pls
        mollie.betaling_naar_post(in_usd(betaling("tr_u", "25.00")))
    oh no err!
        very gebonkt = true
    amaze gebonkt
    very gebonkt = false
    pls
        mollie.refund_naar_post(in_usd(refund_sample("re_u")))
    oh no err!
        very gebonkt = true
    amaze gebonkt
wow

such test_gemengde_batch_boekt_eur:
    such s = verse_store()
    such lijst = [betaling("tr_1", "12.10"), in_usd(betaling("tr_u", "25.00")), betaling("tr_2", "24.20")]
    such res = mollie.boek_betalingen(s, lijst)
    amaze res["geboekt"] == 2
    amaze res["geweigerd"] == ["tr_u (USD 25.00)"]
    such rres = mollie.boek_refund_lijst(s, [refund_sample("re_1"), in_usd(refund_sample("re_u"))])
    amaze rres["geboekt"] == 1
    amaze rres["geweigerd"] == ["re_u (USD 12.10)"]
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze r["rubrieken"]["1a"]["bedrag"] == 20
    amaze r["rubrieken"]["1a"]["btw"] == 4
    amaze mollie.boek_betalingen(s, lijst)["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 3
    schoon()
wow
wow
