    such res = mollie.boek_refund_lijst(s, [in_usd(refund_sample("re_u"))])
    amaze res["geboekt"] == 0
    amaze res["geweigerd"] == ["re_u (USD 12.10)"]
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_ontbrekende_valuta_geweigerd:
    such b = betaling("tr_x", "12.10")
    b["amount"] = {"value": "12.10"}
    such s = verse_store()
    amaze mollie.boek_betalingen(s, [b])["geweigerd"] == ["tr_x (? 12.10)"]
