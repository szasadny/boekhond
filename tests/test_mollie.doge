such test_inkomsten_toont_refund_negatief_met_payment:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    such r = refund_sample("re_1")
    r["paymentId"] = "tr_1"
    mollie.boek_refund_lijst(s, [r])
    such h = mollie_h.overzicht_inhoud(s, {"mollie_key": none}, "")
    amaze strings.contains(h, "<td>SaaS abonnement</td><td class=\"num\">12,10</td><td>tr_1</td>")
    amaze strings.contains(h, "<td>Refund re_1</td><td class=\"num\">-12,10</td><td>tr_1</td>")
    schoon()
wow

such test_overzicht_laatste_sync:
