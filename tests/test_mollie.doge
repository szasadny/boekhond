wow

such test_naar_post_weigert_vreemde_valuta:
    such gebonkt = false
    pls
        mollie.betaling_naar_post(in_usd(betaling("tr_u", "25.00")))
    oh no err!
        very gebonkt = true
    amaze gebonkt
    very gebonkt = false
    pls
        mollie.refund_naar_post(in_usd(refund_sample("re_u")))
    oh no err!
        very gebonkt = true
    amaze gebonkt
wow

such test_gemengde_batch_boekt_eur:
    such s = verse_store()
    such lijst = [betaling("tr_1", "12.10"), in_usd(betaling("tr_u", "25.00")), betaling("tr_2", "24.20")]
    such res = mollie.boek_betalingen(s, lijst)
    amaze res["geboekt"] == 2
    amaze res["geweigerd"] == ["tr_u (USD 25.00)"]
    such rres = mollie.boek_refund_lijst(s, [refund_sample("re_1"), in_usd(refund_sample("re_u"))])
    amaze rres["geboekt"] == 1
    amaze rres["geweigerd"] == ["re_u (USD 12.10)"]
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze r["rubrieken"]["1a"]["bedrag"] == 20
    amaze r["rubrieken"]["1a"]["btw"] == 4
    amaze mollie.boek_betalingen(s, lijst)["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 3
    schoon()
wow

# Direct via de store: deactiveer weigert een systeemrekening.
such zet_actief much s, nummer, actief:
    such lijst = s.laad("rekeningen", [])
    rekeningen.zoek(lijst, nummer)["actief"] = actief
    s.bewaar("rekeningen", lijst)
wow

such test_geweigerde_post_blokkeert_batch_niet:
    such s = verse_store()
    zet_actief(s, "8000", false)
    such lijst = [betaling("tr_1", "12.10"), betaling("tr_2", "24.20")]
    such res = mollie.boek_betalingen(s, lijst)
    amaze res["geboekt"] == 0
    amaze res["mislukt"] == ["tr_1 (rekening is inactief: 8000)", "tr_2 (rekening is inactief: 8000)"]
    amaze len(audit_regels("mollie-mislukt")) == 2
    zet_actief(s, "8000", true)
    such opnieuw = mollie.boek_betalingen(s, lijst)
    amaze opnieuw["geboekt"] == 2
    amaze opnieuw["mislukt"] == []
    such nul = refund_sample("re_0")
    nul["amount"] = {"value": "0.00", "currency": "EUR"}
    such rres = mollie.boek_refund_lijst(s, [nul, refund_sample("re_1")])
    amaze rres["geboekt"] == 1
    amaze rres["overgeslagen"] == 1
    amaze rres["mislukt"] == []
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze r["rubrieken"]["1a"]["bedrag"] == 20
    amaze r["rubrieken"]["1a"]["btw"] == 4
    schoon()
wow

such test_betaling_van_nul_overgeslagen:
    such s = verse_store()
    such res = mollie.boek_betalingen(s, [betaling("tr_0", "0.00"), betaling("tr_1", "12.10")])
    amaze res["geboekt"] == 1
    amaze res["overgeslagen"] == 1
    amaze res["mislukt"] == []
    amaze len(s.laad("journaal", [])) == 1
    schoon()
wow

so NEP_PAGINAS = {"p1": {"_embedded": {"payments": [{"id": "tr_3"}, {"id": "tr_2"}]}, "_links": {"next": {"href": "p2"}}}, "p2": {"_embedded": {"payments": [{"id": "tr_1"}]}, "_links": {"next": none}}, "lus": {"_embedded": {"payments": []}, "_links": {"next": {"href": "lus"}}}}

such nep_mollie much key, url:
    amaze key == "k"
    return NEP_PAGINAS[url]
wow

such test_haal_alle_volgt_next:
    such lijst = mollie.haal_alle(nep_mollie, "k", "p1", "payments")
    such ids = []
    for b in lijst:
        ids.append(b["id"])
    amaze ids == ["tr_3", "tr_2", "tr_1"]
wow

such test_volgende_url:
    such enkel = {"_embedded": {"refunds": [{"id": "re_1"}]}}
    amaze mollie.volgende_url(enkel) == none
    amaze mollie.volgende_url(NEP_PAGINAS["p2"]) == none
    amaze mollie.volgende_url(NEP_PAGINAS["p1"]) == "p2"
wow

such test_haal_alle_paginacap_bonkt:
    such gebonkt = false
    pls
        mollie.haal_alle(nep_mollie, "k", "lus", "payments")
    oh no err!
        very gebonkt = "200 pagina" in err.message
    amaze gebonkt
wow

such haal_fout much key, url:
    pls
        mollie.haal_json(key, url)
    oh no err!
        return err
    return none
wow

such antwoord_fout much resp:
    pls
        mollie.lees_antwoord(resp)
    oh no err!
        return err
    return none
wow

such test_lees_antwoord_parset_json:
    such data = mollie.lees_antwoord({"status": 200, "body": "\{\"_embedded\": \{\"payments\": []\}\}"})
    amaze data["_embedded"]["payments"] == []
wow

such test_lees_antwoord_status_bonkt:
    such err = antwoord_fout({"status": 401, "body": "\{\}"})
    amaze err.type == "Bonk"
    amaze err.message == "Mollie API gaf status 401"
wow

such test_lees_antwoord_ongeldige_json_bonkt:
    for body in ["<html>storing</html>", ""]:
        such err = antwoord_fout({"status": 200, "body": body})
        amaze err.type == "Bonk"
        amaze err.message == "ongeldig antwoord van Mollie"
wow

such test_onbereikbaar_bonkt_zonder_url:
    such err = haal_fout("k", "http://127.0.0.1:1/v2/payments")
    amaze err.type == "Bonk"
    amaze err.message == "Mollie is niet bereikbaar"
wow

such test_sync_handler_zonder_key_geeft_400:
    such s = verse_store()
    such resp = mollie_h.sync({"ctx": {"store": s, "config": {"mollie_key": none}}})
    amaze resp["status"] == 400
    amaze strings.contains(resp["body"], "geen MOLLIE_API_KEY geconfigureerd")
    schoon()
wow

such post_met much s, veld, waarde:
    for p in s.laad("journaal", []):
        if p.has(veld) and p[veld] == waarde:
            return p
    return none
wow

such storno_fout much s, post_id:
    such fout = ""
    pls
        journaal.storneer(s, post_id, "2026-07-25")
    oh no err!
        very fout = err.message
    return fout
wow

such test_refund_post_linkt_betaal_post:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    such r = refund_sample("re_1")
    r["paymentId"] = "tr_1"
    mollie.boek_refund_lijst(s, [r])
    such bp = post_met(s, "mollie_payment_id", "tr_1")
    such rp = post_met(s, "mollie_refund_id", "re_1")
    amaze rp["refund_van"] == bp["id"]
    amaze not bp.has("refund_van")
    schoon()
wow

such test_terugbetaalde_post_niet_storneerbaar:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    such r = refund_sample("re_1")
    r["paymentId"] = "tr_1"
    mollie.boek_refund_lijst(s, [r])
    such bp = post_met(s, "mollie_payment_id", "tr_1")
    such rp = post_met(s, "mollie_refund_id", "re_1")
    such fout = storno_fout(s, bp["id"])
    amaze fout == "post {bp["id"]} is al deels of geheel terugbetaald via refund-post {rp["id"]} en kan niet gestorneerd worden"
    amaze len(s.laad("journaal", [])) == 2
    such rub = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze rub["rubrieken"]["1a"]["bedrag"] == 0
    schoon()
wow

# Elke geboekte refund blokkeert, ook een gedeeltelijke: de rest corrigeer je met een memoriaalpost.
such test_deels_terugbetaalde_post_niet_storneerbaar:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "121.00")])
    such r = refund_sample("re_1")
    r["paymentId"] = "tr_1"
    mollie.boek_refund_lijst(s, [r])
    such bp = post_met(s, "mollie_payment_id", "tr_1")
    amaze "terugbetaald" in storno_fout(s, bp["id"])
    schoon()
wow

such test_mollie_post_zonder_refund_storneerbaar:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10"), betaling("tr_2", "12.10")])
    such r = refund_sample("re_1")
    r["paymentId"] = "tr_1"
    mollie.boek_refund_lijst(s, [r])
    such bp = post_met(s, "mollie_payment_id", "tr_2")
    amaze storno_fout(s, bp["id"]) == ""
    amaze post_met(s, "storno_van", bp["id"]) != none
    schoon()
wow

such refund_voor much id, payment_id, waarde:
    such r = refund_sample(id)
    r["paymentId"] = payment_id
    r["amount"] = {"value": waarde, "currency": "EUR"}
    return r
wow

such test_refund_voor_betaal_post_wordt_later_gekoppeld:
    such s = verse_store()
    mollie.boek_refund_lijst(s, [refund_voor("re_1", "tr_1", "12.10")])
    such rp = post_met(s, "mollie_refund_id", "re_1")
    amaze rp["refund_payment_id"] == "tr_1"
    amaze not rp.has("refund_van")
    amaze mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])["geboekt"] == 1
    such bp = post_met(s, "mollie_payment_id", "tr_1")
    amaze bp["terugbetaald_via"] == [rp["id"]]
    amaze "terugbetaald via refund-post {rp["id"]}" in storno_fout(s, bp["id"])
    such opnieuw = mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    amaze opnieuw["geboekt"] == 0
    amaze mollie.boek_refund_lijst(s, [refund_voor("re_1", "tr_1", "12.10")])["geboekt"] == 0
    amaze len(s.laad("journaal", [])) == 2
    such h = mollie_h.overzicht_inhoud(s, {"mollie_key": none}, "")
    amaze strings.contains(h, "<td>Refund re_1</td><td class=\"num\">-12,10</td><td>tr_1</td>")
    schoon()
wow

# De link komt op de nieuwe betaal-post, niet op de vergrendelde refund-post.
such test_late_koppeling_muteert_vergrendelde_refund_niet:
    such s = verse_store()
    mollie.boek_refund_lijst(s, [refund_voor("re_1", "tr_1", "6.05"), refund_voor("re_2", "tr_1", "6.05")])
    such voor = s.laad("journaal", [])
    s.bewaar("aangiften", [{"jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}])
    such res = mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
    amaze res["verschoven"] == ["tr_1"]
    such na = s.laad("journaal", [])
    amaze na[0] == voor[0]
    amaze na[1] == voor[1]
    such bp = post_met(s, "mollie_payment_id", "tr_1")
    amaze bp["terugbetaald_via"] == [voor[0]["id"], voor[1]["id"]]
    amaze "terugbetaald" in storno_fout(s, bp["id"])
    schoon()
wow

such test_refund_post_niet_storneerbaar:
    such s = verse_store()
    mollie.boek_betalingen(s, [betaling("tr_1", "12.10")])
