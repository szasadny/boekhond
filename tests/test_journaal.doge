such test_bewaar_weigert_verre_toekomst:
    such s = verse_store()
    such d = "{datum.jaar(datum.vandaag()) + 2}-01-01"
    such p = journaal.memoriaal_post(d, "x", "", [regel("4200", "50", "", none), regel("1600", "", "50", none)])
    amaze weigering(s, p) == "boekdatum {d} ligt meer dan een jaar in de toekomst"
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_bewaar_weigert_te_groot_bedrag:
    such s = verse_store()
    such te_groot = memo([regel("4200", "1000000000.00", "", none), regel("1600", "", "1000000000.00", none)], "memoriaal")
    amaze weigering(s, te_groot) == "bedrag op rekening 4200 is te groot (maximaal 999.999.999,99)"
    such grens = memo([regel("4200", "999999999.99", "", none), regel("1600", "", "999999999.99", none)], "memoriaal")
    amaze weigering(s, grens) == ""
    schoon()
wow

such test_bank_prive_weigert_priverekening_als_tegenrekening:
    for kant in ["storting", "onttrekking"]:
        such melding = ""
        pls
            journaal.prive_post("2026-07-15", "x", rekeningen.REK_PRIVE, "50", kant)
        oh no err!
            very melding = err.message
        amaze melding == "kies een tegenrekening, niet de privérekening 0900 zelf", kant
    such s = verse_store()
    amaze "value=\"0900\"" not in journaal_h.bank_inhoud(s, "")
    amaze "value=\"1100\"" in journaal_h.bank_inhoud(s, "")
    such resp = journaal_h.bank(post_req(s, "datum=2026-07-15&omschrijving=x&rekening=0900&bedrag=50&kant=storting"))
    amaze resp["status"] == 400
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

