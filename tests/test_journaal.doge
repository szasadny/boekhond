so fetch
so strings
so "../app/store/store.doge"
so "../app/services/journaal.doge"
so "../app/services/rekeningen.doge"
so "../app/services/btw.doge"
so "../app/services/aangifte.doge"
so "../app/handlers/journaal_h.doge"
so "../lib/datum.doge"
so "../app/services/mollie.doge"
so "../app/services/bijlagen.doge"

so TMPMAP = "tmp_test_journaal"

such schoon:
    if fetch.exists(TMPMAP):
        fetch.remove_dir(TMPMAP)
wow

such verse_store:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    return s
wow

such test_balans_klopt:
    such goed = [{"rekening": "4200", "debet": "100", "credit": "", "btw_code": none}, {"rekening": "1600", "debet": "", "credit": "100", "btw_code": none}]
    amaze journaal.balans_klopt(goed)
    such fout = [{"rekening": "4200", "debet": "100", "credit": "", "btw_code": none}, {"rekening": "1600", "debet": "", "credit": "90", "btw_code": none}]
    amaze not journaal.balans_klopt(fout)
wow

such test_bewaar_kent_id_uit:
    such s = verse_store()
    such post = journaal.memoriaal_post("2026-07-15", "test", "", [{"rekening": "1100", "debet": "50", "credit": "", "btw_code": none}, {"rekening": "0900", "debet": "", "credit": "50", "btw_code": none}])
    such bewaard = journaal.bewaar(s, post)
    amaze bewaard["id"] == "j-1"
    amaze len(bewaard["created_at"]) == 20
    amaze len(s.laad("journaal", [])) == 1
    schoon()
wow

such test_bewaar_onbalans_weigert:
    such s = verse_store()
    such post = journaal.memoriaal_post("2026-07-15", "scheef", "", [{"rekening": "1100", "debet": "50", "credit": "", "btw_code": none}, {"rekening": "0900", "debet": "", "credit": "40", "btw_code": none}])
    such gevangen = false
    pls
        journaal.bewaar(s, post)
    oh no err!
        very gevangen = true
    amaze gevangen
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_bewaar_weigert_afwijkend_btw_bedrag:
    such s = verse_store()
    such post = journaal.memoriaal_post("2026-07-15", "scheef", "", [{"rekening": "1100", "debet": "100.00", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "82.64", "btw_code": "hoog_21", "btw_bedrag": "17.38"}, {"rekening": "1510", "debet": "", "credit": "17.36", "btw_code": none}])
    such melding = ""
    pls
        journaal.bewaar(s, post)
    oh no err!
        very melding = err.message
    amaze melding == "ongeldig btw-bedrag op rekening 8000"
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_bewaar_onbekende_btw_code_weigert:
    such s = verse_store()
    such post = journaal.memoriaal_post("2026-07-15", "bogus", "", [{"rekening": "1300", "debet": "100", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "100", "btw_code": "bogus"}])
    such melding = ""
    pls
        journaal.bewaar(s, post)
    oh no err!
        very melding = err.message
    amaze melding == "onbekende btw-code: bogus"
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_tijdvak_vergrendeld:
    such s = verse_store()
    s.bewaar("aangiften", [{"jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}])
    such post = journaal.memoriaal_post("2026-08-01", "te laat", "", [{"rekening": "1100", "debet": "10", "credit": "", "btw_code": none}, {"rekening": "0900", "debet": "", "credit": "10", "btw_code": none}])
    such gevangen = false
    pls
        journaal.bewaar(s, post)
    oh no err!
        very gevangen = true
    amaze gevangen
    schoon()
wow

such test_inkoop_aftrek_balanceert:
    such post = journaal.inkoop_post("2026-07-15", "KPN", "internet", "100", "voorbelasting_hoog", "4200")
    amaze len(post["regels"]) == 3
    amaze journaal.balans_klopt(post["regels"])
    amaze post["bron"] == "handmatig"
wow

such test_inkoop_zelf_balanceert:
    such post = journaal.inkoop_post("2026-07-15", "Anthropic", "claude", "100", "import_buiten_eu", "4000")
    amaze len(post["regels"]) == 4
    amaze journaal.balans_klopt(post["regels"])
wow

such test_inkoop_geen_btw_balanceert:
    such post = journaal.inkoop_post("2026-07-15", "Verzekeraar", "aansprakelijkheid", "250", "geen_btw", "4300")
    amaze len(post["regels"]) == 2
    amaze journaal.balans_klopt(post["regels"])
wow

such test_prive_post_balanceert:
    such storting = journaal.prive_post("2026-07-15", "eigen geld", "1100", "500", "storting")
    amaze journaal.balans_klopt(storting["regels"])
    such onttrekking = journaal.prive_post("2026-07-15", "opname", "1100", "500", "onttrekking")
    amaze journaal.balans_klopt(onttrekking["regels"])
wow

# 250,50 x 21% = 52,605 -> 52,61 (half-up); 1.000,00 x 21% = 210,00.
such test_privegebruik_nl_bedragen:
    such p = journaal.privegebruik_post("2026-12-31", "250,50")
    amaze dec(p["regels"][0]["debet"]) == dec("303.11")
    amaze dec(p["regels"][1]["credit"]) == dec("250.50")
    amaze dec(p["regels"][2]["credit"]) == dec("52.61")
    amaze journaal.balans_klopt(p["regels"])
    such q = journaal.privegebruik_post("2026-12-31", "1.000,00")
    amaze dec(q["regels"][0]["debet"]) == dec("1210")
    amaze dec(q["regels"][1]["credit"]) == dec("1000")
    amaze dec(q["regels"][2]["credit"]) == dec("210")
wow

such privegebruik_fout much grondslag:
    pls
        journaal.privegebruik_post("2026-12-31", grondslag)
    oh no err!
        return err.message
    return none
wow

such test_privegebruik_weigert_leeg_nul_negatief:
    amaze privegebruik_fout("") == "vul de grondslag privégebruik in"
    amaze privegebruik_fout("  ") == "vul de grondslag privégebruik in"
    amaze privegebruik_fout("0") == "grondslag privégebruik moet groter zijn dan 0"
    amaze privegebruik_fout("0,00") == "grondslag privégebruik moet groter zijn dan 0"
    amaze privegebruik_fout("-500") == "grondslag privégebruik moet groter zijn dan 0"
    amaze privegebruik_fout("abc") == "ongeldig bedrag: abc"
wow

such test_privegebruik_omschrijving_jaar_van_boekdatum:
    amaze journaal.privegebruik_post("2025-12-31", "100")["omschrijving"] == "Privégebruik 2025"
wow

such test_rubrieken_uit_geboekte_inkoop:
    such s = verse_store()
    such post = journaal.inkoop_post("2026-07-15", "Anthropic", "claude", "100", "import_buiten_eu", "4000")
    journaal.bewaar(s, post)
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 3)
    amaze r["rubrieken"]["4a"]["bedrag"] == 100
    amaze r["rubrieken"]["4a"]["btw"] == 21
    amaze r["5b"] == 21
    amaze r["saldo"] == 0
    schoon()
wow

such test_storno_spiegelt:
    such post = journaal.inkoop_post("2026-07-15", "KPN", "internet", "100", "voorbelasting_hoog", "4200")
    such p2 = post
    p2["id"] = "j-9"
    such sp = journaal.storno_post(p2, "2026-10-01")
    amaze sp["storno_van"] == "j-9"
    amaze journaal.balans_klopt(sp["regels"])
    amaze sp["regels"][0]["credit"] == post["regels"][0]["debet"]
wow

such test_storno_nettoot_rubriek_naar_nul:
    such s = verse_store()
    such post = journaal.memoriaal_post("2026-04-10", "verkoop", "", [{"rekening": "1300", "debet": "1210", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "1000", "btw_code": "hoog_21"}, {"rekening": "1510", "debet": "", "credit": "210", "btw_code": none}])
    such bewaard = journaal.bewaar(s, post)
    such sp = journaal.storno_post(bewaard, "2026-05-10")
    journaal.bewaar(s, sp)
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 2)
    amaze r["rubrieken"]["1a"]["bedrag"] == 0
    amaze r["rubrieken"]["1a"]["btw"] == 0
    amaze r["saldo"] == 0
    schoon()
wow
# Tijdvakkeuze in de journaallijst: ?tv=JJJJ-K wint, daarna ?j=&kw=; ongeldige invoer valt
# terug op het te-doen tijdvak.
such test_gekozen_tijdvak:
    such s = verse_store()
    such te = aangifte.te_doen_tijdvak(s, datum.vandaag())
    such a = journaal_h.gekozen_tijdvak(s, {"tv": ["2026-3"]})
    amaze a[0] == 2026 and a[1] == 3
    such b = journaal_h.gekozen_tijdvak(s, {"j": ["2025"], "kw": ["4"]})
    amaze b[0] == 2025 and b[1] == 4
    such c = journaal_h.gekozen_tijdvak(s, {})
    amaze c[0] == te[0] and c[1] == te[1]
    such d = journaal_h.gekozen_tijdvak(s, {"tv": ["2026-9"]})
    amaze d[0] == te[0] and d[1] == te[1]
    such e = journaal_h.gekozen_tijdvak(s, {"tv": ["abcd-1"]})
    amaze e[0] == te[0] and e[1] == te[1]
    schoon()
wow

such verkoop_1000:
    return journaal.memoriaal_post("2026-04-10", "verkoop", "", [{"rekening": "1300", "debet": "1210", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "1000", "btw_code": "hoog_21"}, {"rekening": "1510", "debet": "", "credit": "210", "btw_code": none}])
wow

such test_storneer_boekt_eenmalig:
    such s = verse_store()
    such orig = journaal.bewaar(s, verkoop_1000())
    such sp = journaal.storneer(s, orig["id"], "2026-05-10")
    amaze sp["storno_van"] == orig["id"]
    such fout = ""
    pls
        journaal.storneer(s, orig["id"], "2026-05-11")
    oh no err!
        very fout = err.message
    amaze fout == "post {orig["id"]} is al gestorneerd door {sp["id"]}"
    amaze len(s.laad("journaal", [])) == 2
    such r = btw.rubrieken(s.laad("journaal", []), 2026, 2)
    amaze r["rubrieken"]["1a"]["bedrag"] == 0
    amaze r["rubrieken"]["1a"]["btw"] == 0
    schoon()
wow

such test_storno_van_storno_geweigerd:
    such s = verse_store()
    such orig = journaal.bewaar(s, verkoop_1000())
    such sp = journaal.storneer(s, orig["id"], "2026-05-10")
    such fout = ""
    pls
        journaal.storneer(s, sp["id"], "2026-05-11")
    oh no err!
        very fout = err.message
    amaze fout == "post {sp["id"]} is zelf een storno van {orig["id"]} en kan niet gestorneerd worden"
    amaze len(s.laad("journaal", [])) == 2
    schoon()
wow

such test_storno_index:
    such s = verse_store()
    such a = journaal.bewaar(s, verkoop_1000())
    such b = journaal.bewaar(s, verkoop_1000())
    such sp = journaal.storneer(s, a["id"], "2026-05-10")
    such lijst = s.laad("journaal", [])
    such idx = journaal.storno_index(lijst)
    amaze idx == {a["id"]: sp["id"]}
    amaze journaal.storno_weigering(lijst, b) == ""
    schoon()
wow

such regel much rek, debet, credit, code:
    return {"rekening": rek, "debet": debet, "credit": credit, "btw_code": code}
wow

such memo much regels, bron:
    such p = journaal.memoriaal_post("2026-07-15", "validatie", "", regels)
    p["bron"] = bron
    return p
wow

such weigering much s, post:
    pls
        journaal.bewaar(s, post)
    oh no err!
        return err.message
    return ""
wow

such test_bewaar_weigert_ongeldige_regels:
    such gevallen = [
        [memo([regel("", "50", "", none), regel("1100", "", "50", none)], "memoriaal"), "regel zonder rekening"],
        [memo([regel("9999", "50", "", none), regel("1100", "", "50", none)], "memoriaal"), "onbekende rekening: 9999"],
        [memo([regel("4200", "50", "50", none), regel("1100", "50", "", none), regel("1600", "", "50", none)], "memoriaal"), "regel op rekening 4200 moet precies één bedrag hebben: debet of credit"],
        [memo([regel("4200", "", "", none), regel("1100", "50", "", none), regel("1600", "", "50", none)], "memoriaal"), "regel op rekening 4200 moet precies één bedrag hebben: debet of credit"],
        [memo([regel("4200", "-20", "", none), regel("1600", "", "-20", none)], "memoriaal"), "negatief bedrag op rekening 4200"],
        [memo([regel("4200", "0", "", none), regel("1600", "", "0", none)], "memoriaal"), "een journaalpost moet een bedrag groter dan nul hebben"],
        [journaal.inkoop_post("2026-07-15", "Lev", "x", "-20.00", "voorbelasting_hoog", "4200"), "negatief bedrag op rekening 4200"],
        [journaal.inkoop_post("2026-07-15", "Lev", "x", "0.00", "geen_btw", "4200"), "een journaalpost moet een bedrag groter dan nul hebben"],
        [journaal.inkoop_post("2026-07-15", "Lev", "x", "50.00", "hoog_21", "4200"), "btw-code hoog_21 hoort bij verkoop, deze boeking vraagt een inkoop-code"],
        [memo([regel("4200", "50", "", "hoog_21"), regel("1600", "", "50", none)], "terugkerend"), "btw-code hoog_21 hoort bij verkoop, deze boeking vraagt een inkoop-code"],
        [memo([regel("1100", "121", "", none), regel("8000", "", "100", "voorbelasting_hoog"), regel("1510", "", "21", none)], "mollie"), "btw-code voorbelasting_hoog hoort bij inkoop, deze boeking vraagt een verkoop-code"],
    ]
    for g in gevallen:
        such s = verse_store()
        amaze weigering(s, g[0]) == g[1], g[1]
        amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_memoriaal_mag_elke_soort:
    such s = verse_store()
    such p = memo([regel("1300", "121", "", none), regel("8000", "", "100", "hoog_21"), regel("1510", "", "21", none), regel("4200", "10", "", "voorbelasting_hoog"), regel("1600", "", "10", none)], "memoriaal")
    amaze weigering(s, p) == ""
    schoon()
wow

such test_inactieve_rekening_geweigerd_behalve_storno:
    such s = verse_store()
    such orig = journaal.bewaar(s, memo([regel("4500", "100", "", none), regel("1100", "", "100", none)], "memoriaal"))
    rekeningen.deactiveer(s, "4500")
    amaze weigering(s, memo([regel("4500", "10", "", none), regel("1100", "", "10", none)], "memoriaal")) == "rekening is inactief: 4500"
    amaze weigering(s, journaal.storno_post(orig, "2026-08-01")) == ""
    amaze len(s.laad("journaal", [])) == 2
    schoon()
wow

such test_mollie_cent_betaling_met_nul_btw_regel:
    such s = verse_store()
    such b = {"id": "tr_c", "status": "paid", "amount": {"value": "0.01", "currency": "EUR"}, "paidAt": "2026-07-15T10:00:00+00:00", "description": "x", "amountRefunded": {"value": "0.00", "currency": "EUR"}}
    such p = mollie.betaling_naar_post(b)
    amaze dec(p["regels"][2]["credit"]) == dec("0")
    amaze weigering(s, p) == ""
    schoon()
wow

such detail_req much s, id:
    return {"ctx": {"store": s}, "params": {"id": id}, "method": "GET", "path": "/journaal/{id}"}
wow

such test_detail_onbekende_post_is_404:
    such s = verse_store()
    such resp = journaal_h.detail(detail_req(s, "j-99"))
    amaze resp["status"] == 404
    schoon()
wow

such test_detail_toont_regels_bijlagen_en_storno:
    such s = verse_store()
    such post = journaal.memoriaal_post("2026-07-15", "<b>kantoor</b>", "", [{"rekening": "4200", "debet": "121", "credit": "", "btw_code": none}, {"rekening": "1100", "debet": "", "credit": "121", "btw_code": none}])
    such orig = journaal.bewaar(s, post)
    such b = bijlagen.bewaar(s, {"filename": "bon.pdf", "data": bytes("%PDF-1.4")}, "upload")
    bijlagen.koppel(s, b["id"], orig["id"])
    journaal.storneer(s, orig["id"], "2026-07-20")
    such h = journaal_h.detail(detail_req(s, orig["id"]))["body"]
    amaze "&lt;b&gt;kantoor&lt;/b&gt;" in h
    amaze "4200 Kantoorkosten" in h
    amaze "<b>kantoor</b>" not in h
    amaze "<td class=\"num\">121,00</td>" in h
    amaze "href=\"/bijlagen/b-1\">bon.pdf</a>" in h
    amaze "Gestorneerd door <a href=\"/journaal/j-2\">j-2</a>" in h
    such hs = journaal_h.detail(detail_req(s, "j-2"))["body"]
    amaze "Storno van <a href=\"/journaal/j-1\">j-1</a>" in hs
    schoon()
wow

such post_req much s, body:
    return {"ctx": {"store": s}, "method": "POST", "body": body}
wow

such aantal much tekst, deel:
    return len(strings.split(tekst, deel)) - 1
wow

such test_inkoop_fout_toont_invoer_terug:
    such s = verse_store()
    such resp = journaal_h.inkoop(post_req(s, "datum=2026-07-15&leverancier=A%3C%22%26B&omschrijving=bon&bedrag_ex=abc&btw_code=voorbelasting_laag&kosten_rek=4200"))
    amaze resp["status"] == 400
    such h = resp["body"]
    amaze "class=\"fout\"" in h
    amaze "name=\"leverancier\" type=\"text\" value=\"A&lt;&quot;&amp;B\"" in h
    amaze "A<\"&B" not in h
    amaze "name=\"bedrag_ex\" type=\"text\" value=\"abc\"" in h
    amaze "name=\"datum\" type=\"date\" value=\"2026-07-15\"" in h
    amaze "<option value=\"voorbelasting_laag\" selected>" in h
    amaze "<option value=\"4200\" selected>" in h
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_memoriaal_fout_behoudt_alle_regels:
    such s = verse_store()
    such rijen = "regel_rekening=4200&regel_debet=10%2C00&regel_credit=&regel_btw=geen_btw&regel_rekening=1600&regel_debet=&regel_credit=9%2C00&regel_btw="
    for i in range(4):
        very rijen = rijen + "&regel_rekening=&regel_debet=&regel_credit=&regel_btw="
    very rijen = rijen + "&regel_rekening=1100&regel_debet=&regel_credit=0%2C50&regel_btw="
    such body = "datum=2026-07-15&omschrijving=A%3C%22%26B&relatie=&correctie_van=&" + rijen
    such resp = journaal_h.memoriaal(post_req(s, body))
    amaze resp["status"] == 400
    such h = resp["body"]
    amaze aantal(h, "name=\"regel_rekening\"") == 7
    amaze "name=\"omschrijving\" type=\"text\" value=\"A&lt;&quot;&amp;B\"" in h
    amaze "value=\"10,00\"" in h
    amaze "value=\"9,00\"" in h
    amaze "value=\"0,50\"" in h
    amaze "<option value=\"1100\" selected>" in h
    amaze "<option value=\"1600\" selected>" in h
    amaze "<option value=\"geen_btw\" selected>" in h
    amaze len(s.laad("journaal", [])) == 0
    schoon()
wow

such test_memoriaal_leeg_formulier_ongewijzigd:
    such h = journaal_h.memoriaal_inhoud(verse_store(), "")
    amaze aantal(h, "name=\"regel_rekening\"") == journaal_h.MEMO_RIJEN
    amaze aantal(h, " selected>") == aantal(h, "<option value=\"\" selected>")
    schoon()
wow
such test_bewaar_weigert_ongeldige_datum:
    such regels = [regel("4200", "50", "", none), regel("1600", "", "50", none)]
    such gevallen = [["", "datum ontbreekt"], ["2026-02-30", "ongeldige datum (JJJJ-MM-DD): 2026-02-30"], ["2026-13-01", "ongeldige datum (JJJJ-MM-DD): 2026-13-01"]]
    for g in gevallen:
        such s = verse_store()
        amaze weigering(s, journaal.memoriaal_post(g[0], "x", "", regels)) == g[1], g[1]
    schoon()
wow

such test_sjabloonflows_melden_ontbrekende_invoer:
    such meldingen = []
    pls
        journaal.inkoop_post("2026-07-15", "Lev", "x", "", "voorbelasting_hoog", "4200")
    oh no err!
        meldingen.append(err.message)
    pls
        journaal.prive_post("2026-07-15", "x", "1100", "", "storting")
    oh no err!
        meldingen.append(err.message)
    pls
        journaal.privegebruik_post("", "100")
    oh no err!
        meldingen.append(err.message)
    pls
        journaal.privegebruik_post("2026-14-01", "100")
    oh no err!
        meldingen.append(err.message)
    amaze meldingen == ["bedrag ontbreekt", "bedrag ontbreekt", "datum ontbreekt", "ongeldige datum (JJJJ-MM-DD): 2026-14-01"]
wow

such test_storno_form_onbekende_post_is_404:
    such s = verse_store()
    such resp = journaal_h.storno_form({"ctx": {"store": s}, "query": {"id": ["j-99"]}})
    amaze resp["status"] == 404
    amaze "Onbekende post: j-99" in resp["body"]
    such orig = journaal.bewaar(s, journaal.memoriaal_post("2026-07-15", "kantoor", "", [{"rekening": "4200", "debet": "121", "credit": "", "btw_code": none}, {"rekening": "1100", "debet": "", "credit": "121", "btw_code": none}]))
    amaze journaal_h.storno_form({"ctx": {"store": s}, "query": {"id": [orig["id"]]}})["status"] == 200
    schoon()
wow
such test_sjabloonflows_slaan_twee_decimalen_op:
    such p = journaal.inkoop_post("2026-07-15", "Lev", "x", "10", "voorbelasting_hoog", "4200")
    amaze [p["regels"][0]["debet"], p["regels"][1]["debet"], p["regels"][2]["credit"]] == ["10.00", "2.10", "12.10"]
    such q = journaal.prive_post("2026-07-15", "x", "1100", "259.2600", "storting")
    amaze q["regels"][0]["debet"] == "259.26"
