such test_boekdatum_hoogstens_een_jaar_vooruit:
    such gevallen = [["2026-10-27", "2026-10-27", ""], ["2027-10-27", "2026-10-27", ""], ["2027-10-28", "2026-10-27", "boekdatum 2027-10-28 ligt meer dan een jaar in de toekomst"], ["2020-01-01", "2026-10-27", ""], ["2028-02-28", "2027-02-28", ""], ["2028-02-29", "2027-02-28", "boekdatum 2028-02-29 ligt meer dan een jaar in de toekomst"], ["2029-02-28", "2028-02-29", ""], ["2029-03-01", "2028-02-29", "boekdatum 2029-03-01 ligt meer dan een jaar in de toekomst"]]
    for g in gevallen:
        such melding = ""
        pls
            journaal.controleer_boekdatum(g[0], g[1])
        oh no err!
            very melding = err.message
        amaze melding == g[2], g[0]
