such test_weigert_kapotte_audit:
    schoon()
    such bundel = bundel_van(overdracht.exporteer(gevulde_bron()))
    bundel["audit"] = bundel["audit"] + "geen dson\n"
    weigert_zonder_writes(bundel, "export ongeldig")
