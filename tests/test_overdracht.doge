wow

such test_weigert_vreemde_invoer:
    schoon()
    such doel = verse(DOEL)
    amaze strings.contains(import_fout(doel, "geen json"), "geen JSON")
    amaze strings.contains(import_fout(doel, "[1, 2]"), "geen Boekhond-export")
    amaze strings.contains(import_fout(doel, "\{\"formaat\": \"iets\"\}"), "geen Boekhond-export")
    such bundel = bundel_van(overdracht.exporteer(verse(BRON)))
    bundel["versie"] = 2
    amaze strings.contains(import_fout(doel, json.emit(bundel)), "onbekende exportversie: 2")
    amaze overdracht.is_leeg(doel)
    schoon()
wow

such test_weigert_onverwachte_structuur_zonder_details:
    schoon()
    such doel = verse(DOEL)
    such fout = import_fout(doel, "\{\"formaat\": \"{overdracht.FORMAAT}\"\}")
    amaze fout == "export ongeldig: onverwachte structuur"
    amaze overdracht.is_leeg(doel)
    schoon()
wow
# Multipart-upload zoals de browser 'm stuurt, met het exportbestand in veld "export".
such upload_req much s, tekst:
    such grens = "X-GRENS-42"
    such kop = "--{grens}\r\nContent-Disposition: form-data; name=\"export\"; filename=\"export.json\"\r\nContent-Type: application/json\r\n\r\n"
    such body = bytes(kop) + bytes(tekst) + bytes("\r\n--{grens}--\r\n")
    such ct = "multipart/form-data; boundary={grens}"
    return {"ctx": {"store": s, "config": {}}, "headers": {"content-type": [ct]}, "body": body, "params": {}}
wow

such test_handler_export_en_import:
    schoon()
    such bron = gevulde_bron()
    such resp = overdracht_h.export_json({"ctx": {"store": bron, "config": {}}})
    amaze resp["status"] == 200
    amaze resp["headers"]["Content-Type"] == "application/json"
    amaze strings.contains(resp["headers"]["Content-Disposition"], "boekhond-export-")
    such doel = verse(DOEL)
    such voor = overdracht_h.pagina({"ctx": {"store": doel, "config": {}}})
    amaze strings.contains(voor["body"], "/overdracht/import")
    such na = overdracht_h.importeer(upload_req(doel, resp["body"]))
    amaze strings.contains(na["body"], "Import geslaagd: 1 journaalposten, 2 bijlagen")
    amaze not strings.contains(na["body"], "action=\"/overdracht/import\"")
    such nogmaals = overdracht_h.importeer(upload_req(doel, resp["body"]))
    amaze nogmaals["status"] == 400
    amaze strings.contains(nogmaals["body"], "class=\"fout\"")
    amaze len(doel.laad("journaal", [])) == 1
    schoon()
wow

such test_handler_import_geen_json_geeft_400:
    schoon()
    such doel = verse(DOEL)
    such resp = overdracht_h.importeer(upload_req(doel, "geen json"))
    amaze resp["status"] == 400
    amaze strings.contains(resp["body"], "geen geldige export: geen JSON")
    amaze overdracht.is_leeg(doel)
    schoon()
wow
wow
