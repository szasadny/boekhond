    s.bewaar("aangiften", [{"id": "a-1", "jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}])
    such gevangen = false
    pls
        bijlagen.koppel(s, m["id"], nieuw["id"])
    oh no err!
        very gevangen = true
    amaze gevangen
    amaze bijlagen.zoek(bijlagen.alle(s), m["id"])["journaalpost_id"] == oud["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), oud["id"])["bijlage_ids"] == [m["id"]]
    amaze journaal.zoek_post(s.laad("journaal", []), nieuw["id"])["bijlage_ids"] == []
    schoon()
wow

such test_koppel_zelfde_post_opnieuw_is_noop:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", pdf_data()), "upload")
    such post = maak_post(s)
    bijlagen.koppel(s, m["id"], post["id"])
    such audit_voor = fetch.read(fetch.join(TMPMAP, "audit.dsonl"))
    such b = bijlagen.koppel(s, m["id"], post["id"])
    amaze b["journaalpost_id"] == post["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), post["id"])["bijlage_ids"] == [m["id"]]
    amaze fetch.read(fetch.join(TMPMAP, "audit.dsonl")) == audit_voor
    schoon()
wow

# Halve koppeling: de post-kant is geschreven, de bijlage-commit niet.
such half_gekoppeld much s:
    such m = bijlagen.bewaar(s, deel("f.pdf", pdf_data()), "upload")
    such post = maak_post(s)
    journaal.koppel_bijlage(s, post["id"], m["id"])
    return [m, post]
wow

such test_halve_koppeling_niet_in_inbox:
