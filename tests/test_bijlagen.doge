such test_weiger_te_groot:
    such s = verse()
    such gevangen = false
    pls
        bijlagen.bewaar(s, deel("groot.pdf", groter_dan(bijlagen.MAX_BYTES)), "upload")
    oh no err!
        very gevangen = true
    amaze gevangen
    schoon()
wow

such test_koppel_zet_beide_kanten:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", bytes([1, 2])), "upload")
    such post = maak_post(s)
    bijlagen.koppel(s, m["id"], post["id"])
    such bl = bijlagen.zoek(bijlagen.alle(s), m["id"])
    amaze bl["journaalpost_id"] == post["id"]
    such posten = s.laad("journaal", [])
    amaze posten[0]["bijlage_ids"].contains(m["id"])
    amaze len(bijlagen.inbox(s)) == 0
    schoon()
wow

such test_koppel_vergrendeld_bonkt:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", bytes([1, 2])), "upload")
    such post = maak_post(s)
    s.bewaar("aangiften", [{"id": "a-1", "jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}])
    such gevangen = false
    pls
        bijlagen.koppel(s, m["id"], post["id"])
    oh no err!
        very gevangen = true
    amaze gevangen
    amaze len(bijlagen.inbox(s)) == 1
    schoon()
wow

such test_koppel_omhangen_geweigerd:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", bytes([1, 2])), "upload")
    such eerste = maak_post(s)
    such tweede = maak_post(s)
    bijlagen.koppel(s, m["id"], eerste["id"])
    such gevangen = false
    pls
        bijlagen.koppel(s, m["id"], tweede["id"])
    oh no err!
        very gevangen = true
        amaze strings.contains(err.message, "al gekoppeld")
    amaze gevangen
    amaze bijlagen.zoek(bijlagen.alle(s), m["id"])["journaalpost_id"] == eerste["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), eerste["id"])["bijlage_ids"] == [m["id"]]
    amaze journaal.zoek_post(s.laad("journaal", []), tweede["id"])["bijlage_ids"] == []
    schoon()
wow

such test_koppel_omhangen_uit_vergrendeld_tijdvak_geweigerd:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", bytes([1, 2])), "upload")
    such oud = maak_post_op(s, "2026-07-10")
    such nieuw = maak_post_op(s, "2026-10-05")
    bijlagen.koppel(s, m["id"], oud["id"])
    s.bewaar("aangiften", [{"id": "a-1", "jaar": 2026, "tijdvak": "Q3", "status": "ingediend"}])
    such gevangen = false
    pls
        bijlagen.koppel(s, m["id"], nieuw["id"])
    oh no err!
        very gevangen = true
    amaze gevangen
    amaze bijlagen.zoek(bijlagen.alle(s), m["id"])["journaalpost_id"] == oud["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), oud["id"])["bijlage_ids"] == [m["id"]]
    amaze journaal.zoek_post(s.laad("journaal", []), nieuw["id"])["bijlage_ids"] == []
    schoon()
wow

such test_koppel_zelfde_post_opnieuw_is_noop:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", bytes([1, 2])), "upload")
    such post = maak_post(s)
    bijlagen.koppel(s, m["id"], post["id"])
    such audit_voor = fetch.read(fetch.join(TMPMAP, "audit.dsonl"))
    such b = bijlagen.koppel(s, m["id"], post["id"])
    amaze b["journaalpost_id"] == post["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), post["id"])["bijlage_ids"] == [m["id"]]
    amaze fetch.read(fetch.join(TMPMAP, "audit.dsonl")) == audit_voor
    schoon()
wow

such test_inbox_filtert_gekoppelde:
    such s = verse()
    bijlagen.bewaar(s, deel("a.pdf", bytes([1])), "upload")
    such tweede = bijlagen.bewaar(s, deel("b.pdf", bytes([2])), "upload")
    amaze len(bijlagen.inbox(s)) == 2
    such post = maak_post(s)
    bijlagen.koppel(s, tweede["id"], post["id"])
    amaze len(bijlagen.inbox(s)) == 1
    amaze len(bijlagen.alle(s)) == 2
    schoon()
wow

such test_scan_importeert:
    such s = verse()
    drop("factuur.pdf", bytes("%PDF-1.4 test"))
    such res = bijlagen.scan_import(s)
    amaze res["geimporteerd"] == 1
    such items = bijlagen.inbox(s)
    amaze len(items) == 1
    amaze items[0]["bron"] == "import"
    amaze items[0]["bestandsnaam_origineel"] == "factuur.pdf"
    amaze not fetch.exists(import_pad("factuur.pdf"))
    amaze fetch.exists(fetch.join(TMPMAP, items[0]["pad"]))
    schoon()
wow

such test_scan_idempotent:
    such s = verse()
    drop("factuur.pdf", bytes("%PDF-1.4 test"))
    bijlagen.scan_import(s)
    such res = bijlagen.scan_import(s)
    amaze res["geimporteerd"] == 0
    amaze len(bijlagen.inbox(s)) == 1
    schoon()
wow

such test_scan_slaat_ongeldig_over:
    such s = verse()
    drop("notitie.txt", bytes("hallo"))
    such res = bijlagen.scan_import(s)
    amaze res["geimporteerd"] == 0
    amaze len(res["overgeslagen"]) == 1
    amaze fetch.exists(import_pad("notitie.txt"))
    amaze len(bijlagen.inbox(s)) == 0
    schoon()
wow

such test_scan_zonder_map:
    such s = verse()
    such res = bijlagen.scan_import(s)
    amaze res["geimporteerd"] == 0
    amaze len(res["overgeslagen"]) == 0
    schoon()
wow

# Store waarvan de importmap een bestand meldt dat niet te lezen is (IOError).
many OnleesbareImport:
    such import_lijst:
        return ["weg.pdf"]
    wow

    such laad_bestand much relpad:
        return fetch.read_bytes(fetch.join(TMPMAP, "bestaat-niet.pdf"))
    wow
wow

such test_scan_onleesbaar_bestand_geeft_vaste_reden:
    schoon()
    such res = bijlagen.scan_import(OnleesbareImport())
    amaze res["geimporteerd"] == 0
    amaze res["overgeslagen"] == [{"naam": "weg.pdf", "reden": "bestand niet te verwerken"}]
wow

such upload_req much s, filename:
    such grens = "X-GRENS-7"
    such kop = "--{grens}\r\nContent-Disposition: form-data; name=\"bestand\"; filename=\"{filename}\"\r\nContent-Type: application/octet-stream\r\n\r\n"
    such body = bytes(kop) + bytes("inhoud") + bytes("\r\n--{grens}--\r\n")
    return {"ctx": {"store": s, "config": {}}, "headers": {"content-type": ["multipart/form-data; boundary={grens}"]}, "body": body, "params": {}}
wow

such test_upload_handler_weigert_met_400:
    such s = verse()
    such resp = bijlagen_h.upload(upload_req(s, "virus.exe"))
    amaze resp["status"] == 400
    amaze strings.contains(resp["body"], "bestandstype niet toegestaan: exe")
    amaze len(bijlagen.alle(s)) == 0
    schoon()
wow

such test_upload_handler_slaat_op:
    such s = verse()
    such resp = bijlagen_h.upload(upload_req(s, "bon.pdf"))
    amaze resp["status"] == 303
    amaze len(bijlagen.inbox(s)) == 1
    schoon()
wow

such test_koppel_handler_onbekende_bijlage_geeft_400:
    such s = verse()
    such resp = bijlagen_h.koppel({"ctx": {"store": s, "config": {}}, "body": "bijlage_id=b-9&post_id=j-1"})
    amaze resp["status"] == 400
    amaze strings.contains(resp["body"], "onbekende bijlage: b-9")
    schoon()
wow
such test_geldig_pad:
    amaze bijlagen.geldig_pad("b-1", "uploads/2026/b-1.pdf")
    amaze bijlagen.geldig_pad("b-12", "uploads/2025/b-12.jpeg")
    amaze not bijlagen.geldig_pad("b-1", "uploads/2026/b-2.pdf")
    amaze not bijlagen.geldig_pad("b-1", "uploads/2026/b-1.exe")
    amaze not bijlagen.geldig_pad("b-1", "uploads/2026/../b-1.pdf")
    amaze not bijlagen.geldig_pad("b-1", "../uploads/2026/b-1.pdf")
    amaze not bijlagen.geldig_pad("b-1", "uploads/2026/b-1.pdf/x")
    amaze not bijlagen.geldig_pad("../b-1", "uploads/2026/../b-1.pdf")
    amaze not bijlagen.geldig_pad("b-1", "uploads/2026/b-1.PDF")
wow

such test_post_opties_nieuwste_eerst_zonder_vergrendeld:
    such s = verse()
    such p1 = maak_post_op(s, "2026-07-10")
    such p2 = maak_post_op(s, "2026-05-01")
    such p3 = maak_post_op(s, "2026-07-10")
    such p4 = maak_post_op(s, "2026-09-01")
    such ids = []
    for o in bijlagen_h.post_opties(s):
        ids.append(o[0])
    amaze ids == [p4["id"], p3["id"], p1["id"], p2["id"]]
    s.bewaar("aangiften", [{"id": "a-1", "jaar": 2026, "tijdvak": "Q2", "status": "ingediend"}])
    such open_ids = []
    for o in bijlagen_h.post_opties(s):
        open_ids.append(o[0])
    amaze open_ids == [p4["id"], p3["id"], p1["id"]]
    amaze bijlagen_h.post_opties(s)[0][1] == "2026-09-01 test"
    schoon()
wow

such test_posten_datalist_escaped:
    such h = bijlagen_h.posten_datalist([["j-1", "2026-07-10 <b>&"]])
    amaze h == "<datalist id=\"koppelbare-posten\"><option value=\"j-1\">2026-07-10 &lt;b&gt;&amp;</option></datalist>"
wow
wow
