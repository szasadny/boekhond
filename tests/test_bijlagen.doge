such test_post_opties_nieuwste_eerst_zonder_vergrendeld:
    such s = verse()
    such p1 = maak_post_op(s, "2026-07-10")
    such p2 = maak_post_op(s, "2026-05-01")
    such p3 = maak_post_op(s, "2026-07-10")
    such p4 = maak_post_op(s, "2026-09-01")
    such ids = []
    for o in bijlagen_h.post_opties(s):
        ids.append(o[0])
    amaze ids == [p4["id"], p3["id"], p1["id"], p2["id"]]
    s.bewaar("aangiften", [{"id": "a-1", "jaar": 2026, "tijdvak": "Q2", "status": "ingediend"}])
    such open_ids = []
    for o in bijlagen_h.post_opties(s):
        open_ids.append(o[0])
    amaze open_ids == [p4["id"], p3["id"], p1["id"]]
    amaze bijlagen_h.post_opties(s)[0][1] == "2026-09-01 test"
    schoon()
wow

