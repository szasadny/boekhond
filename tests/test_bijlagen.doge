such test_magic_bytes_per_extensie:
    such jpeg = bytes([255, 216, 255, 224, 0, 16])
    such gevallen = [["a.pdf", pdf_data(), true], ["a.PDF", bytes([0] * 100) + pdf_data(), true], ["a.pdf", bytes([0] * 1024) + pdf_data(), false], ["virus.pdf", bytes("MZ program"), false], ["a.png", png_data(), true], ["ruis.PNG", bytes([1, 2, 3, 4, 5, 6, 7, 8, 9]), false], ["a.jpg", jpeg, true], ["a.jpeg", jpeg, true], ["a.jpg", png_data(), false], ["a.png", jpeg, false], ["kort.png", bytes([137, 80]), false]]
    for g in gevallen:
        such goed = true
        pls
            bijlagen.valideer(deel(g[0], g[1]))
        oh no err!
            very goed = false
            amaze err.type == "Bonk"
            amaze strings.contains(err.message, "inhoud is geen geldig")
        amaze goed == g[2], g[0]
wow

