such upload_req much s, filename:
    return upload_req_met(s, filename, pdf_data())
wow

such upload_req_met much s, filename, data:
    such grens = "X-GRENS-7"
    such kop = "--{grens}\r\nContent-Disposition: form-data; name=\"bestand\"; filename=\"{filename}\"\r\nContent-Type: application/octet-stream\r\n\r\n"
    such body = bytes(kop) + data + bytes("\r\n--{grens}--\r\n")
    return {"ctx": {"store": s, "config": {}}, "headers": {"content-type": ["multipart/form-data; boundary={grens}"]}, "body": body, "params": {}}
wow

