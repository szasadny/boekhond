such test_koppel_omhangen_geweigerd:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("f.pdf", pdf_data()), "upload")
    such eerste = maak_post(s)
    such tweede = maak_post(s)
    bijlagen.koppel(s, m["id"], eerste["id"])
    such gevangen = false
    pls
        bijlagen.koppel(s, m["id"], tweede["id"])
    oh no err!
        very gevangen = true
        amaze strings.contains(err.message, "al gekoppeld")
    amaze gevangen
    amaze bijlagen.zoek(bijlagen.alle(s), m["id"])["journaalpost_id"] == eerste["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), eerste["id"])["bijlage_ids"] == [m["id"]]
    amaze journaal.zoek_post(s.laad("journaal", []), tweede["id"])["bijlage_ids"] == []
    schoon()
wow

