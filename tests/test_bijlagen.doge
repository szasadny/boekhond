    such ander = maak_post(s)
    such gevangen = false
    pls
        bijlagen.koppel(s, m["id"], ander["id"])
    oh no err!
        very gevangen = true
        amaze strings.contains(err.message, "al gekoppeld aan {post["id"]}")
    amaze gevangen
    amaze bijlagen.zoek(bijlagen.alle(s), m["id"])["journaalpost_id"] == post["id"]
    amaze journaal.zoek_post(s.laad("journaal", []), ander["id"])["bijlage_ids"] == []
    schoon()
wow

such test_halve_koppeling_opnieuw_afgemaakt:
