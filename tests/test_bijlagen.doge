    amaze journaal.zoek_post(s.laad("journaal", []), post["id"])["bijlage_ids"] == [m["id"]]
    amaze strings.contains(fetch.read(fetch.join(TMPMAP, "audit.dsonl")), "gekoppeld")
    schoon()
wow

such test_gekoppeld_toont_post_nieuwste_eerst:
    such s = verse()
    such eerste = bijlagen.bewaar(s, deel("a.pdf", pdf_data()), "upload")
    bijlagen.bewaar(s, deel("b.pdf", pdf_data()), "upload")
    such derde = bijlagen.bewaar(s, deel("c.pdf", pdf_data()), "upload")
    such post = maak_post(s)
    bijlagen.koppel(s, eerste["id"], post["id"])
    journaal.koppel_bijlage(s, post["id"], derde["id"])
    such g = bijlagen.gekoppeld(s)
    amaze len(g) == 2
    amaze g[0][0]["id"] == derde["id"] and g[0][1] == post["id"]
    amaze g[1][0]["id"] == eerste["id"] and g[1][1] == post["id"]
    schoon()
wow

such test_inbox_toont_gekoppelde_met_postlink_escaped:
    such s = verse()
    such m = bijlagen.bewaar(s, deel("A&B.pdf", pdf_data()), "upload")
    such regels = [{"rekening": "1100", "debet": "10.00", "credit": "", "btw_code": none}, {"rekening": "0800", "debet": "", "credit": "10.00", "btw_code": none}]
    such post = journaal.bewaar(s, journaal.memoriaal_post("2026-07-10", "<b>huur</b>", "", regels))
    bijlagen.koppel(s, m["id"], post["id"])
    such h = bijlagen_h.inbox_inhoud(s, "")
    amaze strings.contains(h, "Gekoppelde bijlagen")
    amaze strings.contains(h, "<a href=\"/bijlagen/{m["id"]}\">A&amp;B.pdf</a>")
    amaze strings.contains(h, "<a href=\"/journaal/{post["id"]}\">")
    amaze strings.contains(h, "&lt;b&gt;huur&lt;/b&gt;")
    amaze not strings.contains(h, "<b>huur")
    schoon()
wow

