such test_icp_subeuro_levering:
    such s = verse_store()
    such regels = [{"rekening": "8000", "debet": "", "credit": "0.50", "btw_code": "levering_eu"}, {"rekening": "1100", "debet": "0.50", "credit": "", "btw_code": none}]
    journaal.bewaar(s, journaal.memoriaal_post("2026-10-05", "EU levering", "klant", regels))
