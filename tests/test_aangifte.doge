so strings
so fetch
so "../app/store/store.doge"
so "../app/services/aangifte.doge"
so "../app/services/journaal.doge"
so "../app/services/rekeningen.doge"
so "../app/services/btw.doge"
so "../app/handlers/aangifte_h.doge"
so "../lib/datum.doge"

so TMPMAP = "tmp_test_aangifte"

such schoon:
    if fetch.exists(TMPMAP):
        fetch.remove_dir(TMPMAP)
wow

such verse_store:
    schoon()
    such s = store.Store(TMPMAP)
    rekeningen.seed(s)
    return s
wow

# Verkooppost hoog_21 (ex 1000, btw 210, incl 1210) op datum d.
such verkoop21 much d:
    return journaal.memoriaal_post(d, "verkoop", "", [{"rekening": "1300", "debet": "1210", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "1000", "btw_code": "hoog_21"}, {"rekening": "1510", "debet": "", "credit": "210", "btw_code": none}])
wow

# Verkooppost hoog_21 met grondslag ex op datum d.
such verkoop21_bedrag much d, ex, btw_s, incl_s:
    return journaal.memoriaal_post(d, "verkoop", "", [{"rekening": "1300", "debet": incl_s, "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": ex, "btw_code": "hoog_21"}, {"rekening": "1510", "debet": "", "credit": btw_s, "btw_code": none}])
wow

# Verkooppost laag_9 met grondslag ex op datum d (btw = rond2(ex*9/100)).
such verkoop9 much d, ex, btw_s, incl_s:
    return journaal.memoriaal_post(d, "verkoop laag", "", [{"rekening": "1300", "debet": incl_s, "credit": "", "btw_code": none}, {"rekening": "8100", "debet": "", "credit": ex, "btw_code": "laag_9"}, {"rekening": "1510", "debet": "", "credit": btw_s, "btw_code": none}])
wow

such test_overzicht_open:
    such s = verse_store()
    journaal.bewaar(s, verkoop21("2026-07-15"))
    such ov = aangifte.overzicht(s, 2026, 3)
    amaze ov["status"] == "open"
    amaze ov["rubrieken"]["1a"]["bedrag"] == 1000
    amaze ov["rubrieken"]["1a"]["btw"] == 210
    amaze ov["saldo"] == 210
    amaze ov["icp"] == false
    schoon()
wow

such test_overzicht_onbekende_btw_code:
    such s = verse_store()
    journaal.bewaar(s, verkoop21("2026-07-15"))
    such lijst = s.laad("journaal", [])
    lijst.append({"id": "j-99", "datum": "2026-07-20", "omschrijving": "oud", "relatie": "", "bron": "memoriaal", "bijlage_ids": [], "regels": [{"rekening": "1300", "debet": "100", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "100", "btw_code": "bogus"}]})
    s.bewaar("journaal", lijst)
    such ov = aangifte.overzicht(s, 2026, 3)
    amaze ov["rubrieken"]["1a"]["bedrag"] == 1000
    amaze ov["saldo"] == 210
    amaze ov["onbekend"] == ["j-99"]
    amaze "j-99" in aangifte_h.banners(ov)
    schoon()
wow

such test_dien_in_snapshot:
    such s = verse_store()
    journaal.bewaar(s, verkoop21("2020-06-15"))
    such rec = aangifte.dien_in(s, 2020, 2)
    amaze rec["id"] == "a-1"
    amaze rec["status"] == "ingediend"
    amaze rec["saldo"] == 210
    amaze len(rec["ingediend_op"]) == 20
    amaze journaal.tijdvak_open(s.laad("aangiften", []), "2020-05-01") == false
    schoon()
wow

such test_dubbel_indienen_weigert:
    such s = verse_store()
    journaal.bewaar(s, verkoop21("2020-06-15"))
    aangifte.dien_in(s, 2020, 2)
    such gevangen = false
    pls
        aangifte.dien_in(s, 2020, 2)
    oh no err!
        very gevangen = true
    amaze gevangen
    amaze len(s.laad("aangiften", [])) == 1
    schoon()
wow

such test_overzicht_toont_snapshot_na_indienen:
    such s = verse_store()
    journaal.bewaar(s, verkoop21("2020-06-15"))
    aangifte.dien_in(s, 2020, 2)
    such ov = aangifte.overzicht(s, 2020, 2)
    amaze ov["status"] == "ingediend"
    amaze ov["saldo"] == 210
    amaze len(ov["ingediend_op"]) == 20
    schoon()
wow

such test_icp_flag:
    such s = verse_store()
    journaal.bewaar(s, journaal.memoriaal_post("2026-07-15", "EU-levering", "", [{"rekening": "1300", "debet": "500", "credit": "", "btw_code": none}, {"rekening": "8100", "debet": "", "credit": "500", "btw_code": "levering_eu"}]))
    such ov = aangifte.overzicht(s, 2026, 3)
    amaze ov["icp"] == true
    amaze ov["rubrieken"]["3b"]["bedrag"] == 500
    schoon()
wow

# Grens: btw exact 1000.00 => niet verplicht (strikt >). ex 11111.11 -> rond2(999.9999)=1000.00.
such test_suppletie_op_de_grens:
    such s = verse_store()
    journaal.bewaar(s, verkoop9("2026-01-15", "11111.11", "1000.00", "12111.11"))
    aangifte.dien_in(s, 2026, 1)
    such orig = journaal.zoek_post(s.laad("journaal", []), "j-1")
    journaal.bewaar(s, journaal.storno_post(orig, "2026-04-01"))
    such sig = aangifte.suppletie_signaal(s, 2026, 2)
    amaze sig["bedrag"] == dec("1000.00")
    amaze sig["verplicht"] == false
    amaze sig["aantal"] == 1
    schoon()
wow

# Boven de grens: hoog_21 verkoop 10000 -> btw 2100 > 1000 => verplicht.
such test_suppletie_boven_grens:
    such s = verse_store()
    journaal.bewaar(s, journaal.memoriaal_post("2026-01-15", "grote verkoop", "", [{"rekening": "1300", "debet": "12100", "credit": "", "btw_code": none}, {"rekening": "8000", "debet": "", "credit": "10000", "btw_code": "hoog_21"}, {"rekening": "1510", "debet": "", "credit": "2100", "btw_code": none}]))
    aangifte.dien_in(s, 2026, 1)
    such orig = journaal.zoek_post(s.laad("journaal", []), "j-1")
    journaal.bewaar(s, journaal.storno_post(orig, "2026-04-01"))
    such sig = aangifte.suppletie_signaal(s, 2026, 2)
    amaze sig["bedrag"] == dec("2100")
    amaze sig["verplicht"] == true
    schoon()
wow

# Storno van een post in een NIET-ingediend tijdvak telt niet mee.
such test_suppletie_negeert_open_origineel:
    such s = verse_store()
    journaal.bewaar(s, verkoop21("2026-01-15"))
    such orig = journaal.zoek_post(s.laad("journaal", []), "j-1")
    journaal.bewaar(s, journaal.storno_post(orig, "2026-04-01"))
    such sig = aangifte.suppletie_signaal(s, 2026, 2)
    amaze sig["bedrag"] == dec("0")
    amaze sig["aantal"] == 0
    schoon()
wow

# Storno verkoop (btw -210) en storno inkoop (voorbelasting 21 terug, +21) op hetzelfde tijdvak: netto 189.
such test_suppletie_nettoot_tegengestelde_correcties:
    such s = verse_store()
    such v = journaal.bewaar(s, verkoop21("2026-01-15"))
    such i = journaal.bewaar(s, journaal.inkoop_post("2026-02-10", "KPN", "internet", "100", "voorbelasting_hoog", "4200"))
    aangifte.dien_in(s, 2026, 1)
    journaal.storneer(s, v["id"], "2026-04-01")
    journaal.storneer(s, i["id"], "2026-04-02")
    such sig = aangifte.suppletie_signaal(s, 2026, 2)
    amaze sig["bedrag"] == dec("189")
    amaze sig["aantal"] == 2
    schoon()
wow

# Storno btw 1500,00 (ex 7142,86) + herboeking btw 1400,00 (ex 6666,67): netto 100,00, onder de drempel.
such test_suppletie_storno_plus_herboeking:
    such s = verse_store()
    such orig = journaal.bewaar(s, verkoop21_bedrag("2026-01-15", "7142.86", "1500.00", "8642.86"))
    aangifte.dien_in(s, 2026, 1)
    journaal.storneer(s, orig["id"], "2026-04-01")
    such herboeking = verkoop21_bedrag("2026-04-01", "6666.67", "1400.00", "8066.67")
    journaal.bewaar(s, journaal.markeer_correctie(s, herboeking, orig["id"]))
    amaze herboeking["correctie_van_datum"] == "2026-01-15"
    such sig = aangifte.suppletie_signaal(s, 2026, 2)
    amaze sig["bedrag"] == dec("100.00")
    amaze sig["aantal"] == 2
    amaze sig["verplicht"] == false
    schoon()
wow

# Q1 (btw -210) en Q2 (+21) zijn aparte tijdvakken en netten niet: 210 + 21 = 231.
such test_suppletie_nettoot_niet_over_tijdvakken:
    such s = verse_store()
    such v = journaal.bewaar(s, verkoop21("2026-01-15"))
    such i = journaal.bewaar(s, journaal.inkoop_post("2026-05-10", "KPN", "internet", "100", "voorbelasting_hoog", "4200"))
    aangifte.dien_in(s, 2026, 1)
    aangifte.dien_in(s, 2026, 2)
    journaal.storneer(s, v["id"], "2026-07-01")
    journaal.storneer(s, i["id"], "2026-07-02")
    such sig = aangifte.suppletie_signaal(s, 2026, 3)
    amaze sig["bedrag"] == dec("231")
    amaze sig["aantal"] == 2
    schoon()
wow

such test_markeer_correctie_weigert_open_tijdvak:
    such s = verse_store()
    such orig = journaal.bewaar(s, verkoop21("2026-01-15"))
    such fout = ""
    pls
        journaal.markeer_correctie(s, verkoop21("2026-04-01"), orig["id"])
    oh no err!
        very fout = err.message
    amaze "niet in een ingediend tijdvak" in fout
    schoon()
wow

# Uiterste indiendatums, handmatig geijkt tegen de Belastingdienst-bron.
such test_deadline_per_kwartaal:
    amaze aangifte.deadline(2026, 1) == "2026-04-30"
    amaze aangifte.deadline(2026, 2) == "2026-07-31"
    amaze aangifte.deadline(2026, 3) == "2026-10-31"
    amaze aangifte.deadline(2026, 4) == "2027-01-31"
wow

# Lege administratie op 19 juli 2026 (Q3): ook zonder boekingen moet het vorige kwartaal worden
# aangegeven, dus Q2.
