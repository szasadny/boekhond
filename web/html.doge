so strings

# Security-contract: elke parameter wordt ge-escaped, behalve vertrouwde builder-output
# (inhoud, nav, velden, tabel); die gaat rauw erin. Handlers concatenen nooit zelf tags.

# Neutraliseer user-input voor HTML. '&' eerst, anders dubbel-escape je entities.
such escape much s:
    such r = strings.replace(str(s), "&", "&amp;")
    very r = strings.replace(r, "<", "&lt;")
    very r = strings.replace(r, ">", "&gt;")
    very r = strings.replace(r, "\"", "&quot;")
    very r = strings.replace(r, "'", "&#39;")
    return r
wow

# Progressive enhancement: de pagina werkt zonder; een ontbrekend bestand 404't onschadelijk.
such script much src:
    return "<script src=\"{escape(src)}\" defer></script>"
wow

such pagina much titel, inhoud:
    such js = script("/static/js/boekhond.js")
    return "<!DOCTYPE html>\n<html lang=\"nl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{escape(titel)}</title>\n<link rel=\"icon\" href=\"/static/favicon.svg\">\n<link rel=\"stylesheet\" href=\"/static/style.css\">\n</head>\n<body>\n{inhoud}\n{js}\n</body>\n</html>\n"
wow

such layout much titel, nav, inhoud, klasse = "":
    such kl = ""
    if klasse != "":
        very kl = " class=\"{escape(klasse)}\""
    such body = "<header>{nav}</header>\n<main{kl}>\n{inhoud}\n</main>"
    return pagina(titel, body)
wow

such veld much naam, label, type = "text", waarde = "":
    return "<label>{escape(label)}<input name=\"{escape(naam)}\" type=\"{escape(type)}\" value=\"{escape(waarde)}\"></label>"
wow

such select much naam, opties, gekozen:
    such items = ""
    for o in opties:
        such sel = " selected" if o[0] == gekozen else ""
        very items = items + "<option value=\"{escape(o[0])}\"{sel}>{escape(o[1])}</option>"
    return "<select name=\"{escape(naam)}\">{items}</select>"
wow

such bestand much naam, label, accept = "", verplicht = false:
    such acc = ""
    if accept != "":
        very acc = " accept=\"{escape(accept)}\""
    such req = " required" if verplicht else ""
    return "<label>{escape(label)}<input type=\"file\" name=\"{escape(naam)}\"{acc}{req}></label>"
wow

such formulier much actie, methode, velden, enctype = "":
    such inhoud = strings.join(velden, "\n")
    such enc = ""
    if enctype != "":
        very enc = " enctype=\"{escape(enctype)}\""
    return "<form action=\"{escape(actie)}\" method=\"{escape(methode)}\"{enc}>\n{inhoud}\n</form>"
wow

such tabel much koppen, rijen, rechts = [], voet = []:
    such kop = ""
    such ci = 0
    for k in koppen:
        such kl = " class=\"num\"" if ci in rechts else ""
        very kop = kop + "<th{kl}>{escape(k)}</th>"
        very ci = ci + 1
    such body = ""
    for rij in rijen:
        such cellen = ""
        such cj = 0
        for cel in rij:
            such cl = " class=\"num\"" if cj in rechts else ""
            very cellen = cellen + "<td{cl}>{escape(cel)}</td>"
            very cj = cj + 1
        very body = body + "<tr>{cellen}</tr>"
    such tfoot = ""
    if len(voet) > 0:
        such vcellen = ""
        such vk = 0
        for cel in voet:
            such vl = " class=\"num\"" if vk in rechts else ""
            very vcellen = vcellen + "<td{vl}>{escape(cel)}</td>"
            very vk = vk + 1
        very tfoot = "\n<tfoot><tr>{vcellen}</tr></tfoot>"
    return "<table>\n<thead><tr>{kop}</tr></thead>\n<tbody>{body}</tbody>{tfoot}\n</table>"
wow

such tabel_regio much label, tabel:
    return "<div class=\"tabel-regio\" tabindex=\"0\" role=\"region\" aria-label=\"{escape(label)}\">{tabel}</div>"
wow

such link much href, tekst, klasse = "":
    such k = ""
    if klasse != "":
        very k = " class=\"{escape(klasse)}\""
    return "<a href=\"{escape(href)}\"{k}>{escape(tekst)}</a>"
wow

such knop much tekst, type = "submit":
    return "<button type=\"{escape(type)}\">{escape(tekst)}</button>"
wow

# pct en klasse gaan rauw erin, dus alleen server-berekende waarden. Een SVG-rect
# i.p.v. style="width" omdat de CSP inline styles blokkeert.
such staafgrafiek much titel, rijen:
    such body = ""
    for rij in rijen:
        such label = escape(rij[0])
        such pct = rij[1]
        such waarde = escape(rij[2])
        such kl = rij[3]
        such balk = "<svg class=\"balk-svg\" aria-hidden=\"true\"><rect class=\"balk {kl}\" width=\"{pct}%\" height=\"100%\" rx=\"3\"></rect></svg>"
        very body = body + "<div class=\"balk-rij\"><span class=\"balk-label\">{label}</span><span class=\"balk-baan\">{balk}</span><span class=\"balk-waarde\">{waarde}</span></div>"
    return "<figure class=\"grafiek\"><figcaption>{escape(titel)}</figcaption>{body}</figure>"
wow
wow
