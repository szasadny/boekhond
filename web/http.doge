so howl
so strings
so forms
so pack
so nap

# Content-Length telt bytes, geen characters: de body wordt daarom byte-accuraat gelezen.

so STATUS = {"200": "200 OK", "302": "302 Found", "303": "303 See Other", "400": "400 Bad Request", "401": "401 Unauthorized", "403": "403 Forbidden", "404": "404 Not Found", "405": "405 Method Not Allowed", "411": "411 Length Required", "413": "413 Payload Too Large", "431": "431 Request Header Fields Too Large", "500": "500 Internal Server Error"}
so MAX_BODY = 12582912
so MAX_KOPPEN = 16384
so HTML = "text/html; charset=utf-8"
so PLAIN = "text/plain; charset=utf-8"
so CSV = "text/csv; charset=utf-8"
so CRLF = "\r\n"
so CSP = "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'"
so VEILIGHEIDSKOPPEN = [["Content-Security-Policy", CSP], ["X-Frame-Options", "DENY"], ["X-Content-Type-Options", "nosniff"], ["Referrer-Policy", "same-origin"]]

such is_tekst much headers:
    if not headers.has("content-type"):
        return true
    such ct = strings.smoll(headers["content-type"][0])
    if strings.contains(ct, "multipart"):
        return false
    if strings.contains(ct, "octet-stream"):
        return false
    if strings.contains(ct, "application/pdf"):
        return false
    if strings.contains(ct, "image/"):
        return false
    return true
wow

such parse_cookies much headers:
    such cookies = {}
    if not headers.has("cookie"):
        return cookies
    for stuk in strings.split(headers["cookie"][0], ";"):
        such s = strings.trim(stuk)
        if s == "":
            continue
        such kv = strings.split(s, "=")
        if len(kv) < 2:
            continue
        cookies[strings.trim(kv[0])] = strings.trim(strings.join(kv[1:], "="))
    return cookies
wow

such afgewezen much status, tekst:
    return {"afgewezen": tekst_response(status, tekst)}
wow

# recv_line meldt zowel een overschreden max als ongeldige UTF-8 als IOError.
such regel_te_lang much err:
    return strings.contains(err.message, "line exceeded")
wow

# caps = {pad: max-bytes} voor routes die een grotere body mogen dan MAX_BODY.
such parse_request much conn, caps = {}:
    such regel = none
    pls
        very regel = howl.recv_line(conn, MAX_KOPPEN)
    oh no err!
        if regel_te_lang(err):
            return afgewezen(431, "request-line te groot")
        return afgewezen(400, "ongeldige request-line")
    if regel == none or regel == "":
        return none
    such delen = strings.split(regel, " ")
    if len(delen) < 2:
        return none
    such method = delen[0]
    such target = delen[1]
    such path = target
    such query = {}
    such qdeel = strings.split(target, "?")
    if len(qdeel) > 1:
        very path = qdeel[0]
        very query = forms.decode(strings.join(qdeel[1:], "?"))
    such headers = {}
    such kopbytes = 0
    while true:
        such h = none
        pls
            very h = howl.recv_line(conn, MAX_KOPPEN - kopbytes + 1)
        oh no err!
            if regel_te_lang(err):
                return afgewezen(431, "headers te groot")
            return afgewezen(400, "ongeldige header")
        if h == none or h == "":
            bork
        very kopbytes = kopbytes + len(bytes(h)) + 2
        if kopbytes > MAX_KOPPEN:
            return afgewezen(431, "headers te groot")
        such dp = strings.split(h, ":")
        if len(dp) < 2:
            continue
        such naam = strings.smoll(strings.trim(dp[0]))
        such waarde = strings.trim(strings.join(dp[1:], ":"))
        if headers.has(naam):
            headers[naam].append(waarde)
        else:
            headers[naam] = [waarde]
    if headers.has("transfer-encoding"):
        return afgewezen(411, "Content-Length vereist")
    such cookies = parse_cookies(headers)
    such body = ""
    if headers.has("content-length"):
        such n = 0
        pls
            very n = int(headers["content-length"][0])
        oh no err!
            very n = 0
        such cap = MAX_BODY
        if caps.has(path):
            very cap = caps[path]
        if n > cap:
            return afgewezen(413, "verzoek te groot")
        such buf = bytes("")
        while len(buf) < n:
            such chunk = howl.recv_bytes(conn, n - len(buf))
            if chunk == none:
                bork
            very buf = buf + chunk
        if is_tekst(headers):
            pls
                very body = buf.decode()
            oh no err!
                return afgewezen(400, "ongeldige tekencodering")
        else:
            very body = buf
    return {"method": method, "path": path, "query": query, "headers": headers, "body": body, "cookies": cookies, "params": {}}
wow

# CR/LF strippen voorkomt header injection (response splitting).
such kop_veilig much v:
    return strings.replace(strings.replace(str(v), "\r", ""), "\n", "")
wow

such bouw_response much resp, zonder_body = false:
    such status = str(resp["status"])
    such statustekst = STATUS["500"]
    if STATUS.has(status):
        very statustekst = STATUS[status]
    such body_bytes = bytes(resp["body"])
    such kop = "HTTP/1.1 {statustekst}{CRLF}"
    such headers = resp["headers"]
    such heeft_ct = false
    for naam in headers:
        very kop = kop + "{naam}: {kop_veilig(headers[naam])}{CRLF}"
        if strings.smoll(naam) == "content-type":
            very heeft_ct = true
    if not heeft_ct:
        very kop = kop + "Content-Type: {HTML}{CRLF}"
    for k in VEILIGHEIDSKOPPEN:
        very kop = kop + "{k[0]}: {k[1]}{CRLF}"
    if resp.has("set_cookie"):
        for c in resp["set_cookie"]:
            very kop = kop + "Set-Cookie: {kop_veilig(c)}{CRLF}"
    very kop = kop + "Content-Length: {len(body_bytes)}{CRLF}"
    very kop = kop + "Connection: close{CRLF}"
    if zonder_body:
        return bytes(kop + CRLF)
    return bytes(kop + CRLF) + body_bytes
wow

such html_response much body, status = 200:
    return {"status": status, "headers": {"Content-Type": HTML}, "body": body}
wow

such tekst_response much status, body:
    return {"status": status, "headers": {"Content-Type": PLAIN}, "body": body}
wow

such redirect much locatie:
    return {"status": 303, "headers": {"Location": locatie}, "body": ""}
wow

# bestandsnaam is een vaste naam, nooit user-input.
such csv_response much bestandsnaam, body:
    such disp = "attachment; filename=\"{bestandsnaam}\""
    return {"status": 200, "headers": {"Content-Type": CSV, "Content-Disposition": disp}, "body": body}
wow

such is_loopback much host:
    return host in ["127.0.0.1", "::1", "localhost"]
wow

# none bij een onbekend adres (fail-safe).
such peer_host much conn:
    pls
        such info = howl.peer(conn)
        return info["host"]
    oh no err!
        return none
wow

# stopgap for doge#78: howl heeft geen read-timeout, dus elke verbinding een eigen pup
# zodat een idle of trage client alleen zichzelf blokkeert.
such serveer much listener, verzoeken, caps = {}:
    while true:
        pls
            such conn = howl.accept(listener)
            pack.zoom(verbinding, [conn, verzoeken, caps])
        oh no err!
            bark "accept-fout: " + err.message
            nap.rest(1)
wow

# Alleen socket-I/O: verwerking gebeurt single-threaded door wie verzoeken leest.
such verbinding much conn, verzoeken, caps:
    pls
        such req = parse_request(conn, caps)
        if req != none:
            req["peer_host"] = peer_host(conn)
            such antwoord = pack.bowl()
            pack.drop(verzoeken, [req, antwoord])
            howl.send_bytes(conn, pack.sniff(antwoord))
    oh no err!
        bark "verbindingsfout: " + err.message
        pls
            howl.send_bytes(conn, bouw_response(tekst_response(500, "interne fout")))
        oh no err2!
            bark "kon 500 niet sturen: " + err2.message
    howl.close(conn)
wow
wow
